+/// Lower *_EXTEND_VECTOR_INREG. LASX has vext2xv.* that take the low N bytes
+/// of a 256-bit register and widen them in one instruction — this is the
+/// mc_weight / TAPFILTER `zext <8 x i8> to <8 x i32>` path. Without it, the
+/// default Expand turns those widens into vpickve2gr + xvextrins soup.
+/// 128-bit LSX uses vilvl with zeros (little-endian unpack).
+SDValue LoongArchTargetLowering::lowerExtendVectorInReg(SDValue Op,
+                                                        SelectionDAG &DAG) const {
+  const SDLoc DL(Op);
+  MVT VT = Op.getSimpleValueType();
+  SDValue Src = Op.getOperand(0);
+  if (!Src.getValueType().isSimple())
+    return SDValue();
+  MVT SrcVT = Src.getSimpleValueType();
+  if (!VT.isInteger() || !SrcVT.isInteger() || !VT.isVector() ||
+      !SrcVT.isVector())
+    return SDValue();
+  if (VT.getSizeInBits() != SrcVT.getSizeInBits())
+    return SDValue();
+
+  const bool IsSigned = Op.getOpcode() == ISD::SIGN_EXTEND_VECTOR_INREG;
+  const unsigned SrcElt = SrcVT.getScalarSizeInBits();
+  const unsigned DstElt = VT.getScalarSizeInBits();
+  if (SrcElt >= DstElt || (DstElt % SrcElt) != 0)
+    return SDValue();
+
+  auto emitLasxVext2xv = [&](unsigned Opc) -> SDValue {
+    return SDValue(DAG.getMachineNode(Opc, DL, VT, Src), 0);
+  };
+
+  if (Subtarget.hasExtLASX() && VT.is256BitVector() && SrcVT.is256BitVector() &&
+      isTypeLegal(VT) && isTypeLegal(SrcVT)) {
+    if (!IsSigned) {
+      if (SrcVT == MVT::v32i8 && VT == MVT::v16i16)
+        return emitLasxVext2xv(LoongArch::VEXT2XV_HU_BU);
+      if (SrcVT == MVT::v32i8 && VT == MVT::v8i32)
+        return emitLasxVext2xv(LoongArch::VEXT2XV_WU_BU);
+      if (SrcVT == MVT::v32i8 && VT == MVT::v4i64)
+        return emitLasxVext2xv(LoongArch::VEXT2XV_DU_BU);
+      if (SrcVT == MVT::v16i16 && VT == MVT::v8i32)
+        return emitLasxVext2xv(LoongArch::VEXT2XV_WU_HU);
+      if (SrcVT == MVT::v16i16 && VT == MVT::v4i64)
+        return emitLasxVext2xv(LoongArch::VEXT2XV_DU_HU);
+      if (SrcVT == MVT::v8i32 && VT == MVT::v4i64)
+        return emitLasxVext2xv(LoongArch::VEXT2XV_DU_WU);
+    } else {
+      if (SrcVT == MVT::v32i8 && VT == MVT::v16i16)
+        return emitLasxVext2xv(LoongArch::VEXT2XV_H_B);
+      if (SrcVT == MVT::v32i8 && VT == MVT::v8i32)
+        return emitLasxVext2xv(LoongArch::VEXT2XV_W_B);
+      if (SrcVT == MVT::v32i8 && VT == MVT::v4i64)
+        return emitLasxVext2xv(LoongArch::VEXT2XV_D_B);
+      if (SrcVT == MVT::v16i16 && VT == MVT::v8i32)
+        return emitLasxVext2xv(LoongArch::VEXT2XV_W_H);
+      if (SrcVT == MVT::v16i16 && VT == MVT::v4i64)
+        return emitLasxVext2xv(LoongArch::VEXT2XV_D_H);
+      if (SrcVT == MVT::v8i32 && VT == MVT::v4i64)
+        return emitLasxVext2xv(LoongArch::VEXT2XV_D_W);
+    }
+  }
+
+  // 128-bit (or 256-bit fallback): repeated vilvl unpack. Per-128-bit-lane
+  // vilvl is only correct when the useful source bytes sit in each lane's
+  // low half; that holds for 128-bit registers.
+  if (!VT.is128BitVector() || !SrcVT.is128BitVector())
+    return SDValue();
+
+  SDValue Val = Src;
+  while (Val.getValueType().getScalarSizeInBits() < DstElt) {
+    EVT CurVT = Val.getValueType();
+    const unsigned CurElt = CurVT.getScalarSizeInBits();
+    SDValue HiLane;
+    if (IsSigned) {
+      SDValue ShAmt = DAG.getConstant(CurElt - 1, DL, CurVT);
+      HiLane = DAG.getNode(ISD::SRA, DL, CurVT, Val, ShAmt);
+    } else {
+      HiLane = DAG.getConstant(0, DL, CurVT);
+    }
+    // vilvl vd, vj, vk : vd = [vk0, vj0, vk1, vj1, ...] (little-endian widen)
+    Val = DAG.getNode(LoongArchISD::VILVL, DL, CurVT, HiLane, Val);
+    const unsigned NextElt = CurElt * 2;
+    const unsigned NextNum = CurVT.getSizeInBits() / NextElt;
+    MVT NextVT = MVT::getVectorVT(MVT::getIntegerVT(NextElt), NextNum);
+    Val = DAG.getBitcast(NextVT, Val);
+  }
+  if (Val.getValueType() != VT)
+    Val = DAG.getBitcast(VT, Val);
+  return Val;
+}
+
+/// Integer vector truncate via bitcast + every-Nth shuffle, which LSX/LASX
+/// select as vpickev / vilvl / xvperm chains instead of extract-element soup.
+///
+/// Under -mlasx, illegal results such as v8i8 are widened to 256-bit v32i8, so
+/// the historical 128-bit-only path never fired for mc_weight / TAPFILTER
+/// pack-trunc. 256-bit xvpickev is per-128-bit-lane: pack each half in 128-bit
+/// then compact the two useful prefixes with a coarse shuffle (xvpermi.d or
+/// xvperm.w).
+static SDValue packIntegerTruncate128(SDValue In, MVT OutVT, const SDLoc &DL,
+                                      SelectionDAG &DAG) {
+  EVT InVT = In.getValueType();
+  if (!InVT.is128BitVector() || !OutVT.is128BitVector() || !InVT.isInteger() ||
+      !OutVT.isInteger())
+    return SDValue();
+
+  const unsigned SrcElt = InVT.getScalarSizeInBits();
+  const unsigned DstElt = OutVT.getScalarSizeInBits();
+  if (SrcElt <= DstElt || (SrcElt % DstElt) != 0)
+    return SDValue();
+
+  const int Scale = static_cast<int>(SrcElt / DstElt);
+  const unsigned MinElts = InVT.getVectorNumElements();
+  const unsigned OutElts = OutVT.getVectorNumElements();
+  if (MinElts > OutElts)
+    return SDValue();
+
+  SmallVector<int, 16> TruncMask(OutElts, -1);
+  for (unsigned I = 0; I < MinElts; ++I)
+    TruncMask[I] = Scale * static_cast<int>(I);
+
+  SDValue BC = DAG.getBitcast(OutVT, In);
+  return DAG.getVectorShuffle(OutVT, DL, BC, BC, TruncMask);
+}
+
+static SDValue lowerVectorTruncateToPackShuffle(SDValue In, MVT WidenVT,
+                                                const SDLoc &DL,
+                                                SelectionDAG &DAG,
+                                                const LoongArchSubtarget &ST) {
+  if (!ST.hasExtLSX() || !WidenVT.isVector() || !WidenVT.isInteger())
+    return SDValue();
+  EVT InVT = In.getValueType();
+  if (!InVT.isVector() || !InVT.isInteger() || !InVT.isSimple())
+    return SDValue();
+
+  const unsigned DstElt = WidenVT.getScalarSizeInBits();
+  const unsigned SrcElt = InVT.getScalarSizeInBits();
+  if (SrcElt <= DstElt || (SrcElt % DstElt) != 0)
+    return SDValue();
+  if (DstElt != 8 && DstElt != 16 && DstElt != 32)
+    return SDValue();
+
+  const unsigned OutBits = WidenVT.getSizeInBits();
+  const unsigned InBits = InVT.getSizeInBits();
+  if (OutBits != 128 && OutBits != 256)
+    return SDValue();
+  if (OutBits == 256 && !ST.hasExtLASX())
+    return SDValue();
+
+  MVT SrcEltVT = InVT.getSimpleVT().getScalarType();
+  unsigned SrcElts128 = 128 / SrcElt;
+  MVT Src128VT = MVT::getVectorVT(SrcEltVT, SrcElts128);
+  MVT Out128VT = MVT::getVectorVT(WidenVT.getScalarType(), 128 / DstElt);
+
+  auto mergeTwoPacked128 = [&](SDValue PLo, SDValue PHi) -> SDValue {
+    const unsigned HalfUseful = InVT.getVectorNumElements() / 2;
+    const unsigned UsefulBits = HalfUseful * DstElt;
+    if (UsefulBits == 128)
+      return DAG.getNode(ISD::CONCAT_VECTORS, DL, WidenVT, PLo, PHi);
+    if (UsefulBits == 64) {
+      SDValue Lo64 = DAG.getBitcast(MVT::v2i64, PLo);
+      SDValue Hi64 = DAG.getBitcast(MVT::v2i64, PHi);
+      SDValue Merged = DAG.getNode(LoongArchISD::VILVL, DL, MVT::v2i64, Hi64, Lo64);
+      if (OutBits == 256) {
+        Merged = DAG.getNode(ISD::INSERT_SUBVECTOR, DL, MVT::v4i64,
+                             DAG.getUNDEF(MVT::v4i64), Merged,
+                             DAG.getVectorIdxConstant(0, DL));
+        return DAG.getBitcast(WidenVT, Merged);
+      }
+      return DAG.getBitcast(WidenVT, Merged);
+    }
+    if (UsefulBits == 32) {
+      SDValue LoW = DAG.getBitcast(MVT::v4i32, PLo);
+      SDValue HiW = DAG.getBitcast(MVT::v4i32, PHi);
+      SDValue Merged = DAG.getNode(LoongArchISD::VILVL, DL, MVT::v4i32, HiW, LoW);
+      if (OutBits == 256) {
+        Merged = DAG.getNode(ISD::INSERT_SUBVECTOR, DL, MVT::v8i32,
+                             DAG.getUNDEF(MVT::v8i32), Merged,
+                             DAG.getVectorIdxConstant(0, DL));
+        return DAG.getBitcast(WidenVT, Merged);
+      }
+      return DAG.getBitcast(WidenVT, Merged);
+    }
+    return SDValue();
+  };
+
+  // Result already a full 128-bit register.
+  if (OutBits == 128) {
+    if (InBits <= 128) {
+      SDValue Src128 = In;
+      if (InBits < 128) {
+        Src128 = DAG.getNode(ISD::INSERT_SUBVECTOR, DL, Src128VT,
+                             DAG.getUNDEF(Src128VT), In,
+                             DAG.getVectorIdxConstant(0, DL));
+      }
+      return packIntegerTruncate128(Src128, WidenVT, DL, DAG);
+    }
+    if (InBits == 512 && ST.hasExtLASX()) {
+      unsigned SrcElts256 = 256 / SrcElt;
+      MVT Src256VT = MVT::getVectorVT(SrcEltVT, SrcElts256);
+      SDValue Lo = DAG.getNode(ISD::EXTRACT_SUBVECTOR, DL, Src256VT, In,
+                               DAG.getVectorIdxConstant(0, DL));
+      SDValue Hi = DAG.getNode(ISD::EXTRACT_SUBVECTOR, DL, Src256VT, In,
+                               DAG.getVectorIdxConstant(SrcElts256, DL));
+      SDValue PLo =
+          lowerVectorTruncateToPackShuffle(Lo, WidenVT, DL, DAG, ST);
+      SDValue PHi =
+          lowerVectorTruncateToPackShuffle(Hi, WidenVT, DL, DAG, ST);
+      if (!PLo || !PHi)
+        return SDValue();
+      SDValue Lo64 = DAG.getBitcast(MVT::v2i64, PLo);
+      SDValue Hi64 = DAG.getBitcast(MVT::v2i64, PHi);
+      SDValue Merged =
+          DAG.getNode(LoongArchISD::VILVL, DL, MVT::v2i64, Hi64, Lo64);
+      return DAG.getBitcast(WidenVT, Merged);
+    }
+    if (InBits != 256)
+      return SDValue();
+    SDValue Lo = DAG.getNode(ISD::EXTRACT_SUBVECTOR, DL, Src128VT, In,
+                             DAG.getVectorIdxConstant(0, DL));
+    SDValue Hi = DAG.getNode(ISD::EXTRACT_SUBVECTOR, DL, Src128VT, In,
+                             DAG.getVectorIdxConstant(SrcElts128, DL));
+    SDValue PLo = packIntegerTruncate128(Lo, WidenVT, DL, DAG);
+    SDValue PHi = packIntegerTruncate128(Hi, WidenVT, DL, DAG);
+    if (!PLo || !PHi)
+      return SDValue();
+    return mergeTwoPacked128(PLo, PHi);
+  }
+
+  // 256-bit widened dest (v8i8 / v16i8 / v8i16 under -mlasx).
+  if (InBits <= 128) {
+    SDValue Src128 = In;
+    if (InBits < 128) {
+      Src128 = DAG.getNode(ISD::INSERT_SUBVECTOR, DL, Src128VT,
+                           DAG.getUNDEF(Src128VT), In,
+                           DAG.getVectorIdxConstant(0, DL));
+    }
+    SDValue Packed = packIntegerTruncate128(Src128, Out128VT, DL, DAG);
+    if (!Packed)
+      return SDValue();
+    return DAG.getNode(ISD::INSERT_SUBVECTOR, DL, WidenVT, DAG.getUNDEF(WidenVT),
+                       Packed, DAG.getVectorIdxConstant(0, DL));
+  }
+  if (InBits == 512 && ST.hasExtLASX()) {
+    unsigned SrcElts256 = 256 / SrcElt;
+    MVT Src256VT = MVT::getVectorVT(SrcEltVT, SrcElts256);
+    SDValue Lo = DAG.getNode(ISD::EXTRACT_SUBVECTOR, DL, Src256VT, In,
+                             DAG.getVectorIdxConstant(0, DL));
+    SDValue Hi = DAG.getNode(ISD::EXTRACT_SUBVECTOR, DL, Src256VT, In,
+                             DAG.getVectorIdxConstant(SrcElts256, DL));
+    SDValue PLo =
+        lowerVectorTruncateToPackShuffle(Lo, Out128VT, DL, DAG, ST);
+    SDValue PHi =
+        lowerVectorTruncateToPackShuffle(Hi, Out128VT, DL, DAG, ST);
+    if (!PLo || !PHi)
+      return SDValue();
+    return DAG.getNode(ISD::CONCAT_VECTORS, DL, WidenVT, PLo, PHi);
+  }
+  if (InBits != 256)
+    return SDValue();
+
+  SDValue Lo = DAG.getNode(ISD::EXTRACT_SUBVECTOR, DL, Src128VT, In,
+                           DAG.getVectorIdxConstant(0, DL));
+  SDValue Hi = DAG.getNode(ISD::EXTRACT_SUBVECTOR, DL, Src128VT, In,
+                           DAG.getVectorIdxConstant(SrcElts128, DL));
+  SDValue PLo = packIntegerTruncate128(Lo, Out128VT, DL, DAG);
+  SDValue PHi = packIntegerTruncate128(Hi, Out128VT, DL, DAG);
+  if (!PLo || !PHi)
+    return SDValue();
+  return mergeTwoPacked128(PLo, PHi);
+}
