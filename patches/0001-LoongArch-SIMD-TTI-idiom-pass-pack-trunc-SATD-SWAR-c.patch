+static unsigned getIntegerVectorCostScale(unsigned EltBits) {
+  // x264 SAD/mc hot paths vectorize i8/i16 byte kernels via SLP; TSVC ROI
+  // is mostly f32/i32. Scale cost up sharply for sub-word integer vectors.
+  if (EltBits <= 8)
