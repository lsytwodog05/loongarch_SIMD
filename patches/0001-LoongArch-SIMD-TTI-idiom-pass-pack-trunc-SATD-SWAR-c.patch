+  case ISD::ZERO_EXTEND_VECTOR_INREG:
+  case ISD::SIGN_EXTEND_VECTOR_INREG:
+  case ISD::ANY_EXTEND_VECTOR_INREG:
+    return lowerExtendVectorInReg(Op, DAG);
+  case ISD::ZERO_EXTEND:
+  case ISD::SIGN_EXTEND:
+  case ISD::ANY_EXTEND:
+    if (Op.getValueType().isVector())
+      return lowerExtendVectorInReg(
+          DAG.getNode(Op.getOpcode() == ISD::SIGN_EXTEND
+                          ? ISD::SIGN_EXTEND_VECTOR_INREG
+                          : ISD::ZERO_EXTEND_VECTOR_INREG,
+                      SDLoc(Op), Op.getValueType(),
+                      [&]() {
+                        SDValue Src = Op.getOperand(0);
+                        MVT VT = Op.getSimpleValueType();
+                        if (!Src.getValueType().isSimple())
+                          return Src;
+                        MVT SrcVT = Src.getSimpleValueType();
+                        if (!SrcVT.isVector() || !SrcVT.isInteger() ||
+                            SrcVT.getSizeInBits() >= VT.getSizeInBits())
+                          return Src;
+                        const unsigned SrcElt = SrcVT.getScalarSizeInBits();
+                        if (SrcElt == 0 || (VT.getSizeInBits() % SrcElt) != 0)
+                          return Src;
+                        MVT WideSrcVT = MVT::getVectorVT(
+                            SrcVT.getScalarType(), VT.getSizeInBits() / SrcElt);
+                        return DAG.getNode(ISD::INSERT_SUBVECTOR, SDLoc(Op),
+                                           WideSrcVT, DAG.getUNDEF(WideSrcVT),
+                                           Src,
+                                           DAG.getVectorIdxConstant(0, SDLoc(Op)));
+                      }()),
+          DAG);
+    break;
+  case ISD::TRUNCATE:
+    if (Op.getValueType().isVector() && Op.getValueType().isSimple())
+      return lowerVectorTruncateToPackShuffle(Op.getOperand(0),
+                                              Op.getSimpleValueType(),
+                                              SDLoc(Op), DAG, Subtarget);
+    break;
   }
   return SDValue();
 }
