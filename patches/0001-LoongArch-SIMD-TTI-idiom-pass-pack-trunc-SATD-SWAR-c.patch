+
+static bool isEvenOddPackMask(ArrayRef<int> Mask) {
+  if (Mask.size() < 4 || (Mask.size() & (Mask.size() - 1)) != 0)
+    return false;
+  bool AllEven = true;
+  bool AllOdd = true;
+  for (unsigned I = 0; I < Mask.size(); ++I) {
+    if (Mask[I] != static_cast<int>(2 * I))
+      AllEven = false;
+    if (Mask[I] != static_cast<int>(2 * I + 1))
+      AllOdd = false;
+  }
+  return AllEven || AllOdd;
+}
+
+static bool isSimpleInterleaveMask(ArrayRef<int> Mask) {
+  if (Mask.empty())
+    return false;
+  if ((Mask.size() & 1) != 0)
+    return false;
+  for (unsigned I = 0; I < Mask.size(); ++I) {
+    int M = Mask[I];
+    if (M < 0)
+      return false;
+    if ((I & 1) == 0) {
+      if (M != static_cast<int>(I / 2))
+        return false;
+    } else {
+      if (M != static_cast<int>(Mask.size() + I / 2))
+        return false;
+    }
+  }
+  return true;
+}
