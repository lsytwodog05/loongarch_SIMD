+static unsigned getNumVecInstsForType(Type *Ty, TypeSize RegBits) {
+  auto *VTy = cast<FixedVectorType>(Ty);
+  const uint64_t NumVecInsts64 =
+      std::max<uint64_t>(1, divideCeil(
+                                VTy->getPrimitiveSizeInBits().getKnownMinValue(),
