+bool LoongArchTargetLowering::enableAggressiveFMAFusion(EVT VT) const {
+  if (!VT.isSimple())
+    return false;
+  MVT SVT = VT.getSimpleVT();
+  if (SVT == MVT::f32 || SVT == MVT::f64)
+    return true;
+  if (Subtarget.hasExtLSX() && (SVT == MVT::v4f32 || SVT == MVT::v2f64))
+    return true;
+  if (Subtarget.hasExtLASX() && (SVT == MVT::v8f32 || SVT == MVT::v4f64))
+    return true;
+  return false;
+}
+
+bool LoongArchTargetLowering::enableAggressiveFMAFusion(LLT Ty) const {
+  const unsigned Bits = Ty.getSizeInBits();
+  if (!Ty.isVector())
+    return Bits == 32 || Bits == 64;
+  if (Subtarget.hasExtLSX() && Bits == 128)
+    return true;
+  if (Subtarget.hasExtLASX() && Bits == 256)
+    return true;
+  return false;
+}
