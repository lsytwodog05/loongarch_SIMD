+InstructionCost LoongArchTTIImpl::getVectorInstrCost(
+    unsigned Opcode, Type *Val, TTI::TargetCostKind CostKind, unsigned Index,
+    const Value *Op0, const Value *Op1) const {
+  if (!ST->hasExtLSX())
+    return BaseT::getVectorInstrCost(Opcode, Val, CostKind, Index, Op0, Op1);
+
+  auto *VTy = dyn_cast<FixedVectorType>(Val);
+  if (!VTy)
+    return BaseT::getVectorInstrCost(Opcode, Val, CostKind, Index, Op0, Op1);
+
+  Type *EltTy = VTy->getElementType();
+  const unsigned Bits = EltTy->getScalarSizeInBits();
+  // Lane 0 extract/insert is a free subregister copy on LSX/LASX.
+  if (Index == 0 &&
+      (Opcode == Instruction::ExtractElement ||
+       Opcode == Instruction::InsertElement))
+    return 0;
+
+  // vinsgr2vr / vpickve2gr / vreplvei for i16/i32/FP. Keep i8 expensive so
+  // SLP does not rebuild SAD from scalar inserts (pixel.c pickve soup).
+  if (Opcode == Instruction::ExtractElement ||
+      Opcode == Instruction::InsertElement) {
+    if (EltTy->isFloatingPointTy() || Bits >= 16)
+      return 1;
+    return getIntegerVectorCostScale(Bits);
+  }
+
+  return BaseT::getVectorInstrCost(Opcode, Val, CostKind, Index, Op0, Op1);
+}
+
+InstructionCost LoongArchTTIImpl::getArithmeticInstrCost(
+    unsigned Opcode, Type *Ty, TTI::TargetCostKind CostKind,
+    TTI::OperandValueInfo Op1Info, TTI::OperandValueInfo Op2Info,
+    ArrayRef<const Value *> Args, const Instruction *CxtI) const {
+  auto *VTy = dyn_cast<FixedVectorType>(Ty);
+  if (!VTy || !ST->hasExtLSX())
+    return BaseT::getArithmeticInstrCost(Opcode, Ty, CostKind, Op1Info, Op2Info,
+                                         Args, CxtI);
+
+  Type *EltTy = VTy->getElementType();
+  if (!EltTy->isIntegerTy() && !EltTy->isFloatingPointTy())
+    return BaseT::getArithmeticInstrCost(Opcode, Ty, CostKind, Op1Info, Op2Info,
+                                         Args, CxtI);
+
+  const TypeSize RegBits = getRegisterBitWidth(TTI::RGK_FixedWidthVector);
+  if (VTy->getPrimitiveSizeInBits() > RegBits) {
+    const unsigned NumVecInsts =
+        (VTy->getPrimitiveSizeInBits().getKnownMinValue() +
+         RegBits.getKnownMinValue() - 1) /
+        RegBits.getKnownMinValue();
+    // Wide i16/i32 (v16i32 SAD/avg after zext) splits into legal LASX chunks.
+    // Keep native i8 wide ops scaled so SLP does not form v32i8 SAD.
+    if (EltTy->isIntegerTy()) {
+      unsigned Bits = EltTy->getScalarSizeInBits();
+      if (Bits >= 16)
+        return 4 * NumVecInsts;
+      return getIntegerVectorCostScale(Bits) * NumVecInsts;
+    }
+    return NumVecInsts;
+  }
+
+  // FP vector ops get ultra-cheap throughput cost (TSVC ROI); integer ops
+  // stay conservative to avoid x264 pixel-kernel regressions.
+  switch (Opcode) {
+  case Instruction::FAdd:
+  case Instruction::FSub:
+  case Instruction::FMul:
+    if (EltTy->isFloatingPointTy())
+      return 1;
+    break;
+  case Instruction::Sub:
+    if (EltTy->isIntegerTy()) {
+      unsigned Bits = EltTy->getScalarSizeInBits();
+      // i8 sub stays expensive so SLP does not form native i8 SAD.
+      // i16/i32 sub is legal (vsub.h / vsub.w). With vext2xv widen+pack
+      // in ISel, i32 zext-i8 SAD/SATD/Hadamard no longer becomes extract soup.
+      if (Bits >= 16)
+        return 4;
+      return getIntegerVectorCostScale(Bits);
+    }
+    break;
+  case Instruction::Add:
+  case Instruction::Mul:
+  case Instruction::And:
+  case Instruction::Or:
+  case Instruction::Xor:
+    if (EltTy->isIntegerTy()) {
+      unsigned Bits = EltTy->getScalarSizeInBits();
+      if (Bits >= 16)
+        return 4; // vadd.h / madd.w; i8 SAD stays scaled
+      // Do not cheapen i8 add for (a+b+1)>>1: C promotes uint8 to i32, and
+      // wrapping i8 add is not equivalent. pixel_avg must zext to i16/i32.
+      return getIntegerVectorCostScale(Bits);
+    }
+    break;
+  case Instruction::AShr:
+  case Instruction::LShr:
+  case Instruction::Shl:
+    // vslli/vsrai/vsrli.{h,w,d}: mc_weight denom shift and TAPFILTER >>5.
+    // Keep i8 shifts expensive so SAD/SATD byte kernels stay scalar.
+    if (EltTy->isIntegerTy() && EltTy->getScalarSizeInBits() >= 16)
+      return 4;
+    break;
+  default:
+    break;
+  }
+
+  return BaseT::getArithmeticInstrCost(Opcode, Ty, CostKind, Op1Info, Op2Info,
+                                       Args, CxtI);
+}
+
+InstructionCost LoongArchTTIImpl::getCmpSelInstrCost(
+    unsigned Opcode, Type *ValTy, Type *CondTy, CmpInst::Predicate VecPred,
+    TTI::TargetCostKind CostKind, TTI::OperandValueInfo Op1Info,
+    TTI::OperandValueInfo Op2Info, const Instruction *I) const {
+  auto *VTy = dyn_cast<FixedVectorType>(ValTy);
+  if (!VTy || !ST->hasExtLSX())
+    return BaseT::getCmpSelInstrCost(Opcode, ValTy, CondTy, VecPred, CostKind,
+                                     Op1Info, Op2Info, I);
+
+  Type *EltTy = VTy->getElementType();
+  if (EltTy->isIntegerTy()) {
+    const unsigned Bits = EltTy->getScalarSizeInBits();
+    const unsigned NumVecInsts = getNumVecInstsForType(
+        VTy, getRegisterBitWidth(TTI::RGK_FixedWidthVector));
+    // vslt + vbitsel / vmin / vmax. Keep i8 compares expensive (SAD).
+    if (Bits >= 16)
+      return NumVecInsts;
+    return getIntegerVectorCostScale(Bits) * NumVecInsts;
+  }
+
+  return BaseT::getCmpSelInstrCost(Opcode, ValTy, CondTy, VecPred, CostKind,
+                                   Op1Info, Op2Info, I);
+}
+
+InstructionCost LoongArchTTIImpl::getMemoryOpCost(
+    unsigned Opcode, Type *Src, Align Alignment, unsigned AddressSpace,
+    TTI::TargetCostKind CostKind, TTI::OperandValueInfo OpInfo,
+    const Instruction *I) const {
+  auto *VTy = dyn_cast<FixedVectorType>(Src);
+  if (!VTy || !ST->hasExtLSX())
+    return BaseT::getMemoryOpCost(Opcode, Src, Alignment, AddressSpace, CostKind,
+                                  OpInfo, I);
+
+  Type *EltTy = VTy->getElementType();
+  const TypeSize RegBits = getRegisterBitWidth(TTI::RGK_FixedWidthVector);
+  const unsigned NumVecInsts = getNumVecInstsForType(Src, RegBits);
+
+    if (Opcode == Instruction::Load || Opcode == Instruction::Store) {
+    const uint64_t StoreSize =
+        getDataLayout().getTypeStoreSize(Src).getKnownMinValue();
+    InstructionCost Cost = NumVecInsts;
+    if (StoreSize > 0 && Alignment < Align(StoreSize)) {
+      // Legal LSX i8 width is 16 bytes (v16i8). v8i8/v4i8 legalize to GPR
+      // inserts (SAD VF=8); v32i8 is native-i8 SLP we still want to block.
+      // Keep v16i8 modest so pixel_avg / SAD-as-i32 / TAPFILTER LV fires.
+      unsigned UnalignScale = 4;
+      if (EltTy->isIntegerTy()) {
+        const unsigned Bits = EltTy->getScalarSizeInBits();
+        // Keep native v32i8 SLP expensive. Do not penalize v8i8/v4i8 loads:
+        // LASX max VF for i32-widened SAD is 8, so v8i8 is the legal VF.
+        if (Bits <= 8 && StoreSize >= 32)
+          UnalignScale = getIntegerVectorCostScale(Bits);
+        else if (Bits > 8 && Bits < 32 && StoreSize >= 16)
+          UnalignScale = getIntegerVectorCostScale(Bits);
+      }
+      Cost += UnalignScale * NumVecInsts;
+    }
+    else {
+      const uint64_t PreferredAlign = std::min<uint64_t>(16, StoreSize);
+      if (PreferredAlign > 0 && Alignment < Align(PreferredAlign))
+        Cost += NumVecInsts;
+    }
+    return Cost;
+  }
+
+  return BaseT::getMemoryOpCost(Opcode, Src, Alignment, AddressSpace, CostKind,
+                                OpInfo, I);
+}
+
+InstructionCost
+LoongArchTTIImpl::getMemIntrinsicInstrCost(const MemIntrinsicCostAttributes &MICA,
+                                           TTI::TargetCostKind CostKind) const {
+  if (!ST->hasExtLSX())
+    return BaseT::getMemIntrinsicInstrCost(MICA, CostKind);
+
+  Type *DataTy = MICA.getDataType();
+  unsigned AddressSpace = MICA.getAddressSpace();
+  Align Alignment = MICA.getAlignment();
+  auto *VecTy = dyn_cast<FixedVectorType>(DataTy);
+  const TypeSize RegBits = getRegisterBitWidth(TTI::RGK_FixedWidthVector);
+  const unsigned NumVecInsts = VecTy ? getNumVecInstsForType(VecTy, RegBits) : 1;
+
+  switch (MICA.getID()) {
+  case Intrinsic::masked_load:
+  case Intrinsic::vp_load: {
+    // Mask expansion: every lane needs an explicit branch / select, so add
+    // NumVecInsts on top of the bare load. Extra penalty for vp_* tail
+    // predication where each lane must be conditionally guarded.
+    InstructionCost Cost =
+        getMemoryOpCost(Instruction::Load, DataTy, Alignment, AddressSpace,
+                        CostKind, {TTI::OK_AnyValue, TTI::OP_None});
+    // Predicated 1D TSVC kernels (s271/s273/vif) lose to scalar when LV
+    // picks vp/masked expansion: each lane becomes a branch. Scale the
+    // mask term so those stay scalar without touching unpredicated LV.
+    InstructionCost MaskCost = 8 * NumVecInsts;
+    if (MICA.getID() == Intrinsic::vp_load)
+      MaskCost += 4 * NumVecInsts;
+    return Cost + MaskCost;
+  }
+  case Intrinsic::masked_store:
+  case Intrinsic::vp_store: {
+    // Masked store is even more costly: the missing native instruction means
+    // each lane potentially needs a read-modify-write to honour the mask.
+    InstructionCost Cost =
+        getMemoryOpCost(Instruction::Store, DataTy, Alignment, AddressSpace,
+                        CostKind, {TTI::OK_AnyValue, TTI::OP_None});
+    InstructionCost MaskCost = 12 * NumVecInsts;
+    if (MICA.getID() == Intrinsic::vp_store)
+      MaskCost += 4 * NumVecInsts;
+    return Cost + MaskCost;
+  }
+  case Intrinsic::masked_gather:
+  case Intrinsic::masked_scatter:
+  case Intrinsic::vp_gather:
+  case Intrinsic::vp_scatter:
+    if (VecTy) {
+      const unsigned MemOpcode =
+          (MICA.getID() == Intrinsic::masked_scatter ||
+           MICA.getID() == Intrinsic::vp_scatter)
+              ? Instruction::Store
+              : Instruction::Load;
+      const unsigned ElemBits = VecTy->getScalarSizeInBits();
+      const unsigned NumElts = VecTy->getNumElements();
+      InstructionCost ScalarMemCost =
+          getMemoryOpCost(MemOpcode, VecTy->getElementType(), Align(1),
+                          AddressSpace,
+                          CostKind, {TTI::OK_AnyValue, TTI::OP_None});
+      // Gather/scatter lowers to lane-wise memory ops plus extra address/mask
+      // handling. Keep this conservative to avoid over-aggressive vectorization.
+      InstructionCost Cost = ScalarMemCost * NumElts + 2 * NumVecInsts;
+      if (ElemBits >= 64)
+        Cost += NumVecInsts;
+      if (MemOpcode == Instruction::Store)
+        Cost += NumVecInsts;
+      return Cost;
+    }
+    break;
+  default:
+    break;
+  }
+
+  return BaseT::getMemIntrinsicInstrCost(MICA, CostKind);
+}
+
+InstructionCost LoongArchTTIImpl::getShuffleCost(
+    TTI::ShuffleKind Kind, VectorType *DstTy, VectorType *SrcTy,
+    ArrayRef<int> Mask, TTI::TargetCostKind CostKind, int Index,
+    VectorType *SubTp, ArrayRef<const Value *> Args,
+    const Instruction *CxtI) const {
+  auto *VecTy = dyn_cast<FixedVectorType>(DstTy);
+  if (!VecTy || !ST->hasExtLSX())
+    return BaseT::getShuffleCost(Kind, DstTy, SrcTy, Mask, CostKind, Index,
+                                 SubTp, Args, CxtI);
+
+  if (VecTy->getElementType()->isIntegerTy()) {
+    const unsigned NumVecInsts = getNumVecInstsForType(
+        DstTy, getRegisterBitWidth(TTI::RGK_FixedWidthVector));
+    // xvreplgr2vr / xvrepli: integer splat is cheap. i8 shuffles stay scaled
+    // so SAD/SLP (pixel.c) does not explode. i16/i32 shuffles are legal
+    // xvshuf / xvpermi used by zext-i8 SAD and TAPFILTER pack.
+    if (Kind == TTI::SK_Broadcast)
+      return NumVecInsts;
+    const unsigned Bits = VecTy->getScalarSizeInBits();
+    if (Bits >= 16) {
+      switch (Kind) {
+      case TTI::SK_ExtractSubvector:
+      case TTI::SK_InsertSubvector:
+      case TTI::SK_PermuteSingleSrc:
+      case TTI::SK_PermuteTwoSrc:
+      case TTI::SK_Select:
+      case TTI::SK_Reverse:
+      case TTI::SK_Transpose:
+        return NumVecInsts;
+      default:
+        return 2 * NumVecInsts;
+      }
+    }
+    // vpickev.b / vpickod.b: even/odd pack of a v16i8 load is one insn.
+    // Cheap enough that LV can cost chroma/lowres deinterleave; other i8
+    // shuffles stay scaled so SAD SLP does not rebuild from extracts.
+    if ((Kind == TTI::SK_PermuteSingleSrc ||
+         Kind == TTI::SK_ExtractSubvector) &&
+        isEvenOddPackMask(Mask))
+      return NumVecInsts;
+    const unsigned Scale = getIntegerVectorCostScale(Bits);
+    return Scale * NumVecInsts;
+  }
+
+  const TypeSize RegBits = getRegisterBitWidth(TTI::RGK_FixedWidthVector);
+  const unsigned NumVecInsts = getNumVecInstsForType(DstTy, RegBits);
+
+  switch (Kind) {
+  case TTI::SK_Broadcast:
+    // Splat-from-lane is typically a single lane-replicate instruction.
+    if (!Mask.empty())
+      return NumVecInsts;
+    return 2 * NumVecInsts;
+  case TTI::SK_Reverse:
+    // Cheap hardware reverse (xvshuf4i / equivalent). Do NOT mark FP reverse
+    // Invalid — reversed counted loops (TSVC s1112/s112) need it. Reverse-
+    // indexed FP *reductions* (s118) are instead blocked via loop metadata in
+    // LoongArchFPIndVarPass.
+    return NumVecInsts;
+  case TTI::SK_Select:
+  case TTI::SK_PermuteSingleSrc:
+  case TTI::SK_InsertSubvector:
+  case TTI::SK_ExtractSubvector:
+    return NumVecInsts;
+  case TTI::SK_PermuteTwoSrc:
+    if (isSimpleInterleaveMask(Mask))
+      return NumVecInsts;
+    return 2 * NumVecInsts;
+  case TTI::SK_Transpose:
+    return ST->hasExtLASX() ? NumVecInsts : 2 * NumVecInsts;
+  default:
+    break;
+  }
+
+  return BaseT::getShuffleCost(Kind, DstTy, SrcTy, Mask, CostKind, Index, SubTp,
+                               Args, CxtI);
+}
+
+InstructionCost LoongArchTTIImpl::getCastInstrCost(unsigned Opcode, Type *Dst,
+                                                   Type *Src,
+                                                   TTI::CastContextHint CCH,
+                                                   TTI::TargetCostKind CostKind,
+                                                   const Instruction *I) const {
+  if (!isa<FixedVectorType>(Dst) || !isa<FixedVectorType>(Src) ||
+      !ST->hasExtLSX())
+    return BaseT::getCastInstrCost(Opcode, Dst, Src, CCH, CostKind, I);
+
+  const TypeSize RegBits = getRegisterBitWidth(TTI::RGK_FixedWidthVector);
+  const unsigned NumVecInsts = std::max(getNumVecInstsForType(Dst, RegBits),
+                                        getNumVecInstsForType(Src, RegBits));
+  const unsigned DstBits = Dst->getScalarSizeInBits();
+  const unsigned SrcBits = Src->getScalarSizeInBits();
+
+  const bool IntVecCast =
+      Dst->getScalarType()->isIntegerTy() && Src->getScalarType()->isIntegerTy();
+  // LASX/LSX have single-instruction (or short pack trees for) i8<->i16<->i32
+  // widen/narrow (vext2xv / vsllwil / ssrlni / pickev). Cost those as
+  // NumVecInsts so pixel_avg / mc_weight SLP is allowed. Do NOT use the i8
+  // arith scale here: that is what blocked mc_luma (zext i8->i32 cost 512).
+  // i32<->i64 is the LP64 GEP/sitofp induction path (s452): default scale 64
+  // made VF=8 lose to a VF=2 vinsgr soup (~0.72x). vext2xv.d.w / pickev pack
+  // those casts. Do not cheapen i8<->i64 (SAD). Memory cost stays scaled.
+  const bool CheapIntWidenNarrow =
+      IntVecCast && DstBits != 1 && SrcBits != 1 &&
+      ((DstBits <= 32 && SrcBits <= 32 &&
+        (DstBits == 8 || DstBits == 16 || DstBits == 32) &&
+        (SrcBits == 8 || SrcBits == 16 || SrcBits == 32)) ||
+       ((DstBits == 32 && SrcBits == 64) || (DstBits == 64 && SrcBits == 32)));
+
+  const unsigned IntCastScale =
+      IntVecCast ? (CheapIntWidenNarrow
+                        ? 1u
+                        : getIntegerVectorCostScale(std::min(DstBits, SrcBits)))
+                 : 1u;
+
+  switch (Opcode) {
+  case Instruction::BitCast:
+    return 0;
+  case Instruction::Trunc:
+  case Instruction::ZExt:
+  case Instruction::SExt:
+  case Instruction::FPExt:
+  case Instruction::FPTrunc:
+    if (DstBits == 1 || SrcBits == 1)
+      return 3 * NumVecInsts * IntCastScale;
+    return NumVecInsts * IntCastScale;
+  case Instruction::FPToSI:
+  case Instruction::FPToUI:
+  case Instruction::SIToFP:
+  case Instruction::UIToFP:
+    // xvffint / vffint are single-instruction per chunk; keep cost at
+    // NumVecInsts so induction-heavy loops (s452/s453-style) stay profitable.
+    return NumVecInsts;
+  default:
+    break;
+  }
+
+  return BaseT::getCastInstrCost(Opcode, Dst, Src, CCH, CostKind, I);
+}
+
+InstructionCost
+LoongArchTTIImpl::getMinMaxReductionCost(Intrinsic::ID IID, VectorType *Ty,
+                                         FastMathFlags FMF,
+                                         TTI::TargetCostKind CostKind) const {
+  auto *VecTy = dyn_cast<FixedVectorType>(Ty);
+  if (!VecTy || !ST->hasExtLSX())
+    return BaseT::getMinMaxReductionCost(IID, Ty, FMF, CostKind);
+
+  switch (IID) {
+  case Intrinsic::smax:
+  case Intrinsic::smin:
+  case Intrinsic::umax:
+  case Intrinsic::umin:
+  case Intrinsic::maxnum:
+  case Intrinsic::minnum:
+  case Intrinsic::maximum:
+  case Intrinsic::minimum:
+    break;
+  default:
+    return BaseT::getMinMaxReductionCost(IID, Ty, FMF, CostKind);
+  }
+
+  const uint64_t VecBits = VecTy->getPrimitiveSizeInBits().getKnownMinValue();
+  if (ST->hasExtLASX() && VecBits > 128) {
+    const bool IsFP = VecTy->getElementType()->isFloatingPointTy();
+    if (IsFP) {
+      // FMAX/FMIN on v8f32/v4f64 use Custom ISelLowering: fold upper lane with
+      // a single XVFMAX/XVFMIN, then run the 128-bit VBSRL chain.
+      const unsigned ChunkElts = VecTy->getNumElements() / 2;
+      unsigned ChunkSteps = 0;
+      for (unsigned N = ChunkElts; N > 1; N /= 2)
+        ++ChunkSteps;
+      return static_cast<InstructionCost>(2 * ChunkSteps + 3);
+    }
+    // Integer min/max on 256-bit vectors still use the Expand path (split to
+    // 128-bit chunks, reduce each, combine scalar results).
+    const unsigned NumSplits =
+        static_cast<unsigned>(std::max<uint64_t>(1, divideCeil(VecBits, 128)));
+    const unsigned ChunkElts = VecTy->getNumElements() / NumSplits;
+    unsigned ChunkSteps = 0;
+    for (unsigned N = ChunkElts; N > 1; N = (N + 1) / 2)
+      ++ChunkSteps;
+    const InstructionCost ChunkCost = 2 * ChunkSteps + 1;
+    const InstructionCost ScalarCombine = NumSplits > 1 ? NumSplits - 1 : 0;
+    return NumSplits * ChunkCost + ScalarCombine;
+  }
+
+  const TypeSize RegBits = getRegisterBitWidth(TTI::RGK_FixedWidthVector);
+  const unsigned NumVecInsts = getNumVecInstsForType(VecTy, RegBits);
+  unsigned Steps = 0;
+  for (unsigned N = VecTy->getNumElements(); N > 1; N = (N + 1) / 2)
+    ++Steps;
+
+  // lowerVECREDUCE lowers min/max with:
+  //   repeat (VBSRL + V{MIN/MAX}) per step, then EXTRACT_VECTOR_ELT.
+  return static_cast<InstructionCost>(2 * Steps + 1) * NumVecInsts;
+}
+
+InstructionCost LoongArchTTIImpl::getArithmeticReductionCost(
+    unsigned Opcode, VectorType *Ty, std::optional<FastMathFlags> FMF,
+    TTI::TargetCostKind CostKind) const {
+  auto *VecTy = dyn_cast<FixedVectorType>(Ty);
+  if (!VecTy || !ST->hasExtLSX())
+    return BaseT::getArithmeticReductionCost(Opcode, Ty, FMF, CostKind);
+
+  switch (Opcode) {
+  case Instruction::Add:
+  case Instruction::And:
+  case Instruction::Or:
+  case Instruction::Xor:
+  case Instruction::FAdd:
+  case Instruction::FMul:
+    break;
+  default:
+    return BaseT::getArithmeticReductionCost(Opcode, Ty, FMF, CostKind);
+  }
+
+  const TypeSize RegBits = getRegisterBitWidth(TTI::RGK_FixedWidthVector);
+  const unsigned NumVecInsts = getNumVecInstsForType(VecTy, RegBits);
+  unsigned Steps = 0;
+  for (unsigned N = VecTy->getNumElements(); N > 1; N = (N + 1) / 2)
+    ++Steps;
+
+  if (Opcode == Instruction::Add) {
+    // Integer add reduction uses chained VHADDW + extract. i8 stays scaled so
+    // native i8 SAD reductions do not look free; i16/i32 match the legal
+    // vhaddw.{h,w} sequence (SAD-as-i32 after vext2xv).
+    unsigned Scale = 1;
+    if (VecTy->getElementType()->isIntegerTy()) {
+      const unsigned Bits = VecTy->getScalarSizeInBits();
+      Scale = Bits <= 8 ? getIntegerVectorCostScale(Bits) : 4;
+    }
+    InstructionCost Cost =
+        static_cast<InstructionCost>(Steps + 1) * NumVecInsts * Scale;
+    // 256-bit LASX add reduction has an extra cross-lane fold.
+    if (ST->hasExtLASX() && VecTy->getPrimitiveSizeInBits().getKnownMinValue() >
+                                 RegBits.getKnownMinValue())
+      Cost += 2 * NumVecInsts;
+    return Cost;
+  }
+
+  const uint64_t VecBits = VecTy->getPrimitiveSizeInBits().getKnownMinValue();
+
+  // Ordered (non-reassociative) FP reductions are expanded in IR by
+  // LoongArchVectorIdiomPass to element-0 extract + VBSRL + scalar op:
+  //   acc = fadd(acc, vec[0]); vec = vbsrl(vec, elem_bytes); repeat
+  // Element-0 extract is a free subreg copy; VBSRL replaces pickve for lanes
+  // 1..N-1.  Cost ~2 ops/element keeps pure-sum loops neutral while dot
+  // products and manual s312 vectorization remain profitable.
+  if ((Opcode == Instruction::FAdd || Opcode == Instruction::FMul) &&
+      (!FMF || !FMF->allowReassoc())) {
+    // Ordered: xvld + lane-0 extract (free) + (N-1)*(vbsrl+fadd). Cost ~N
+    // so pure-sum loops (s311) become profitable vs scalar ld.s+fadd, while
+    // still not pretending a tree reduction is legal.
+    return static_cast<InstructionCost>(VecTy->getNumElements());
+  }
+
+  if (ST->hasExtLASX() && VecBits > 128 &&
+      (Opcode == Instruction::FAdd || Opcode == Instruction::FMul)) {
+    // Unordered (reassociative) FP reductions on 256-bit vectors use a Custom
+    // ISelLowering path:
+    //   EXTRACT_SUBVECTOR Hi  (1 op)
+    //   XVFADD/XVFMUL Hi, Lo  (1 op, folding upper lane into lower)
+    //   then 128-bit VBSRL+FADD chain  (2*ChunkSteps ops)
+    //   EXTRACT_VECTOR_ELT    (1 op)
+    const unsigned ChunkElts = VecTy->getNumElements() / 2;
+    unsigned ChunkSteps = 0;
+    for (unsigned N = ChunkElts; N > 1; N /= 2)
+      ++ChunkSteps;
+    return static_cast<InstructionCost>(2 * ChunkSteps + 3);
+  }
+
+  if (ST->hasExtLASX() && VecBits > 128) {
+    // And/Or/Xor on 256-bit vectors are still Expand (split to 128-bit chunks).
+    const unsigned NumSplits =
+        static_cast<unsigned>(std::max<uint64_t>(1, divideCeil(VecBits, 128)));
+    const unsigned ChunkElts = VecTy->getNumElements() / NumSplits;
+    unsigned ChunkSteps = 0;
+    for (unsigned N = ChunkElts; N > 1; N = (N + 1) / 2)
+      ++ChunkSteps;
+    const InstructionCost ChunkCost = 2 * ChunkSteps + 1;
+    const InstructionCost ScalarCombine = NumSplits > 1 ? NumSplits - 1 : 0;
+    return NumSplits * ChunkCost + ScalarCombine;
+  }
+
+  // FAdd/FMul/And/Or/Xor reductions lower to:
+  //   repeat (VBSRL + V{FADD/FMUL/AND/OR/XOR}) per step, then EXTRACT.
+  return static_cast<InstructionCost>(2 * Steps + 1) * NumVecInsts;
+}
+
+InstructionCost
+LoongArchTTIImpl::getIntrinsicInstrCost(const IntrinsicCostAttributes &ICA,
+                                       TTI::TargetCostKind CostKind) const {
+  auto *VecTy = dyn_cast_or_null<FixedVectorType>(ICA.getReturnType());
+  if (!VecTy || !ST->hasExtLSX())
+    return BaseT::getIntrinsicInstrCost(ICA, CostKind);
+
+  Type *EltTy = VecTy->getElementType();
+  const TypeSize RegBits = getRegisterBitWidth(TTI::RGK_FixedWidthVector);
+  const unsigned NumVecInsts = getNumVecInstsForType(VecTy, RegBits);
+
+  // LA664 (3A6000) reference numbers come from the Unofficial LoongArch
+  // Intrinsics Guide (https://jia.je/unofficial-loongarch-intrinsics-guide/):
+  //   vfmadd.{s,d}   : latency 5, throughput 2
+  //   vfsqrt.{s,d}   : multi-cycle, throughput limited
+  //   vmax/vmin.*    : latency 1, throughput 2
+  //   vpcnt.*        : latency 2, throughput 2
+  //   vclz/vctz.*    : latency 2, throughput 2
+  switch (ICA.getID()) {
+  case Intrinsic::fma:
+  case Intrinsic::fmuladd:
+    if (EltTy->isFloatingPointTy())
+      return NumVecInsts;
+    break;
+  case Intrinsic::fabs:
+  case Intrinsic::copysign:
+  case Intrinsic::canonicalize:
+    if (EltTy->isFloatingPointTy())
+      return NumVecInsts;
+    break;
+  case Intrinsic::sqrt:
+    if (EltTy->isFloatingPointTy()) {
+      // vfsqrt.{s,d} on LA664 is non-pipelined; model conservatively but still
+      // cheaper than a libcall fallback.
+      return static_cast<InstructionCost>(8) * NumVecInsts;
+    }
+    break;
+  case Intrinsic::smax:
+  case Intrinsic::smin:
+  case Intrinsic::umax:
+  case Intrinsic::umin:
+    if (EltTy->isIntegerTy()) {
+      unsigned Bits = EltTy->getScalarSizeInBits();
+      // vmin/vmax.{h,w,d} are single-instruction. i32 clip (0..255) is the
+      // mc_weight / hpel TAPFILTER epilogue; costing it like SAD (scale 64)
+      // kept those loops scalar. i8 min/max stay expensive.
+      if (Bits >= 16)
+        return 4 * NumVecInsts;
+      return getIntegerVectorCostScale(Bits) * NumVecInsts;
+    }
+    break;
+  case Intrinsic::maxnum:
+  case Intrinsic::minnum:
+  case Intrinsic::maximum:
+  case Intrinsic::minimum:
+    if (EltTy->isFloatingPointTy())
+      return NumVecInsts;
+    break;
+  case Intrinsic::abs:
+    if (EltTy->isIntegerTy()) {
+      unsigned Bits = EltTy->getScalarSizeInBits();
+      if (Bits >= 16)
+        return 4 * NumVecInsts;
+      return getIntegerVectorCostScale(Bits) * NumVecInsts;
+    }
+    break;
+  case Intrinsic::ctpop:
+    if (EltTy->isIntegerTy())
+      return getIntegerVectorCostScale(EltTy->getScalarSizeInBits()) * NumVecInsts;
+    break;
+  case Intrinsic::ctlz:
+  case Intrinsic::cttz:
+    if (EltTy->isIntegerTy())
+      return NumVecInsts;
+    break;
+  case Intrinsic::bswap:
+    if (EltTy->isIntegerTy())
+      return 2 * NumVecInsts;
+    break;
+  case Intrinsic::bitreverse:
+    if (EltTy->isIntegerTy())
+      return 2 * NumVecInsts;
+    break;
+  default:
+    break;
+  }
+
+  return BaseT::getIntrinsicInstrCost(ICA, CostKind);
+}
+
 bool LoongArchTTIImpl::shouldExpandReduction(const IntrinsicInst *II) const {
   switch (II->getIntrinsicID()) {
   default:
@@ -107,7 +835,18 @@ bool LoongArchTTIImpl::shouldExpandReduction(const IntrinsicInst *II) const {
   case Intrinsic::vector_reduce_umax:
   case Intrinsic::vector_reduce_umin:
   case Intrinsic::vector_reduce_xor:
+  // FP reductions: only opt out of middle-end expansion when reassociation
+  // is allowed; otherwise the strict-sequential semantics must be preserved
+  // by the generic expansion. The backend has Custom lowering for the
+  // relaxed-order ISD::VECREDUCE_F* nodes.
+  case Intrinsic::vector_reduce_fmax:
+  case Intrinsic::vector_reduce_fmin:
+  case Intrinsic::vector_reduce_fmaximum:
+  case Intrinsic::vector_reduce_fminimum:
     return false;
+  case Intrinsic::vector_reduce_fadd:
+  case Intrinsic::vector_reduce_fmul:
+    return !II->getFastMathFlags().allowReassoc();
   }
 }
 
