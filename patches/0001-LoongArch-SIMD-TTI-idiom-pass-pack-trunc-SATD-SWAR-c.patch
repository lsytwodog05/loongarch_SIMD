+// Helper: build a deinterleave (even or odd indices) mask of length \p N.
+static SmallVector<int, 32> buildDeinterleaveMask(unsigned N, bool Odd) {
+  SmallVector<int, 32> Mask;
+  Mask.reserve(N);
+  for (unsigned I = 0; I < N; ++I)
+    Mask.push_back(static_cast<int>(2 * I + (Odd ? 1 : 0)));
+  return Mask;
+}
+
+// Recognize:
+//   %wide = load <N*Factor x T>, ptr %p
+//   %s_k  = shufflevector %wide, undef, <deinterleave-mask k of N>
+// for k in [0, Factor). Lower this into Factor contiguous narrow loads and a
+// short tree of pack shuffles that LSX/LASX can select as vilvl/vilvh/
+// vpackev/vpackod chains. Both Factor == 2 and Factor == 4 are handled here
+// (covers complex-number and RGBA-style TSVC kernels).
+bool LoongArchTargetLowering::lowerInterleavedLoad(
+    Instruction *Load, Value *Mask, ArrayRef<ShuffleVectorInst *> Shuffles,
+    ArrayRef<unsigned> Indices, unsigned Factor,
+    const APInt &GapMask) const {
+  if (!Subtarget.hasExtLSX())
+    return false;
+  // Only handle plain LoadInst (skip vp.load for now) and unmasked accesses.
+  auto *LI = dyn_cast<LoadInst>(Load);
+  if (!LI || Mask)
+    return false;
+  if (Factor != 2 && Factor != 4)
+    return false;
+  if (Shuffles.empty() || Shuffles.size() != Indices.size())
+    return false;
+  if (GapMask.popcount() != Factor)
+    return false;
+
+  auto *SubVTy = dyn_cast<FixedVectorType>(Shuffles[0]->getType());
+  if (!SubVTy)
+    return false;
+  unsigned NumElts = SubVTy->getNumElements();
+  if (NumElts == 0)
+    return false;
+
+  // Skip vector-of-pointer; backend lowering would need an extra inttoptr.
+  if (SubVTy->getElementType()->isPointerTy())
+    return false;
+
+  // Require legal element type. Vector-of-i1 is rejected by the generic
+  // isShuffleMaskLegal check, so reuse it here.
+  EVT SubEVT = EVT::getEVT(SubVTy, /*HandleUnknown=*/true);
+  if (SubEVT == MVT::Other || !isTypeLegal(SubEVT))
+    return false;
+
+  const DataLayout &DL = LI->getDataLayout();
+  IRBuilder<> Builder(LI);
+
+  Value *BasePtr = LI->getPointerOperand();
+  Align BaseAlign = LI->getAlign();
+  Type *EltTy = SubVTy->getElementType();
+  unsigned EltSize = DL.getTypeAllocSize(EltTy).getFixedValue();
+
+  // Issue Factor contiguous narrow loads that together cover the original
+  // wide load. Each chunk is the same width as the deinterleaved result.
+  SmallVector<Value *, 4> Chunks;
+  Chunks.reserve(Factor);
+  for (unsigned I = 0; I < Factor; ++I) {
+    Value *Ptr = BasePtr;
+    Align A = BaseAlign;
+    if (I > 0) {
+      Ptr = Builder.CreateConstInBoundsGEP1_32(EltTy, BasePtr, I * NumElts,
+                                               "ia.ptr");
+      A = commonAlignment(BaseAlign, EltSize * I * NumElts);
+    }
+    Chunks.push_back(
+        Builder.CreateAlignedLoad(SubVTy, Ptr, A, "ia.chunk"));
+  }
+
+  // Factor == 2: a single even/odd shuffle pair is sufficient.
+  if (Factor == 2) {
+    SmallVector<int, 32> EvenMask =
+        buildDeinterleaveMask(NumElts, /*Odd=*/false);
+    SmallVector<int, 32> OddMask =
+        buildDeinterleaveMask(NumElts, /*Odd=*/true);
+    Value *Even =
+        Builder.CreateShuffleVector(Chunks[0], Chunks[1], EvenMask, "ia.even");
+    Value *Odd =
+        Builder.CreateShuffleVector(Chunks[0], Chunks[1], OddMask, "ia.odd");
+    for (unsigned I = 0; I < Shuffles.size(); ++I) {
+      ShuffleVectorInst *SVI = Shuffles[I];
+      SVI->replaceAllUsesWith(Indices[I] == 0 ? Even : Odd);
+    }
+    return true;
+  }
+
+  // Factor == 4: do a two-level even/odd reduction.
+  //   Lane[k] = deinterleave(2 narrow loads); each level halves Factor.
+  //
+  // Level 1 (Factor 4 -> Factor 2 partials):
+  //   P0 = even(C0, C1)  P1 = odd(C0, C1)
+  //   P2 = even(C2, C3)  P3 = odd(C2, C3)
+  // Level 2 (combine partials into the four de-interleaved lanes):
+  //   Lane0 = even(P0, P2)  Lane2 = odd(P0, P2)
+  //   Lane1 = even(P1, P3)  Lane3 = odd(P1, P3)
+  SmallVector<int, 32> EvenMask =
+      buildDeinterleaveMask(NumElts, /*Odd=*/false);
+  SmallVector<int, 32> OddMask = buildDeinterleaveMask(NumElts, /*Odd=*/true);
+  Value *P0 = Builder.CreateShuffleVector(Chunks[0], Chunks[1], EvenMask,
+                                          "ia.p0");
+  Value *P1 =
+      Builder.CreateShuffleVector(Chunks[0], Chunks[1], OddMask, "ia.p1");
+  Value *P2 = Builder.CreateShuffleVector(Chunks[2], Chunks[3], EvenMask,
+                                          "ia.p2");
+  Value *P3 =
+      Builder.CreateShuffleVector(Chunks[2], Chunks[3], OddMask, "ia.p3");
+  Value *Lane[4];
+  Lane[0] = Builder.CreateShuffleVector(P0, P2, EvenMask, "ia.lane0");
+  Lane[2] = Builder.CreateShuffleVector(P0, P2, OddMask, "ia.lane2");
+  Lane[1] = Builder.CreateShuffleVector(P1, P3, EvenMask, "ia.lane1");
+  Lane[3] = Builder.CreateShuffleVector(P1, P3, OddMask, "ia.lane3");
+  for (unsigned I = 0; I < Shuffles.size(); ++I) {
+    ShuffleVectorInst *SVI = Shuffles[I];
+    unsigned Idx = Indices[I];
+    if (Idx >= 4)
+      return false;
+    SVI->replaceAllUsesWith(Lane[Idx]);
+  }
+  return true;
+}
+
+// Interleave-store lowering is intentionally left to the generic shuffle
+// path: LoongArch already pattern-matches the textbook
+//   shufflevector <0,N,1,N+1,...> + wide store
+// during VECTOR_SHUFFLE lowering and selects VILVL/VILVH/VPACKEV/VPACKOD
+// pairs, so rewriting the store at the IR level provides no extra benefit
+// and risks regressions for less-canonical interleave masks.
+bool LoongArchTargetLowering::lowerInterleavedStore(
+    Instruction *Store, Value *Mask, ShuffleVectorInst *SVI, unsigned Factor,
+    const APInt &GapMask) const {
+  return false;
+}
