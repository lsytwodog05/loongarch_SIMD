+// Map a (size-in-bits, isLASX) pair to the right LSX/LASX intrinsic id.
+struct AvgIDs {
+  Intrinsic::ID Avg;
+  Intrinsic::ID AvgR;
+};
+
+static AvgIDs getUnsignedAvgIntrinsics(unsigned EltBits, bool IsLASX) {
+  AvgIDs Out{Intrinsic::not_intrinsic, Intrinsic::not_intrinsic};
+  if (IsLASX) {
+    switch (EltBits) {
+    case 8:
+      Out = {Intrinsic::loongarch_lasx_xvavg_bu,
+             Intrinsic::loongarch_lasx_xvavgr_bu};
+      break;
+    case 16:
+      Out = {Intrinsic::loongarch_lasx_xvavg_hu,
+             Intrinsic::loongarch_lasx_xvavgr_hu};
+      break;
+    case 32:
+      Out = {Intrinsic::loongarch_lasx_xvavg_wu,
+             Intrinsic::loongarch_lasx_xvavgr_wu};
+      break;
+    case 64:
+      Out = {Intrinsic::loongarch_lasx_xvavg_du,
+             Intrinsic::loongarch_lasx_xvavgr_du};
+      break;
+    }
+  } else {
+    switch (EltBits) {
+    case 8:
+      Out = {Intrinsic::loongarch_lsx_vavg_bu,
+             Intrinsic::loongarch_lsx_vavgr_bu};
+      break;
+    case 16:
+      Out = {Intrinsic::loongarch_lsx_vavg_hu,
+             Intrinsic::loongarch_lsx_vavgr_hu};
+      break;
+    case 32:
+      Out = {Intrinsic::loongarch_lsx_vavg_wu,
+             Intrinsic::loongarch_lsx_vavgr_wu};
+      break;
+    case 64:
+      Out = {Intrinsic::loongarch_lsx_vavg_du,
+             Intrinsic::loongarch_lsx_vavgr_du};
+      break;
+    }
+  }
+  return Out;
+}
+
+// Check that VT is an LSX (128b) or LASX (256b) integer vector with i8/i16/
+// i32/i64 lanes, and return (EltBits, IsLASX). Otherwise return {0, false}.
+static std::pair<unsigned, bool> classifyIntVec(Type *Ty,
+                                                const LoongArchSubtarget &ST) {
+  auto *VTy = dyn_cast<FixedVectorType>(Ty);
+  if (!VTy)
+    return {0, false};
+  Type *Elt = VTy->getElementType();
+  if (!Elt->isIntegerTy())
+    return {0, false};
+  const unsigned EltBits = Elt->getIntegerBitWidth();
+  if (EltBits != 8 && EltBits != 16 && EltBits != 32 && EltBits != 64)
+    return {0, false};
+  const unsigned VecBits = static_cast<unsigned>(
+      VTy->getPrimitiveSizeInBits().getFixedValue());
+  if (VecBits == 128 && ST.hasExtLSX())
+    return {EltBits, /*IsLASX=*/false};
+  if (VecBits == 256 && ST.hasExtLASX())
+    return {EltBits, /*IsLASX=*/true};
+  return {0, false};
+}
+
+// Returns true if V matches a vector splat of an all-ones-equivalent value of
+// the desired magnitude (i.e. a constant integer 1 broadcast to the lane).
+// Safe to call on values of any type; non-vector values yield false.
+static bool isVectorSplatOne(Value *V) {
+  if (!V->getType()->isVectorTy())
+    return false;
+  Constant *C = dyn_cast<Constant>(V);
+  if (!C)
+    return false;
+  Constant *Splat = C->getSplatValue(/*AllowPoison=*/true);
+  if (!Splat)
+    return false;
+  auto *CI = dyn_cast<ConstantInt>(Splat);
+  return CI && CI->isOne();
+}
+
+// Try to peel a `+ splat(1)` from V. If V is an `add nuw` chain that contains
+// a constant-one splat operand, set Stripped to the remaining operand and
+// return true. Handles operand commutativity.
+static bool stripPlusOne(Value *V, Value *&Stripped) {
+  Value *X = nullptr;
+  Value *Y = nullptr;
+  if (!match(V, m_NUWAdd(m_Value(X), m_Value(Y))))
+    return false;
+  if (isVectorSplatOne(X)) {
+    Stripped = Y;
+    return true;
+  }
+  if (isVectorSplatOne(Y)) {
+    Stripped = X;
+    return true;
+  }
+  return false;
+}
+
+// Recognize, modulo commutativity and reassociation:
+//   %r = lshr (add nuw %a, %b), splat(1)               -> vavg.{Eu}
+//   %r = lshr (add nuw (add nuw %a, %b), 1), splat(1)  -> vavgr.{Eu}
+//   %r = lshr (add nuw (add nuw %a, 1), %b), splat(1)  -> vavgr.{Eu}
+// where %a/%b are LSX/LASX integer vectors of equal type. We require all
+// adds to be `nuw` to guarantee unsigned-safe averaging semantics.
+static bool tryFoldAverageLshr(Instruction &I,
+                               const LoongArchSubtarget &ST) {
+  if (I.getOpcode() != Instruction::LShr)
+    return false;
+
+  // RHS must be a splat-of-1.
+  Value *L = I.getOperand(0);
+  Value *R = I.getOperand(1);
+  if (!isVectorSplatOne(R))
+    return false;
+
+  auto VK = classifyIntVec(I.getType(), ST);
+  if (VK.first == 0)
+    return false;
+  unsigned EltBits = VK.first;
+  bool IsLASX = VK.second;
+
+  Value *P = nullptr, *Q = nullptr;
+  if (!match(L, m_NUWAdd(m_Value(P), m_Value(Q))))
+    return false;
+
+  Value *A = nullptr, *B = nullptr;
+  bool IsRounding = false;
+
+  // Case 1: top-level is (X + Y + 1) where one of X/Y is a splat-1 chain.
+  Value *Stripped = nullptr;
+  if (isVectorSplatOne(P) && match(Q, m_NUWAdd(m_Value(A), m_Value(B)))) {
+    IsRounding = true;
+  } else if (isVectorSplatOne(Q) && match(P, m_NUWAdd(m_Value(A), m_Value(B)))) {
+    IsRounding = true;
+  } else if (stripPlusOne(P, Stripped)) {
+    // P == add nuw X, 1  →  (X + 1) + Q  ≡  (X + Q) + 1
+    A = Stripped;
+    B = Q;
+    IsRounding = true;
+  } else if (stripPlusOne(Q, Stripped)) {
+    // Q == add nuw Y, 1  →  P + (Y + 1)  ≡  (P + Y) + 1
+    A = P;
+    B = Stripped;
+    IsRounding = true;
+  } else {
+    A = P;
+    B = Q;
+  }
+
+  if (!A || !B || A->getType() != I.getType() || B->getType() != I.getType())
+    return false;
+
+  AvgIDs IDs = getUnsignedAvgIntrinsics(EltBits, IsLASX);
+  Intrinsic::ID Wanted = IsRounding ? IDs.AvgR : IDs.Avg;
+  if (Wanted == Intrinsic::not_intrinsic)
+    return false;
+
+  IRBuilder<> Builder(&I);
+  // LoongArch LSX/LASX vector intrinsics expect the same vector type for both
+  // operands and result; some declare operands as <N x iK> signed but the
+  // _bu/_hu/_wu/_du variants implement unsigned-arithmetic, so a bitcast is
+  // not needed at the IR level.
+  Function *F = Intrinsic::getOrInsertDeclaration(
+      I.getModule(), Wanted, {});
+  Value *Call = Builder.CreateCall(F, {A, B});
+  I.replaceAllUsesWith(Call);
+  I.eraseFromParent();
+  if (IsRounding)
+    ++NumAvgrU;
+  else
+    ++NumAvgU;
+  return true;
+}
+
+/// Expand @llvm.vector.reduce.fadd/fmul (strict, no reassoc) into an ordered
+/// lane-by-lane reduction using element-0 extract + VBSRL.  This preserves
+/// bit-exact FP semantics while avoiding the generic ExpandReductions path
+/// that lowers to xvpickve/vpickve extraction chains (TSVC s311/vsumr).
+static bool tryRewriteOrderedVectorReduce(IntrinsicInst &II,
+                                          const LoongArchSubtarget &ST) {
+  Intrinsic::ID ID = II.getIntrinsicID();
+  if (ID != Intrinsic::vector_reduce_fadd && ID != Intrinsic::vector_reduce_fmul)
+    return false;
+  if (II.getFastMathFlags().allowReassoc())
+    return false;
+
+  auto *VecTy = dyn_cast<FixedVectorType>(II.getArgOperand(1)->getType());
+  if (!VecTy || !VecTy->getElementType()->isFloatingPointTy())
+    return false;
+
+  const unsigned VecBits =
+      static_cast<unsigned>(VecTy->getPrimitiveSizeInBits().getFixedValue());
+  const bool IsLASX = VecBits == 256 && ST.hasExtLASX();
+  if (VecBits == 128) {
+    if (!ST.hasExtLSX())
+      return false;
+  } else if (!IsLASX) {
+    return false;
+  }
+
+  const unsigned NumElts = VecTy->getNumElements();
+  if (NumElts == 0)
+    return false;
+
+  const unsigned OpCode =
+      ID == Intrinsic::vector_reduce_fadd ? Instruction::FAdd : Instruction::FMul;
+  const unsigned ShiftBytes =
+      VecTy->getElementType()->getPrimitiveSizeInBits() / 8;
+  Intrinsic::ID VbsrlID = IsLASX ? Intrinsic::loongarch_lasx_xvbsrl_v
+                                 : Intrinsic::loongarch_lsx_vbsrl_v;
+
+  LLVMContext &Ctx = II.getContext();
+  auto *Int8Ty = Type::getInt8Ty(Ctx);
+
+  IRBuilder<> Builder(&II);
+  Builder.setFastMathFlags(II.getFastMathFlags());
+
+  Value *Acc = II.getArgOperand(0);
+  Value *Vec = II.getArgOperand(1);
+  Value *ShiftC = ConstantInt::get(Type::getInt32Ty(Ctx), ShiftBytes);
+
+  auto orderedReduceLanes = [&](Value *StartAcc, Value *LaneVec,
+                                unsigned Lanes, Intrinsic::ID LocalVbsrlID,
+                                unsigned LocalVecBits) {
+    Value *CurAcc = StartAcc;
+    Value *CurVec = LaneVec;
+    auto *LocalIntVecTy = FixedVectorType::get(Int8Ty, LocalVecBits / 8);
+    Function *LocalVbsrlFn =
+        Intrinsic::getOrInsertDeclaration(II.getModule(), LocalVbsrlID, {});
+    for (unsigned Lane = 0; Lane < Lanes; ++Lane) {
+      Value *Elt =
+          Builder.CreateExtractElement(CurVec, Builder.getInt32(0), "loong.rdx.e");
+      CurAcc = Builder.CreateBinOp((Instruction::BinaryOps)OpCode, CurAcc, Elt,
+                                   "loong.rdx");
+      if (Lane + 1 < Lanes) {
+        Value *Bytes = Builder.CreateBitCast(CurVec, LocalIntVecTy);
+        Bytes = Builder.CreateCall(LocalVbsrlFn, {Bytes, ShiftC}, "loong.vbsrl");
+        CurVec = Builder.CreateBitCast(Bytes, LaneVec->getType());
+      }
+    }
+    return CurAcc;
+  };
+
+  // LASX 256-bit registers are two 128-bit lanes.  Whole-register xvbsrl does
+  // not advance logical element indices across the lane boundary, so reduce in
+  // 128-bit chunks (4 x f32 or 2 x f64 per chunk) with LSX vbsrl.
+  const unsigned EltBits = VecTy->getElementType()->getPrimitiveSizeInBits();
+  const unsigned HalfElts = 128 / EltBits;
+  if (IsLASX && NumElts > HalfElts) {
+    SmallVector<int, 16> Mask(HalfElts);
+    for (unsigned Off = 0; Off < NumElts; Off += HalfElts) {
+      for (unsigned I = 0; I < HalfElts; ++I)
+        Mask[I] = static_cast<int>(Off + I);
+      Value *Chunk = Builder.CreateShuffleVector(Vec, PoisonValue::get(VecTy), Mask);
+      auto *ChunkTy = cast<FixedVectorType>(Chunk->getType());
+      Acc = orderedReduceLanes(Acc, Chunk, ChunkTy->getNumElements(),
+                               Intrinsic::loongarch_lsx_vbsrl_v, 128);
+    }
+  } else {
+    Acc = orderedReduceLanes(Acc, Vec, NumElts, VbsrlID, VecBits);
+  }
+
+  II.replaceAllUsesWith(Acc);
+  II.eraseFromParent();
+  ++NumOrderedFPRdx;
+  return true;
+}
+
+/// x264-style SWAR: two signed i16 values packed in an i32 as x+(y<<16),
+/// with 32-bit add/sub (carry between halves is part of the representation).
+/// abs2 is:
+///   s = ((a >> 15) & 0x10001) * 0xFFFF
+///   (a + s) ^ s
+/// Independent v2i16 abs is NOT equivalent (carry into the high half when the
+/// low i16 is negative). Vectorize as <N x i32> so the bit pattern matches C.
+
+static bool matchPackedI16Abs2Mul(Value *Mul, Value *&Packed) {
+  auto *MulBO = dyn_cast<BinaryOperator>(Mul);
+  if (!MulBO || MulBO->getOpcode() != Instruction::Mul)
+    return false;
+  Value *AndV = MulBO->getOperand(0);
+  Value *C = MulBO->getOperand(1);
+  if (isa<ConstantInt>(AndV))
+    std::swap(AndV, C);
+  auto *MulC = dyn_cast<ConstantInt>(C);
+  if (!MulC || !MulC->equalsInt(65535))
+    return false;
+  auto *AndBO = dyn_cast<BinaryOperator>(AndV);
+  if (!AndBO || AndBO->getOpcode() != Instruction::And)
+    return false;
+  Value *ShrV = AndBO->getOperand(0);
+  Value *MaskV = AndBO->getOperand(1);
+  if (isa<ConstantInt>(ShrV))
+    std::swap(ShrV, MaskV);
+  auto *MaskC = dyn_cast<ConstantInt>(MaskV);
+  if (!MaskC || !MaskC->equalsInt(65537))
+    return false;
+  auto *ShrBO = dyn_cast<BinaryOperator>(ShrV);
+  if (!ShrBO || ShrBO->getOpcode() != Instruction::LShr)
+    return false;
+  auto *ShC = dyn_cast<ConstantInt>(ShrBO->getOperand(1));
+  if (!ShC || !ShC->equalsInt(15))
+    return false;
+  Packed = ShrBO->getOperand(0);
+  return Packed && Packed->getType()->isIntegerTy(32);
+}
+
+static bool matchPackedI16Abs2(Value *V, Value *&Packed) {
+  auto *Xor = dyn_cast<BinaryOperator>(V);
+  if (!Xor || Xor->getOpcode() != Instruction::Xor)
+    return false;
+  for (unsigned Op = 0; Op < 2; ++Op) {
+    auto *Add = dyn_cast<BinaryOperator>(Xor->getOperand(Op));
+    Value *MulV = Xor->getOperand(1 - Op);
+    if (!Add || Add->getOpcode() != Instruction::Add)
+      continue;
+    Value *Src = nullptr;
+    if (!matchPackedI16Abs2Mul(MulV, Src))
+      continue;
+    if ((Add->getOperand(0) == Src && Add->getOperand(1) == MulV) ||
+        (Add->getOperand(1) == Src && Add->getOperand(0) == MulV)) {
+      Packed = Src;
+      return true;
+    }
+  }
+  return false;
+}
+
+static Value *emitPackedI16Abs2(IRBuilder<> &B, Value *Packed) {
+  Type *Ty = Packed->getType();
+  Value *Sh = ConstantInt::get(Ty, 15);
+  Value *Mask = ConstantInt::get(Ty, 65537);
+  Value *MulC = ConstantInt::get(Ty, 65535);
+  Value *Shr = B.CreateLShr(Packed, Sh, "loong.swar.shr");
+  Value *And = B.CreateAnd(Shr, Mask, "loong.swar.m");
+  Value *Mul = B.CreateMul(And, MulC, "loong.swar.s");
+  Value *Add = B.CreateAdd(Packed, Mul, "loong.swar.as");
+  return B.CreateXor(Add, Mul, "loong.swar.abs2");
+}
+
+static void flattenI32AddTree(Value *V, SmallVectorImpl<Value *> &Leaves,
+                              SmallPtrSetImpl<Value *> &Seen) {
+  if (!Seen.insert(V).second)
+    return;
+  Value *L = nullptr;
+  Value *R = nullptr;
+  if (V->getType()->isIntegerTy(32) && match(V, m_Add(m_Value(L), m_Value(R)))) {
+    flattenI32AddTree(L, Leaves, Seen);
+    flattenI32AddTree(R, Leaves, Seen);
+    return;
+  }
+  Leaves.push_back(V);
+}
+
+static bool valueDominatesInBB(Value *V, Instruction &I) {
+  auto *PI = dyn_cast<Instruction>(V);
+  if (!PI)
+    return true;
+  if (PI->getParent() != I.getParent())
+    return false;
+  return PI->comesBefore(&I);
+}
+
+/// Replace a root sum of packed-i16 abs2 values (used by `and 0xffff` /
+/// `lshr 16` horizontal add) with <N x i32> abs2 + integer add-reduce.
+/// Rewriting the sum itself (not only a fused hadd add) also catches the
+/// second SATD column, where lo/hi are added into an already-reduced total.
+static LLVM_ATTRIBUTE_UNUSED bool
+tryRewriteSWARAbs2Sum(Instruction &I, const LoongArchSubtarget &ST) {
+  if (!ST.hasExtLSX() || I.getOpcode() != Instruction::Add)
+    return false;
+  if (!I.getType()->isIntegerTy(32))
+    return false;
+
+  bool UsedAsPackedSum = false;
+  for (User *U : I.users()) {
+    auto *BO = dyn_cast<BinaryOperator>(U);
+    if (!BO)
+      continue;
+    if (BO->getOpcode() == Instruction::And) {
+      auto *C = dyn_cast<ConstantInt>(BO->getOperand(0) == &I ? BO->getOperand(1)
+                                                             : BO->getOperand(0));
+      if (C && C->equalsInt(65535))
+        UsedAsPackedSum = true;
+    } else if (BO->getOpcode() == Instruction::LShr && BO->getOperand(0) == &I) {
+      auto *C = dyn_cast<ConstantInt>(BO->getOperand(1));
+      if (C && C->equalsInt(16))
+        UsedAsPackedSum = true;
+    }
+  }
+  if (!UsedAsPackedSum)
+    return false;
+
+  SmallVector<Value *, 8> Leaves;
+  SmallPtrSet<Value *, 16> Seen;
+  flattenI32AddTree(&I, Leaves, Seen);
+  if (Leaves.size() != 4 && Leaves.size() != 8)
+    return false;
+
+  SmallVector<Value *, 8> Packed;
+  Packed.reserve(Leaves.size());
+  for (Value *Leaf : Leaves) {
+    Value *P = nullptr;
+    if (!matchPackedI16Abs2(Leaf, P))
+      return false;
+    if (!valueDominatesInBB(P, I))
+      return false;
+    Packed.push_back(P);
+  }
+
+  const unsigned N = Packed.size();
+  if (N == 8 && !ST.hasExtLASX())
+    return false;
+
+  IRBuilder<> B(&I);
+  auto *VTy = FixedVectorType::get(I.getType(), N);
+  Value *Vec = PoisonValue::get(VTy);
+  for (unsigned Idx = 0; Idx < N; ++Idx)
+    Vec = B.CreateInsertElement(Vec, Packed[Idx], B.getInt32(Idx),
+                                "loong.swar.ins");
+  Value *Abs2 = emitPackedI16Abs2(B, Vec);
+  Value *Red = B.CreateAddReduce(Abs2);
+  I.replaceAllUsesWith(Red);
+  I.eraseFromParent();
+  ++NumSWARAbs2;
+  return true;
+}
+
+static bool matchExtI8Load(Value *V, LoadInst *&Ld) {
+  Value *Src = nullptr;
+  if (!match(V, m_ZExt(m_Value(Src))) && !match(V, m_SExt(m_Value(Src))))
+    return false;
+  Ld = dyn_cast<LoadInst>(Src);
+  return Ld && Ld->getType()->isIntegerTy(8);
+}
+
+static bool matchI8ZExtDiff(Value *V, LoadInst *&La, LoadInst *&Lb,
+                            bool &IsSExt) {
+  Value *A = nullptr;
+  Value *B = nullptr;
+  if (!match(V, m_Sub(m_Value(A), m_Value(B))))
+    return false;
+  LoadInst *L1 = nullptr;
+  LoadInst *L2 = nullptr;
+  bool S1 = match(A, m_SExt(m_Value()));
+  bool S2 = match(B, m_SExt(m_Value()));
+  if (!matchExtI8Load(A, L1) || !matchExtI8Load(B, L2))
+    return false;
+  if (S1 != S2)
+    return false;
+  La = L1;
+  Lb = L2;
+  IsSExt = S1;
+  return true;
+}
+
+static bool matchI32Abs(Value *V, Value *&Src) {
+  if (auto *II = dyn_cast<IntrinsicInst>(V)) {
+    if (II->getIntrinsicID() == Intrinsic::abs &&
+        II->getType()->isIntegerTy(32)) {
+      Src = II->getArgOperand(0);
+      return true;
+    }
+  }
+  Value *X = nullptr;
+  Value *T = nullptr;
+  Value *F = nullptr;
+  if (match(V, m_Select(m_SpecificICmp(ICmpInst::ICMP_SLT, m_Value(X), m_Zero()),
+                        m_Value(T), m_Value(F)))) {
+    if (match(T, m_Neg(m_Specific(X))) && F == X) {
+      Src = X;
+      return true;
+    }
+  }
+  if (match(V, m_Select(m_SpecificICmp(ICmpInst::ICMP_SGT, m_Value(X), m_Zero()),
+                        m_Value(T), m_Value(F))) ||
+      match(V, m_Select(m_SpecificICmp(ICmpInst::ICMP_SGE, m_Value(X), m_Zero()),
+                        m_Value(T), m_Value(F)))) {
+    if (T == X && match(F, m_Neg(m_Specific(X)))) {
+      Src = X;
+      return true;
+    }
+  }
+  Value *A = nullptr;
+  Value *B = nullptr;
+  if (match(V, m_Intrinsic<Intrinsic::smax>(m_Value(A), m_Value(B)))) {
+    if (match(B, m_Neg(m_Specific(A)))) {
+      Src = A;
+      return true;
+    }
+    if (match(A, m_Neg(m_Specific(B)))) {
+      Src = B;
+      return true;
+    }
+  }
+  return false;
+}
+
+static bool splitConstByteGEP(Value *Ptr, Value *&Base, int64_t &Off) {
+  Ptr = Ptr->stripPointerCasts();
+  auto *G = dyn_cast<GetElementPtrInst>(Ptr);
+  if (!G || G->getNumIndices() != 1) {
+    Base = Ptr;
+    Off = 0;
+    return true;
+  }
+  auto *C = dyn_cast<ConstantInt>(G->getOperand(1));
+  if (!C) {
+    Base = Ptr;
+    Off = 0;
+    return true;
+  }
+  Base = G->getPointerOperand()->stripPointerCasts();
+  Off = C->getSExtValue();
+  return true;
+}
+
+static bool matchButterflyPack(Value *V, Value *&A, Value *&B) {
+  Value *Sum = nullptr;
+  Value *Shl = nullptr;
+  if (!match(V, m_c_Add(m_Value(Sum), m_Value(Shl))))
+    return false;
+  Value *Diff = nullptr;
+  ConstantInt *ShC = nullptr;
+  if (!match(Shl, m_Shl(m_Value(Diff), m_ConstantInt(ShC))) ||
+      !ShC->equalsInt(16)) {
+    if (!match(Sum, m_Shl(m_Value(Diff), m_ConstantInt(ShC))) ||
+        !ShC->equalsInt(16))
+      return false;
+    std::swap(Sum, Shl);
+  }
+  Value *X = nullptr;
+  Value *Y = nullptr;
+  if (!match(Sum, m_c_Add(m_Value(X), m_Value(Y))))
+    return false;
+  if (match(Diff, m_Sub(m_Specific(X), m_Specific(Y)))) {
+    A = X;
+    B = Y;
+    return true;
+  }
+  if (match(Diff, m_Sub(m_Specific(Y), m_Specific(X)))) {
+    A = Y;
+    B = X;
+    return true;
+  }
+  return false;
+}
+
+static bool matchSpatialPack(Value *V, Value *&Lo, Value *&Hi) {
+  ConstantInt *ShC = nullptr;
+  if (!match(V, m_c_Add(m_Value(Lo), m_Shl(m_Value(Hi), m_ConstantInt(ShC)))) ||
+      !ShC || !ShC->equalsInt(16))
+    return false;
+  return Lo->getType()->isIntegerTy(32) && Hi->getType()->isIntegerTy(32);
+}
+
+static bool matchI32Add(Value *V, Value *&A, Value *&B) {
+  return V && V->getType()->isIntegerTy(32) &&
+         match(V, m_Add(m_Value(A), m_Value(B)));
+}
+
+static bool matchI32Sub(Value *V, Value *&A, Value *&B) {
+  return V && V->getType()->isIntegerTy(32) &&
+         match(V, m_Sub(m_Value(A), m_Value(B)));
+}
+
+static bool sameOperandPair(Value *A, Value *B, Value *C, Value *D) {
+  return (A == C && B == D) || (A == D && B == C);
+}
+
+/// Recover s0..s3 from HADAMARD4(d0..d3, s0..s3) outputs (order of Ds free).
+static bool matchHadamard4(ArrayRef<Value *> Ds, Value *S[4]) {
+  if (Ds.size() != 4)
+    return false;
+  SmallVector<BinaryOperator *, 2> Adds, Subs;
+  for (Value *V : Ds) {
+    auto *BO = dyn_cast<BinaryOperator>(V);
+    if (!BO || !BO->getType()->isIntegerTy(32))
+      return false;
+    if (BO->getOpcode() == Instruction::Add)
+      Adds.push_back(BO);
+    else if (BO->getOpcode() == Instruction::Sub)
+      Subs.push_back(BO);
+    else
+      return false;
+  }
+  if (Adds.size() != 2 || Subs.size() != 2)
+    return false;
+
+  Value *Plus[2] = {};
+  Value *Minus[2] = {};
+  SmallPtrSet<BinaryOperator *, 2> UsedAdds;
+  for (unsigned I = 0; I < 2; ++I) {
+    Plus[I] = Subs[I]->getOperand(0);
+    Minus[I] = Subs[I]->getOperand(1);
+    bool Found = false;
+    for (BinaryOperator *Add : Adds) {
+      if (UsedAdds.contains(Add))
+        continue;
+      if (sameOperandPair(Add->getOperand(0), Add->getOperand(1), Plus[I],
+                          Minus[I])) {
+        UsedAdds.insert(Add);
+        Found = true;
+        break;
+      }
+    }
+    if (!Found)
+      return false;
+  }
+
+  auto isAdd = [](Value *V) {
+    auto *BO = dyn_cast<BinaryOperator>(V);
+    return BO && BO->getOpcode() == Instruction::Add;
+  };
+  auto isSub = [](Value *V) {
+    auto *BO = dyn_cast<BinaryOperator>(V);
+    return BO && BO->getOpcode() == Instruction::Sub;
+  };
+
+  Value *T0 = nullptr, *T1 = nullptr, *T2 = nullptr, *T3 = nullptr;
+  if (isAdd(Plus[0]) && isSub(Plus[1])) {
+    T0 = Plus[0];
+    T2 = Minus[0];
+    T1 = Plus[1];
+    T3 = Minus[1];
+  } else if (isAdd(Plus[1]) && isSub(Plus[0])) {
+    T0 = Plus[1];
+    T2 = Minus[1];
+    T1 = Plus[0];
+    T3 = Minus[0];
+  } else
+    return false;
+  if (!isAdd(T2) || !isSub(T3))
+    return false;
+
+  auto recoverPair = [](Value *Sum, Value *Dif, Value *&A, Value *&B) {
+    Value *X = nullptr, *Y = nullptr, *U = nullptr, *W = nullptr;
+    if (!matchI32Add(Sum, X, Y) || !matchI32Sub(Dif, U, W))
+      return false;
+    if (U == X && W == Y) {
+      A = X;
+      B = Y;
+      return true;
+    }
+    if (U == Y && W == X) {
+      A = Y;
+      B = X;
+      return true;
+    }
+    return false;
+  };
+  return recoverPair(T0, T1, S[0], S[1]) && recoverPair(T2, T3, S[2], S[3]);
+}
+
+static bool matchI8DiffRow4(ArrayRef<Value *> Diffs, Value *&BaseA,
+                            Value *&BaseB, bool &IsSExt) {
+  if (Diffs.size() != 4)
+    return false;
+  LoadInst *La[4] = {};
+  LoadInst *Lb[4] = {};
+  for (unsigned Idx = 0; Idx < 4; ++Idx) {
+    bool SExtI = false;
+    if (!matchI8ZExtDiff(Diffs[Idx], La[Idx], Lb[Idx], SExtI))
+      return false;
+    if (Idx == 0)
+      IsSExt = SExtI;
+    else if (IsSExt != SExtI)
+      return false;
+  }
+  int64_t OffA[4] = {};
+  int64_t OffB[4] = {};
+  BaseA = BaseB = nullptr;
+  for (unsigned Idx = 0; Idx < 4; ++Idx) {
+    Value *BA = nullptr;
+    Value *BB = nullptr;
+    if (!splitConstByteGEP(La[Idx]->getPointerOperand(), BA, OffA[Idx]) ||
+        !splitConstByteGEP(Lb[Idx]->getPointerOperand(), BB, OffB[Idx]))
+      return false;
+    if (Idx == 0) {
+      BaseA = BA;
+      BaseB = BB;
+    } else if (BA != BaseA || BB != BaseB)
+      return false;
+  }
+  bool SeenOff[4] = {};
+  for (unsigned Idx = 0; Idx < 4; ++Idx) {
+    if (OffA[Idx] < 0 || OffA[Idx] > 3 || OffA[Idx] != OffB[Idx] ||
+        SeenOff[OffA[Idx]])
+      return false;
+    SeenOff[OffA[Idx]] = true;
+  }
+  return SeenOff[0] && SeenOff[1] && SeenOff[2] && SeenOff[3];
+}
+
+static int64_t minDiffOff(Value *D0, Value *D1) {
+  LoadInst *La0 = nullptr, *Lb0 = nullptr, *La1 = nullptr, *Lb1 = nullptr;
+  bool Dummy = false;
+  if (!matchI8ZExtDiff(D0, La0, Lb0, Dummy) ||
+      !matchI8ZExtDiff(D1, La1, Lb1, Dummy))
+    return -1;
+  Value *BA = nullptr, *BB = nullptr;
+  int64_t O0 = 0, O1 = 0, DummyB = 0;
+  if (!splitConstByteGEP(La0->getPointerOperand(), BA, O0) ||
+      !splitConstByteGEP(La1->getPointerOperand(), BB, O1))
+    return -1;
+  (void)DummyB;
+  return std::min(O0, O1);
+}
+
+struct SWARButterflyRow {
+  Value *Tmp0 = nullptr;
+  Value *Tmp1 = nullptr;
+  Value *BaseA = nullptr;
+  Value *BaseB = nullptr;
+  bool IsSExt = false;
+};
+
+static bool matchButterflyRowFromTmp(Value *Tmp, SWARButterflyRow &Row,
+                                     bool &IsTmp0) {
+  Value *B0 = nullptr, *B1 = nullptr;
+  bool TmpIsAdd = matchI32Add(Tmp, B0, B1);
+  bool TmpIsSub = !TmpIsAdd && matchI32Sub(Tmp, B0, B1);
+  if (!TmpIsAdd && !TmpIsSub)
+    return false;
+  Value *D0 = nullptr, *D1 = nullptr, *D2 = nullptr, *D3 = nullptr;
+  if (!matchButterflyPack(B0, D0, D1) || !matchButterflyPack(B1, D2, D3))
+    return false;
+  Value *Diffs[] = {D0, D1, D2, D3};
+  if (!matchI8DiffRow4(Diffs, Row.BaseA, Row.BaseB, Row.IsSExt))
+    return false;
+  if (!(minDiffOff(D0, D1) == 0 && minDiffOff(D2, D3) == 2) &&
+      !(minDiffOff(D0, D1) == 2 && minDiffOff(D2, D3) == 0))
+    return false;
+  const bool B0IsLow = minDiffOff(D0, D1) == 0;
+  Value *Low = B0IsLow ? B0 : B1;
+  Value *High = B0IsLow ? B1 : B0;
+  Instruction *Tmp0I = nullptr;
+  Instruction *Tmp1I = nullptr;
+  for (User *U : Low->users()) {
+    auto *BO = dyn_cast<BinaryOperator>(U);
+    if (!BO)
+      continue;
+    if (BO->getOpcode() == Instruction::Add &&
+        sameOperandPair(BO->getOperand(0), BO->getOperand(1), Low, High))
+      Tmp0I = BO;
+    else if (BO->getOpcode() == Instruction::Sub && BO->getOperand(0) == Low &&
+             BO->getOperand(1) == High)
+      Tmp1I = BO;
+  }
+  if (!Tmp0I || !Tmp1I)
+    return false;
+  Row.Tmp0 = Tmp0I;
+  Row.Tmp1 = Tmp1I;
+  IsTmp0 = Tmp == Row.Tmp0;
+  return Tmp == Row.Tmp0 || Tmp == Row.Tmp1;
+}
+
+static Value *emitI8RowDiffV4(IRBuilder<> &B, Value *BaseA, Value *BaseB,
+                              bool IsSExt, Type *I32Ty, unsigned ExtraOff) {
+  auto *I8Ty = Type::getInt8Ty(B.getContext());
+  auto *V4I8 = FixedVectorType::get(I8Ty, 4);
+  auto *V4I32 = FixedVectorType::get(I32Ty, 4);
+  Value *PA = BaseA;
+  Value *PB = BaseB;
+  if (ExtraOff) {
+    PA = B.CreateInBoundsGEP(I8Ty, BaseA, B.getInt64(ExtraOff));
+    PB = B.CreateInBoundsGEP(I8Ty, BaseB, B.getInt64(ExtraOff));
+  }
+  Value *VA = B.CreateAlignedLoad(V4I8, PA, Align(1), "loong.satd.a");
+  Value *VB = B.CreateAlignedLoad(V4I8, PB, Align(1), "loong.satd.b");
+  Value *ZA =
+      IsSExt ? B.CreateSExt(VA, V4I32, "loong.satd.za")
+             : B.CreateZExt(VA, V4I32, "loong.satd.za");
+  Value *ZB =
+      IsSExt ? B.CreateSExt(VB, V4I32, "loong.satd.zb")
+             : B.CreateZExt(VB, V4I32, "loong.satd.zb");
+  return B.CreateSub(ZA, ZB, "loong.satd.d");
+}
+
+static Value *emitHadamard4Vec(IRBuilder<> &B, Value *S) {
+  // LSX/LASX-legal: vpickev/vpickod, vilvl.w, vshuf4i.w, vilvl.d.
+  // v8i32 uses the same 4-lane pattern in each 128-bit half (LASX).
+  auto *VTy = cast<FixedVectorType>(S->getType());
+  const unsigned N = VTy->getNumElements();
+  SmallVector<int, 8> EvenM, OddM, TM, TaM, TbM, DM;
+  if (N == 4) {
+    EvenM.assign({0, 2, 0, 2});
+    OddM.assign({1, 3, 1, 3});
+    TM.assign({0, 4, 1, 5});
+    TaM.assign({0, 1, 0, 1});
+    TbM.assign({2, 3, 2, 3});
+    DM.assign({0, 1, 4, 5});
+  } else if (N == 8) {
+    EvenM.assign({0, 2, 0, 2, 4, 6, 4, 6});
+    OddM.assign({1, 3, 1, 3, 5, 7, 5, 7});
+    TM.assign({0, 8, 1, 9, 4, 12, 5, 13});
+    TaM.assign({0, 1, 0, 1, 4, 5, 4, 5});
+    TbM.assign({2, 3, 2, 3, 6, 7, 6, 7});
+    DM.assign({0, 1, 8, 9, 4, 5, 12, 13});
+  } else {
+    llvm_unreachable("unexpected Hadamard width");
+  }
+  Value *Even = B.CreateShuffleVector(S, EvenM, "loong.satd.evh");
+  Value *Odd = B.CreateShuffleVector(S, OddM, "loong.satd.odh");
+  Value *Add = B.CreateAdd(Even, Odd, "loong.satd.tadd");
+  Value *Sub = B.CreateSub(Even, Odd, "loong.satd.tsub");
+  Value *T = B.CreateShuffleVector(Add, Sub, TM, "loong.satd.t");
+  Value *Ta = B.CreateShuffleVector(T, TaM, "loong.satd.ta");
+  Value *Tb = B.CreateShuffleVector(T, TbM, "loong.satd.tb");
+  Value *Add2 = B.CreateAdd(Ta, Tb, "loong.satd.dadd");
+  Value *Sub2 = B.CreateSub(Ta, Tb, "loong.satd.dsub");
+  return B.CreateShuffleVector(Add2, Sub2, DM, "loong.satd.h");
+}
+
+static Value *concatV4I32(IRBuilder<> &B, Value *Lo, Value *Hi) {
+  const int M[] = {0, 1, 2, 3, 4, 5, 6, 7};
+  return B.CreateShuffleVector(Lo, Hi, M, "loong.satd.cat8");
+}
+
+static void splitV8I32(IRBuilder<> &B, Value *V8, Value *&Lo, Value *&Hi) {
+  const int LoM[] = {0, 1, 2, 3};
+  const int HiM[] = {4, 5, 6, 7};
+  Lo = B.CreateShuffleVector(V8, LoM, "loong.satd.lo4");
+  Hi = B.CreateShuffleVector(V8, HiM, "loong.satd.hi4");
+}
+
+static void emitHadamard4Pair(IRBuilder<> &B, Value *VA, Value *VB, Value *&HA,
+                              Value *&HB, bool UseLASX) {
+  if (UseLASX) {
+    Value *Cat = concatV4I32(B, VA, VB);
+    Value *H = emitHadamard4Vec(B, Cat);
+    splitV8I32(B, H, HA, HB);
+    return;
+  }
+  HA = emitHadamard4Vec(B, VA);
+  HB = emitHadamard4Vec(B, VB);
+}
+
+static Value *emitAdjacentPackV4(IRBuilder<> &B, Value *V4) {
+  const int EvenM[] = {0, 2, 0, 2};
+  const int OddM[] = {1, 3, 1, 3};
+  Value *Even = B.CreateShuffleVector(V4, EvenM, "loong.satd.ev");
+  Value *Odd = B.CreateShuffleVector(V4, OddM, "loong.satd.od");
+  Value *Sum = B.CreateAdd(Even, Odd, "loong.satd.ps");
+  Value *Dif = B.CreateSub(Even, Odd, "loong.satd.pd");
+  Value *Sh =
+      B.CreateShl(Dif, ConstantInt::get(Dif->getType(), 16), "loong.satd.psh");
+  return B.CreateAdd(Sum, Sh, "loong.satd.pk");
+}
+
+static void emitHadamard4Vert(IRBuilder<> &B, Value *S0, Value *S1, Value *S2,
+                              Value *S3, Value *&D0, Value *&D1, Value *&D2,
+                              Value *&D3) {
+  Value *T0 = B.CreateAdd(S0, S1, "loong.satd.vt0");
+  Value *T1 = B.CreateSub(S0, S1, "loong.satd.vt1");
+  Value *T2 = B.CreateAdd(S2, S3, "loong.satd.vt2");
+  Value *T3 = B.CreateSub(S2, S3, "loong.satd.vt3");
+  D0 = B.CreateAdd(T0, T2, "loong.satd.vd0");
+  D1 = B.CreateAdd(T1, T3, "loong.satd.vd1");
+  D2 = B.CreateSub(T0, T2, "loong.satd.vd2");
+  D3 = B.CreateSub(T1, T3, "loong.satd.vd3");
+}
+
+static Value *emitPackedHAddI32(IRBuilder<> &B, Value *PS);
+
+static Value *emitAbs2ReduceN(IRBuilder<> &B, ArrayRef<Value *> Ds) {
+  Value *PS = nullptr;
+  for (Value *D : Ds) {
+    Value *Abs = emitPackedI16Abs2(B, D);
+    Value *Red = B.CreateAddReduce(Abs);
+    PS = PS ? B.CreateAdd(PS, Red, "loong.satd.ps") : Red;
+  }
+  return PS;
+}
+
+static Value *emitRowPack8(IRBuilder<> &B, Value *BaseA, Value *BaseB,
+                           bool IsSExt, Type *I32Ty) {
+  Value *Lo = emitI8RowDiffV4(B, BaseA, BaseB, IsSExt, I32Ty, 0);
+  Value *Hi = emitI8RowDiffV4(B, BaseA, BaseB, IsSExt, I32Ty, 4);
+  Value *PLo = emitAdjacentPackV4(B, Lo);
+  Value *PHi = emitAdjacentPackV4(B, Hi);
+  const int CatM[] = {0, 1, 4, 5};
+  return B.CreateShuffleVector(PLo, PHi, CatM, "loong.sa8d.pk");
+}
+
+static Value *emitSA8D8x8(IRBuilder<> &B, Value *Pix1, Value *Pix2,
+                          Value *Stride1, Value *Stride2, bool IsSExt,
+                          Type *I32Ty, bool UseLASX) {
+  auto *I8Ty = Type::getInt8Ty(B.getContext());
+  Value *Hrow[8];
+  Value *Pack[8];
+  Value *PA = Pix1;
+  Value *PB = Pix2;
+  for (unsigned R = 0; R < 8; ++R) {
+    Pack[R] = emitRowPack8(B, PA, PB, IsSExt, I32Ty);
+    if (R != 7) {
+      PA = B.CreateInBoundsGEP(I8Ty, PA, Stride1, "loong.sa8d.a");
+      PB = B.CreateInBoundsGEP(I8Ty, PB, Stride2, "loong.sa8d.b");
+    }
+  }
+  for (unsigned R = 0; R < 8; R += 2)
+    emitHadamard4Pair(B, Pack[R], Pack[R + 1], Hrow[R], Hrow[R + 1], UseLASX);
+  Value *A0, *A1, *A2, *A3, *A4, *A5, *A6, *A7;
+  emitHadamard4Vert(B, Hrow[0], Hrow[1], Hrow[2], Hrow[3], A0, A1, A2, A3);
+  emitHadamard4Vert(B, Hrow[4], Hrow[5], Hrow[6], Hrow[7], A4, A5, A6, A7);
+  Value *Pairs[] = {
+      B.CreateAdd(A0, A4, "loong.sa8d.p0"), B.CreateSub(A0, A4, "loong.sa8d.m0"),
+      B.CreateAdd(A1, A5, "loong.sa8d.p1"), B.CreateSub(A1, A5, "loong.sa8d.m1"),
+      B.CreateAdd(A2, A6, "loong.sa8d.p2"), B.CreateSub(A2, A6, "loong.sa8d.m2"),
+      B.CreateAdd(A3, A7, "loong.sa8d.p3"), B.CreateSub(A3, A7, "loong.sa8d.m3")};
+  return emitPackedHAddI32(B, emitAbs2ReduceN(B, Pairs));
+}
+
+static Value *emitI8RowZExtV4(IRBuilder<> &B, Value *Base, Type *I32Ty,
+                              unsigned ExtraOff) {
+  auto *I8Ty = Type::getInt8Ty(B.getContext());
+  auto *V4I8 = FixedVectorType::get(I8Ty, 4);
+  auto *V4I32 = FixedVectorType::get(I32Ty, 4);
+  Value *P = Base;
+  if (ExtraOff)
+    P = B.CreateInBoundsGEP(I8Ty, Base, B.getInt64(ExtraOff));
+  Value *V = B.CreateAlignedLoad(V4I8, P, Align(1), "loong.hac.a");
+  return B.CreateZExt(V, V4I32, "loong.hac.z");
+}
+
+static void emitFourRowPairCols(IRBuilder<> &B, Value *RowBase[4], Type *I32Ty,
+                                Value *&T0, Value *&T4, Value *&T8,
+                                Value *&T12) {
+  Value *PackLo[4];
+  Value *PackHi[4];
+  for (unsigned R = 0; R < 4; ++R) {
+    PackLo[R] = emitAdjacentPackV4(B, emitI8RowZExtV4(B, RowBase[R], I32Ty, 0));
+    PackHi[R] = emitAdjacentPackV4(B, emitI8RowZExtV4(B, RowBase[R], I32Ty, 4));
+  }
+  const int VilvlM[] = {0, 4, 1, 5};
+  const int LoM[] = {0, 1, 4, 5};
+  const int HiM[] = {2, 3, 6, 7};
+  auto pairAcross = [&](Value *P0, Value *P1, Value *P2, Value *P3, Value *&Sum,
+                        Value *&Dif) {
+    Value *A = B.CreateShuffleVector(P0, P1, VilvlM, "loong.hac.il");
+    Value *C = B.CreateShuffleVector(P2, P3, VilvlM, "loong.hac.ih");
+    Value *Xs = B.CreateShuffleVector(A, C, LoM, "loong.hac.x");
+    Value *Ys = B.CreateShuffleVector(A, C, HiM, "loong.hac.y");
+    Sum = B.CreateAdd(Xs, Ys, "loong.hac.s");
+    Dif = B.CreateSub(Xs, Ys, "loong.hac.d");
+  };
+  pairAcross(PackLo[0], PackLo[1], PackLo[2], PackLo[3], T0, T4);
+  pairAcross(PackHi[0], PackHi[1], PackHi[2], PackHi[3], T8, T12);
+}
+
+static Value *emitHadamardAC(IRBuilder<> &B, Value *Pix, Value *Stride,
+                             Type *I32Ty, bool UseLASX) {
+  auto *I8Ty = Type::getInt8Ty(B.getContext());
+  Value *Row[8];
+  Row[0] = Pix;
+  for (unsigned R = 1; R < 8; ++R)
+    Row[R] = B.CreateInBoundsGEP(I8Ty, Row[R - 1], Stride, "loong.hac.r");
+  Value *T0, *T4, *T8, *T12, *B0, *B4, *B8, *B12;
+  emitFourRowPairCols(B, Row, I32Ty, T0, T4, T8, T12);
+  emitFourRowPairCols(B, Row + 4, I32Ty, B0, B4, B8, B12);
+  Value *H0, *H1, *H2, *H3, *H4, *H5, *H6, *H7;
+  emitHadamard4Pair(B, T0, T4, H0, H1, UseLASX);
+  emitHadamard4Pair(B, T8, T12, H2, H3, UseLASX);
+  emitHadamard4Pair(B, B0, B4, H4, H5, UseLASX);
+  emitHadamard4Pair(B, B8, B12, H6, H7, UseLASX);
+  Value *Sum4Src[] = {H0, H1, H2, H3, H4, H5, H6, H7};
+  Value *Sum4 = emitPackedHAddI32(B, emitAbs2ReduceN(B, Sum4Src));
+  Value *S0, *S1, *S2, *S3, *S4, *S5, *S6, *S7;
+  emitHadamard4Vert(B, H0, H2, H4, H6, S0, S1, S2, S3);
+  emitHadamard4Vert(B, H1, H3, H5, H7, S4, S5, S6, S7);
+  Value *Sum8Src[] = {S0, S1, S2, S3, S4, S5, S6, S7};
+  Value *Sum8 = emitPackedHAddI32(B, emitAbs2ReduceN(B, Sum8Src));
+  Value *DCVec = B.CreateAdd(H0, H2, "loong.hac.dc0");
+  DCVec = B.CreateAdd(DCVec, H4, "loong.hac.dc1");
+  DCVec = B.CreateAdd(DCVec, H6, "loong.hac.dc2");
+  Value *DC = B.CreateExtractElement(DCVec, B.getInt32(0), "loong.hac.dc");
+  DC = B.CreateAnd(DC, ConstantInt::get(I32Ty, 65535), "loong.hac.dclo");
+  Value *AC4 = B.CreateSub(Sum4, DC, "loong.hac.ac4");
+  Value *AC8 = B.CreateSub(Sum8, DC, "loong.hac.ac8");
+  Type *I64Ty = B.getInt64Ty();
+  Value *Hi = B.CreateShl(B.CreateZExt(AC8, I64Ty), 32, "loong.hac.hi");
+  Value *Lo = B.CreateZExt(AC4, I64Ty, "loong.hac.lo");
+  return B.CreateOr(Hi, Lo, "loong.hac.out");
+}
+
+static Value *emitPackedHAddI32(IRBuilder<> &B, Value *PS) {
+  Type *Ty = PS->getType();
+  Value *Lo = B.CreateAnd(PS, ConstantInt::get(Ty, 65535), "loong.satd.lo");
+  Value *Hi = B.CreateLShr(PS, ConstantInt::get(Ty, 16), "loong.satd.hi");
+  return B.CreateAdd(Lo, Hi, "loong.satd.hadd");
+}
+
+static Value *emitFourRowButterflyTmp(IRBuilder<> &B, Value *BaseA[4],
+                                      Value *BaseB[4], bool IsSExt,
+                                      Type *I32Ty, bool WantTmp0) {
+  Value *Pack[4];
+  for (unsigned R = 0; R < 4; ++R) {
+    Value *Diff = emitI8RowDiffV4(B, BaseA[R], BaseB[R], IsSExt, I32Ty, 0);
+    Pack[R] = emitAdjacentPackV4(B, Diff);
+  }
+  const int VilvlM[] = {0, 4, 1, 5};
+  const int LoM[] = {0, 1, 4, 5};
+  const int HiM[] = {2, 3, 6, 7};
+  Value *A = B.CreateShuffleVector(Pack[0], Pack[1], VilvlM, "loong.satd.i01");
+  Value *C = B.CreateShuffleVector(Pack[2], Pack[3], VilvlM, "loong.satd.i23");
+  Value *B0s = B.CreateShuffleVector(A, C, LoM, "loong.satd.b0");
+  Value *B1s = B.CreateShuffleVector(A, C, HiM, "loong.satd.b1");
+  return WantTmp0 ? B.CreateAdd(B0s, B1s, "loong.satd.tmp")
+                  : B.CreateSub(B0s, B1s, "loong.satd.tmp");
+}
+
+static bool collectAbs2PackedSrcs(Value *PS, SmallVectorImpl<Value *> &Srcs,
+                                  unsigned ExpectN) {
+  SmallVector<Value *, 16> Leaves;
+  SmallPtrSet<Value *, 32> Seen;
+  flattenI32AddTree(PS, Leaves, Seen);
+  if (Leaves.size() != ExpectN)
+    return false;
+  Srcs.clear();
+  for (Value *Leaf : Leaves) {
+    Value *P = nullptr;
+    if (!matchPackedI16Abs2(Leaf, P))
+      return false;
+    Srcs.push_back(P);
+  }
+  return true;
+}
+
+static bool collectSATDPackedSrcGroups(
+    Value *Sum, SmallVectorImpl<SmallVector<Value *, 16>> &Groups) {
+  SmallVector<Value *, 8> Leaves;
+  SmallPtrSet<Value *, 16> Seen;
+  flattenI32AddTree(Sum, Leaves, Seen);
+  SmallVector<Value *, 4> PackedSums;
+  SmallPtrSet<Value *, 8> HaveAnd, HaveShr;
+  for (Value *Leaf : Leaves) {
+    auto *BO = dyn_cast<BinaryOperator>(Leaf);
+    if (!BO)
+      return false;
+    if (BO->getOpcode() == Instruction::And) {
+      Value *X = BO->getOperand(0);
+      Value *C = BO->getOperand(1);
+      if (isa<ConstantInt>(X))
+        std::swap(X, C);
+      auto *CI = dyn_cast<ConstantInt>(C);
+      if (!CI || !CI->equalsInt(65535))
+        return false;
+      HaveAnd.insert(X);
+      if (!llvm::is_contained(PackedSums, X))
+        PackedSums.push_back(X);
+    } else if (BO->getOpcode() == Instruction::LShr &&
+               BO->getOperand(0)->getType()->isIntegerTy(32)) {
+      auto *CI = dyn_cast<ConstantInt>(BO->getOperand(1));
+      if (!CI || !CI->equalsInt(16))
+        return false;
+      Value *X = BO->getOperand(0);
+      HaveShr.insert(X);
+      if (!llvm::is_contained(PackedSums, X))
+        PackedSums.push_back(X);
+    } else
+      return false;
+  }
+  if (PackedSums.empty())
+    return false;
+  Groups.clear();
+  for (Value *PS : PackedSums) {
+    if (!HaveAnd.contains(PS) || !HaveShr.contains(PS))
+      return false;
+    SmallVector<Value *, 16> Srcs;
+    if (!collectAbs2PackedSrcs(PS, Srcs, 4) &&
+        !collectAbs2PackedSrcs(PS, Srcs, 16) &&
+        !collectAbs2PackedSrcs(PS, Srcs, 8))
+      return false;
+    Groups.push_back(std::move(Srcs));
+  }
+  return true;
+}
+
+static bool partitionHadamardGroups(ArrayRef<Value *> Ds,
+                                    SmallVectorImpl<std::array<Value *, 4>> &SCols) {
+  SmallVector<std::pair<BinaryOperator *, BinaryOperator *>, 8> Pairs;
+  for (Value *V : Ds) {
+    auto *Sub = dyn_cast<BinaryOperator>(V);
+    if (!Sub || Sub->getOpcode() != Instruction::Sub)
+      continue;
+    for (Value *U : Ds) {
+      auto *Add = dyn_cast<BinaryOperator>(U);
+      if (!Add || Add->getOpcode() != Instruction::Add)
+        continue;
+      if (sameOperandPair(Add->getOperand(0), Add->getOperand(1),
+                          Sub->getOperand(0), Sub->getOperand(1))) {
+        Pairs.emplace_back(Add, Sub);
+        break;
+      }
+    }
+  }
+  SmallVector<char, 8> Used(Pairs.size(), 0);
+  SCols.clear();
+  for (unsigned I = 0; I < Pairs.size(); ++I) {
+    if (Used[I])
+      continue;
+    bool Found = false;
+    for (unsigned J = I + 1; J < Pairs.size(); ++J) {
+      if (Used[J])
+        continue;
+      Value *Four[] = {Pairs[I].first, Pairs[I].second, Pairs[J].first,
+                       Pairs[J].second};
+      Value *S[4] = {};
+      if (!matchHadamard4(Four, S))
+        continue;
+      std::array<Value *, 4> Col = {S[0], S[1], S[2], S[3]};
+      SCols.push_back(Col);
+      Used[I] = Used[J] = 1;
+      Found = true;
+      break;
+    }
+    if (!Found)
+      return false;
+  }
+  unsigned Covered = 0;
+  for (char U : Used)
+    Covered += U;
+  return Covered == Pairs.size() && !SCols.empty();
+}
+
+static void flattenAddSubUntilPack(Value *V, SmallVectorImpl<Value *> &Leaves,
+                                   SmallPtrSetImpl<Value *> &Seen) {
+  if (!Seen.insert(V).second)
+    return;
+  Value *A = nullptr, *B = nullptr;
+  if (matchSpatialPack(V, A, B) || matchButterflyPack(V, A, B)) {
+    Leaves.push_back(V);
+    return;
+  }
+  Value *L = nullptr, *R = nullptr;
+  if (matchI32Add(V, L, R) || matchI32Sub(V, L, R)) {
+    flattenAddSubUntilPack(L, Leaves, Seen);
+    flattenAddSubUntilPack(R, Leaves, Seen);
+    return;
+  }
+  Leaves.push_back(V);
+}
+
+static bool matchSpatialRow8(ArrayRef<Value *> Packs, Value *&BaseA,
+                             Value *&BaseB, bool &IsSExt) {
+  if (Packs.size() != 4)
+    return false;
+  bool Seen[4] = {};
+  BaseA = BaseB = nullptr;
+  for (Value *P : Packs) {
+    Value *Lo = nullptr, *Hi = nullptr;
+    if (!matchSpatialPack(P, Lo, Hi))
+      return false;
+    LoadInst *La = nullptr, *Lb = nullptr, *LaH = nullptr, *LbH = nullptr;
+    bool SLo = false, SHi = false;
+    if (!matchI8ZExtDiff(Lo, La, Lb, SLo) ||
+        !matchI8ZExtDiff(Hi, LaH, LbH, SHi) || SLo != SHi)
+      return false;
+    Value *BA = nullptr, *BB = nullptr, *BAH = nullptr, *BBH = nullptr;
+    int64_t OA = 0, OB = 0, OAH = 0, OBH = 0;
+    if (!splitConstByteGEP(La->getPointerOperand(), BA, OA) ||
+        !splitConstByteGEP(Lb->getPointerOperand(), BB, OB) ||
+        !splitConstByteGEP(LaH->getPointerOperand(), BAH, OAH) ||
+        !splitConstByteGEP(LbH->getPointerOperand(), BBH, OBH))
+      return false;
+    if (BA != BAH || BB != BBH || OA != OB || OAH != OBH || OAH != OA + 4)
+      return false;
+    if (OA < 0 || OA > 3 || Seen[OA])
+      return false;
+    Seen[OA] = true;
+    if (!BaseA) {
+      BaseA = BA;
+      BaseB = BB;
+      IsSExt = SLo;
+    } else if (BA != BaseA || BB != BaseB || SLo != IsSExt)
+      return false;
+  }
+  return Seen[0] && Seen[1] && Seen[2] && Seen[3];
+}
+
+static Value *emitSATD4x4(IRBuilder<> &B, Value *BaseA[4], Value *BaseB[4],
+                          bool IsSExt, Type *I32Ty, bool UseLASX) {
+  Value *Tmp0 = emitFourRowButterflyTmp(B, BaseA, BaseB, IsSExt, I32Ty, true);
+  Value *Tmp1 = emitFourRowButterflyTmp(B, BaseA, BaseB, IsSExt, I32Ty, false);
+  Value *D0 = nullptr, *D1 = nullptr;
+  emitHadamard4Pair(B, Tmp0, Tmp1, D0, D1, UseLASX);
+  Value *A0 = emitPackedI16Abs2(B, D0);
+  Value *A1 = emitPackedI16Abs2(B, D1);
+  Value *H0 = emitPackedHAddI32(B, B.CreateAddReduce(A0));
+  Value *H1 = emitPackedHAddI32(B, B.CreateAddReduce(A1));
+  Value *Sum = B.CreateAdd(H0, H1, "loong.satd.sum");
+  return B.CreateLShr(Sum, ConstantInt::get(I32Ty, 1), "loong.satd.out");
+}
+
+static Value *emitSATD8x4(IRBuilder<> &B, Value *BaseA[4], Value *BaseB[4],
+                          bool IsSExt, Type *I32Ty, bool UseLASX) {
+  Value *Pack[4];
+  for (unsigned R = 0; R < 4; ++R) {
+    Value *Lo = emitI8RowDiffV4(B, BaseA[R], BaseB[R], IsSExt, I32Ty, 0);
+    Value *Hi = emitI8RowDiffV4(B, BaseA[R], BaseB[R], IsSExt, I32Ty, 4);
+    Pack[R] = B.CreateAdd(
+        Lo, B.CreateShl(Hi, ConstantInt::get(Hi->getType(), 16)),
+        "loong.satd.spk");
+  }
+  Value *Hrow[4];
+  emitHadamard4Pair(B, Pack[0], Pack[1], Hrow[0], Hrow[1], UseLASX);
+  emitHadamard4Pair(B, Pack[2], Pack[3], Hrow[2], Hrow[3], UseLASX);
+  Value *D0, *D1, *D2, *D3;
+  emitHadamard4Vert(B, Hrow[0], Hrow[1], Hrow[2], Hrow[3], D0, D1, D2, D3);
+  Value *Hadd = emitPackedHAddI32(B, emitAbs2ReduceN(B, {D0, D1, D2, D3}));
+  return B.CreateLShr(Hadd, ConstantInt::get(I32Ty, 1), "loong.satd.out8");
+}
+
+static bool isStrideStepGEP(Value *V, Value *Ptr, Value *Stride) {
+  auto *G = dyn_cast<GetElementPtrInst>(V);
+  return G && G->getNumIndices() == 1 && G->getOperand(1) == Stride &&
+         G->getPointerOperand() == Ptr;
+}
+
+static bool matchPtrRowCol(Value *Ptr, Value *Root, Value *Stride, unsigned &Row,
+                           int64_t &Col) {
+  Value *Base = nullptr;
+  int64_t Off = 0;
+  if (!splitConstByteGEP(Ptr, Base, Off) || Off < 0 || Off > 7)
+    return false;
+  Col = Off;
+  Row = 0;
+  Value *Cur = Base;
+  SmallPtrSet<Value *, 8> Guard;
+  while (Cur != Root) {
+    if (!Guard.insert(Cur).second)
+      return false;
+    auto *G = dyn_cast<GetElementPtrInst>(Cur);
+    if (!G || !isStrideStepGEP(G, G->getPointerOperand(), Stride))
+      return false;
+    Cur = G->getPointerOperand()->stripPointerCasts();
+    ++Row;
+    if (Row > 7)
+      return false;
+  }
+  return true;
+}
+
+static unsigned countPackedAbs2In(BasicBlock &BB) {
+  unsigned N = 0;
+  for (Instruction &I : BB) {
+    Value *P = nullptr;
+    if (matchPackedI16Abs2(&I, P))
+      ++N;
+  }
+  return N;
+}
+
+static unsigned countPackedAbs2InFunc(Function &F) {
+  unsigned N = 0;
+  for (Instruction &I : instructions(F)) {
+    Value *P = nullptr;
+    if (matchPackedI16Abs2(&I, P))
+      ++N;
+  }
+  return N;
+}
+
+static bool matchSA8DRowLoop(BasicBlock &LoopBB, BasicBlock *&Pre,
+                             BasicBlock *&Exit, Value *&Pix1, Value *&Pix2,
+                             Value *&Stride1, Value *&Stride2, bool &IsSExt) {
+  auto *Br = dyn_cast<BranchInst>(LoopBB.getTerminator());
+  if (!Br || !Br->isConditional())
+    return false;
+  auto *Cmp = dyn_cast<ICmpInst>(Br->getCondition());
+  if (!Cmp || Cmp->getPredicate() != ICmpInst::ICMP_EQ)
+    return false;
+  Value *IVNext = Cmp->getOperand(0);
+  auto *C8 = dyn_cast<ConstantInt>(Cmp->getOperand(1));
+  if (!C8) {
+    C8 = dyn_cast<ConstantInt>(Cmp->getOperand(0));
+    IVNext = Cmp->getOperand(1);
+  }
+  if (!C8 || !C8->equalsInt(8))
+    return false;
+  Value *IV = nullptr;
+  if (!match(IVNext, m_Add(m_Value(IV), m_One())) &&
+      !match(IVNext, m_Add(m_One(), m_Value(IV))))
+    return false;
+  auto *IVPhi = dyn_cast<PHINode>(IV);
+  if (!IVPhi || IVPhi->getParent() != &LoopBB || IVPhi->getNumIncomingValues() != 2)
+    return false;
+
+  Pre = nullptr;
+  for (unsigned I = 0; I < IVPhi->getNumIncomingValues(); ++I) {
+    BasicBlock *IB = IVPhi->getIncomingBlock(I);
+    if (IB == &LoopBB)
+      continue;
+    auto *Start = dyn_cast<ConstantInt>(IVPhi->getIncomingValue(I));
+    if (!Start || !Start->isZero())
+      return false;
+    Pre = IB;
+  }
+  if (!Pre)
+    return false;
+  Exit = Br->getSuccessor(0) == &LoopBB ? Br->getSuccessor(1) : Br->getSuccessor(0);
+  if (!Exit || Exit == &LoopBB)
+    return false;
+
+  PHINode *PA = nullptr;
+  PHINode *PB = nullptr;
+  for (PHINode &PN : LoopBB.phis()) {
+    if (&PN == IVPhi)
+      continue;
+    if (!PN.getType()->isPointerTy() || PN.getNumIncomingValues() != 2)
+      return false;
+    if (!PA)
+      PA = &PN;
+    else if (!PB)
+      PB = &PN;
+    else
+      return false;
+  }
+  if (!PA || !PB)
+    return false;
+
+  Pix1 = PA->getIncomingValueForBlock(Pre);
+  Pix2 = PB->getIncomingValueForBlock(Pre);
+  Value *NextA = PA->getIncomingValueForBlock(&LoopBB);
+  Value *NextB = PB->getIncomingValueForBlock(&LoopBB);
+  auto *GA = dyn_cast<GetElementPtrInst>(NextA);
+  auto *GB = dyn_cast<GetElementPtrInst>(NextB);
+  if (!GA || !GB || GA->getNumIndices() != 1 || GB->getNumIndices() != 1)
+    return false;
+  if (GA->getPointerOperand() != PA || GB->getPointerOperand() != PB)
+    return false;
+  Stride1 = GA->getOperand(1);
+  Stride2 = GB->getOperand(1);
+  if (!Stride1->getType()->isIntegerTy() || !Stride2->getType()->isIntegerTy())
+    return false;
+
+  Value *Packs[4] = {};
+  unsigned NPack = 0;
+  int64_t PairOff[4] = {};
+  IsSExt = false;
+  bool SawSExt = false;
+  for (Instruction &I : LoopBB) {
+    Value *D0 = nullptr, *D1 = nullptr;
+    if (!matchButterflyPack(&I, D0, D1))
+      continue;
+    LoadInst *La0 = nullptr, *Lb0 = nullptr, *La1 = nullptr, *Lb1 = nullptr;
+    bool S0 = false, S1 = false;
+    if (!matchI8ZExtDiff(D0, La0, Lb0, S0) || !matchI8ZExtDiff(D1, La1, Lb1, S1) ||
+        S0 != S1)
+      continue;
+    Value *BA0 = nullptr, *BB0 = nullptr, *BA1 = nullptr, *BB1 = nullptr;
+    int64_t OA0 = 0, OB0 = 0, OA1 = 0, OB1 = 0;
+    if (!splitConstByteGEP(La0->getPointerOperand(), BA0, OA0) ||
+        !splitConstByteGEP(Lb0->getPointerOperand(), BB0, OB0) ||
+        !splitConstByteGEP(La1->getPointerOperand(), BA1, OA1) ||
+        !splitConstByteGEP(Lb1->getPointerOperand(), BB1, OB1))
+      continue;
+    if (BA0 != PA || BB0 != PB || BA1 != PA || BB1 != PB)
+      continue;
+    if (OA0 != OB0 || OA1 != OB1)
+      continue;
+    int64_t Lo = std::min(OA0, OA1);
+    int64_t Hi = std::max(OA0, OA1);
+    if (Hi != Lo + 1 || (Lo & 1) != 0 || Lo < 0 || Lo > 6)
+      continue;
+    if (NPack >= 4)
+      return false;
+    if (!SawSExt) {
+      IsSExt = S0;
+      SawSExt = true;
+    } else if (IsSExt != S0)
+      return false;
+    Packs[NPack] = &I;
+    PairOff[NPack] = Lo;
+    ++NPack;
+  }
+  if (NPack != 4)
+    return false;
+  bool SeenPair[4] = {};
+  for (unsigned I = 0; I < 4; ++I) {
+    if (PairOff[I] != 0 && PairOff[I] != 2 && PairOff[I] != 4 &&
+        PairOff[I] != 6)
+      return false;
+    unsigned Slot = static_cast<unsigned>(PairOff[I] / 2);
+    if (SeenPair[Slot])
+      return false;
+    SeenPair[Slot] = true;
+  }
+
+  unsigned NStore = 0;
+  Value *Stored[4] = {};
+  for (Instruction &I : LoopBB) {
+    auto *SI = dyn_cast<StoreInst>(&I);
+    if (!SI || !SI->getValueOperand()->getType()->isIntegerTy(32))
+      continue;
+    if (NStore >= 4)
+      return false;
+    Stored[NStore++] = SI->getValueOperand();
+  }
+  if (NStore != 4)
+    return false;
+  Value *S[4] = {};
+  if (!matchHadamard4(ArrayRef<Value *>(Stored, 4), S))
+    return false;
+  SmallPtrSet<Value *, 4> PackSet;
+  for (Value *P : Packs)
+    PackSet.insert(P);
+  for (Value *V : S)
+    if (!PackSet.contains(V))
+      return false;
+  return countPackedAbs2In(*Exit) == 32 &&
+         isa<ReturnInst>(Exit->getTerminator()) &&
+         Exit->getTerminator()->getOperand(0)->getType()->isIntegerTy(32);
+}
+
+static void eraseDeadBlocks(ArrayRef<BasicBlock *> Blocks) {
+  SmallPtrSet<BasicBlock *, 4> Unique;
+  SmallVector<BasicBlock *, 4> Dead;
+  for (BasicBlock *BB : Blocks)
+    if (BB && Unique.insert(BB).second)
+      Dead.push_back(BB);
+  for (BasicBlock *BB : Dead)
+    for (Instruction &I : *BB)
+      I.dropAllReferences();
+  for (BasicBlock *BB : Dead)
+    BB->eraseFromParent();
+}
+
+struct I8AbsLeaf {
+  Instruction *AbsI;
+  Value *BaseA;
+  Value *BaseB;
+  int64_t OffA;
+  int64_t OffB;
+  bool IsSExt;
+};
+
+static bool matchI8AbsDiffLeaf(Value *V, I8AbsLeaf &L) {
+  Value *Diff = nullptr;
+  if (!matchI32Abs(V, Diff))
+    return false;
+  auto *AbsI = dyn_cast<Instruction>(V);
+  if (!AbsI)
+    return false;
+  LoadInst *La = nullptr, *Lb = nullptr;
+  bool IsSExt = false;
+  if (!matchI8ZExtDiff(Diff, La, Lb, IsSExt))
+    return false;
+  Value *BA = nullptr, *BB = nullptr;
+  int64_t OA = 0, OB = 0;
+  if (!splitConstByteGEP(La->getPointerOperand(), BA, OA) ||
+      !splitConstByteGEP(Lb->getPointerOperand(), BB, OB))
+    return false;
+  if (OA < 0 || OB < 0)
+    return false;
+  L = {AbsI, BA, BB, OA, OB, IsSExt};
+  return true;
+}
+
+static Value *emitI8AbsReduce(IRBuilder<> &B, Value *Diff) {
+  Value *Abs = B.CreateIntrinsic(Intrinsic::abs, {Diff->getType()},
+                                 {Diff, B.getFalse()}, {}, "loong.sad.abs");
+  return B.CreateAddReduce(Abs);
+}
+
+static bool tryRewriteI8AbsDiffRows(Function &F, const LoongArchSubtarget &ST) {
+  if (!ST.hasExtLSX())
+    return false;
+  for (Instruction &I : instructions(F)) {
+    StringRef N = I.getName();
+    if (N.starts_with("loong.satd") || N.starts_with("loong.sa8d") ||
+        N.starts_with("loong.hac") || N.starts_with("loong.swar"))
+      return false;
+  }
+
+  SmallVector<I8AbsLeaf, 64> Leaves;
+  for (Instruction &I : instructions(F)) {
+    I8AbsLeaf L;
+    if (matchI8AbsDiffLeaf(&I, L) && L.AbsI->hasOneUse())
+      Leaves.push_back(L);
+  }
+  if (Leaves.size() < 4)
+    return false;
+
+  struct Group {
+    Value *BaseA;
+    Value *BaseB;
+    bool IsSExt;
+    SmallVector<I8AbsLeaf *, 16> At;
+  };
+  SmallVector<Group, 16> Groups;
+  for (I8AbsLeaf &L : Leaves) {
+    Group *G = nullptr;
+    for (Group &E : Groups)
+      if (E.BaseA == L.BaseA && E.BaseB == L.BaseB && E.IsSExt == L.IsSExt) {
+        G = &E;
+        break;
+      }
+    if (!G) {
+      Groups.push_back({L.BaseA, L.BaseB, L.IsSExt, {}});
+      G = &Groups.back();
+    }
+    G->At.push_back(&L);
+  }
+
+  Type *I32Ty = Type::getInt32Ty(F.getContext());
+  auto *I8Ty = Type::getInt8Ty(F.getContext());
+  SmallPtrSet<Instruction *, 16> Used;
+  bool Changed = false;
+
+  for (Group &G : Groups) {
+    auto leafAt = [&](int64_t OA, int64_t OB) -> I8AbsLeaf * {
+      for (I8AbsLeaf *L : G.At)
+        if (L->OffA == OA && L->OffB == OB && !Used.contains(L->AbsI))
+          return L;
+      return nullptr;
+    };
+
+    for (I8AbsLeaf *L0 : G.At) {
+      if (Used.contains(L0->AbsI))
+        continue;
+      I8AbsLeaf *Row[4] = {L0, nullptr, nullptr, nullptr};
+      bool Ok = true;
+      for (unsigned C = 1; C < 4; ++C) {
+        Row[C] = leafAt(L0->OffA + static_cast<int64_t>(C),
+                        L0->OffB + static_cast<int64_t>(C));
+        if (!Row[C]) {
+          Ok = false;
+          break;
+        }
+      }
+      if (!Ok)
+        continue;
+
+      Instruction *InsertAt = Row[0]->AbsI;
+      bool SameBB = true;
+      for (unsigned C = 1; C < 4; ++C) {
+        if (Row[C]->AbsI->getParent() != InsertAt->getParent()) {
+          SameBB = false;
+          break;
+        }
+        if (Row[C]->AbsI->comesBefore(InsertAt))
+          InsertAt = Row[C]->AbsI;
+      }
+      if (!SameBB || !valueDominatesInBB(G.BaseA, *InsertAt) ||
+          !valueDominatesInBB(G.BaseB, *InsertAt))
+        continue;
+
+      IRBuilder<> B(InsertAt);
+      Value *RA = G.BaseA;
+      Value *RB = G.BaseB;
+      if (L0->OffA)
+        RA = B.CreateInBoundsGEP(I8Ty, G.BaseA, B.getInt64(L0->OffA),
+                                 "loong.sad.a");
+      if (L0->OffB)
+        RB = B.CreateInBoundsGEP(I8Ty, G.BaseB, B.getInt64(L0->OffB),
+                                 "loong.sad.b");
+      Value *Diff = emitI8RowDiffV4(B, RA, RB, G.IsSExt, I32Ty, 0);
+      Value *Sum = emitI8AbsReduce(B, Diff);
+      Row[0]->AbsI->replaceAllUsesWith(Sum);
+      for (unsigned C = 1; C < 4; ++C)
+        Row[C]->AbsI->replaceAllUsesWith(ConstantInt::get(I32Ty, 0));
+      for (unsigned C = 0; C < 4; ++C) {
+        Used.insert(Row[C]->AbsI);
+        RecursivelyDeleteTriviallyDeadInstructions(Row[C]->AbsI);
+      }
+      Changed = true;
+      ++NumSWARSAD;
+    }
+  }
+  return Changed;
+}
+
+static bool matchMul2(Value *V, Value *&X) {
+  ConstantInt *C = nullptr;
+  if (match(V, m_Mul(m_Value(X), m_ConstantInt(C))) && C && C->equalsInt(2))
+    return true;
+  if (match(V, m_Shl(m_Value(X), m_SpecificInt(1))))
+    return true;
+  Value *A = nullptr, *B = nullptr;
+  if (match(V, m_Add(m_Value(A), m_Value(B))) && A == B) {
+    X = A;
+    return true;
+  }
+  return false;
+}
+
+static bool matchAddSubPair(Value *Add, Value *Sub, Value *&P, Value *&M) {
+  Value *X = nullptr, *Y = nullptr;
+  if (!matchI32Add(Add, X, Y))
+    return false;
+  Value *A = nullptr, *B = nullptr;
+  if (!matchI32Sub(Sub, A, B))
+    return false;
+  if (A == X && B == Y) {
+    P = X;
+    M = Y;
+    return true;
+  }
+  if (A == Y && B == X) {
+    P = Y;
+    M = X;
+    return true;
+  }
+  return false;
+}
+
+static bool matchDCT4Ordered(Value *O0, Value *O1, Value *O2, Value *O3,
+                             Value *S[4]) {
+  Value *S03 = nullptr, *S12 = nullptr;
+  if (!matchAddSubPair(O0, O2, S03, S12))
+    return false;
+  Value *T0 = nullptr, *T1 = nullptr;
+  if (!matchI32Add(O1, T0, T1))
+    return false;
+  Value *D03 = nullptr, *D12 = nullptr;
+  if (matchMul2(T0, D03))
+    D12 = T1;
+  else if (matchMul2(T1, D03))
+    D12 = T0;
+  else
+    return false;
+  Value *L = nullptr, *R = nullptr;
+  if (!matchI32Sub(O3, L, R) || L != D03)
+    return false;
+  Value *D12b = nullptr;
+  if (!matchMul2(R, D12b) || D12b != D12)
+    return false;
+  if (!matchAddSubPair(S03, D03, S[0], S[3]) ||
+      !matchAddSubPair(S12, D12, S[1], S[2]))
+    return false;
+  return true;
+}
+
+static Value *peekI32(Value *V) {
+  if (auto *T = dyn_cast<TruncInst>(V))
+    return T->getOperand(0);
+  if (auto *Z = dyn_cast<ZExtInst>(V))
+    if (Z->getSrcTy()->isIntegerTy(32))
+      return Z->getOperand(0);
+  if (auto *S = dyn_cast<SExtInst>(V))
+    if (S->getSrcTy()->isIntegerTy(32))
+      return S->getOperand(0);
+  return V;
+}
+
+static Value *emitDCT4OnV4(IRBuilder<> &B, Value *V) {
+  const int RevM[] = {3, 2, 1, 0};
+  Value *Rev = B.CreateShuffleVector(V, RevM, "loong.dct.rev");
+  Value *Sum = B.CreateAdd(V, Rev, "loong.dct.sum");
+  Value *Dif = B.CreateSub(V, Rev, "loong.dct.dif");
+  const int S03M[] = {0, 0, 0, 0};
+  const int S12M[] = {1, 1, 1, 1};
+  Value *S03 = B.CreateShuffleVector(Sum, S03M, "loong.dct.s03");
+  Value *S12 = B.CreateShuffleVector(Sum, S12M, "loong.dct.s12");
+  Value *D03 = B.CreateShuffleVector(Dif, S03M, "loong.dct.d03");
+  Value *D12 = B.CreateShuffleVector(Dif, S12M, "loong.dct.d12");
+  Value *O0 = B.CreateAdd(S03, S12, "loong.dct.o0");
+  Value *O1 = B.CreateAdd(B.CreateAdd(D03, D03), D12, "loong.dct.o1");
+  Value *O2 = B.CreateSub(S03, S12, "loong.dct.o2");
+  Value *O3 = B.CreateSub(D03, B.CreateAdd(D12, D12), "loong.dct.o3");
+  Value *P01 =
+      B.CreateShuffleVector(O0, O1, ArrayRef<int>({0, 4, 0, 4}), "loong.dct.p01");
+  Value *P23 =
+      B.CreateShuffleVector(O2, O3, ArrayRef<int>({0, 4, 0, 4}), "loong.dct.p23");
+  return B.CreateShuffleVector(P01, P23, ArrayRef<int>({0, 1, 4, 5}),
+                               "loong.dct.out");
+}
+
+static void emitTranspose4x4V4I32(IRBuilder<> &B, Value *R[4], Value *C[4]) {
+  const int Il[] = {0, 4, 1, 5};
+  const int Ih[] = {2, 6, 3, 7};
+  const int Lo[] = {0, 1, 4, 5};
+  const int Hi[] = {2, 3, 6, 7};
+  Value *A = B.CreateShuffleVector(R[0], R[1], Il, "loong.dct.il01");
+  Value *Bv = B.CreateShuffleVector(R[2], R[3], Il, "loong.dct.il23");
+  Value *Cv = B.CreateShuffleVector(R[0], R[1], Ih, "loong.dct.ih01");
+  Value *Dv = B.CreateShuffleVector(R[2], R[3], Ih, "loong.dct.ih23");
+  C[0] = B.CreateShuffleVector(A, Bv, Lo, "loong.dct.t0");
+  C[1] = B.CreateShuffleVector(A, Bv, Hi, "loong.dct.t1");
+  C[2] = B.CreateShuffleVector(Cv, Dv, Lo, "loong.dct.t2");
+  C[3] = B.CreateShuffleVector(Cv, Dv, Hi, "loong.dct.t3");
+}
+
+static bool tryRewriteSub4x4DCT(Function &F, const LoongArchSubtarget &ST) {
+  if (!ST.hasExtLSX() || F.arg_size() < 3)
+    return false;
+  Value *Dst = F.getArg(0);
+  Value *Pix1 = F.getArg(1);
+  Value *Pix2 = F.getArg(2);
+  if (!Dst->getType()->isPointerTy() || !Pix1->getType()->isPointerTy() ||
+      !Pix2->getType()->isPointerTy())
+    return false;
+
+  SmallVector<StoreInst *, 16> St;
+  for (Instruction &I : instructions(F)) {
+    if (auto *LI = dyn_cast<LoadInst>(&I))
+      if (LI->getType()->isVectorTy())
+        return false;
+    auto *SI = dyn_cast<StoreInst>(&I);
+    if (!SI || !SI->getValueOperand()->getType()->isIntegerTy(16))
+      continue;
+    Value *Base = nullptr;
+    int64_t Off = 0;
+    if (!splitConstByteGEP(SI->getPointerOperand(), Base, Off) || Base != Dst)
+      continue;
+    St.push_back(SI);
+  }
+  if (St.size() != 16)
+    return false;
+
+  struct StRec {
+    StoreInst *SI;
+    int64_t Off;
+    Value *Val;
+  };
+  SmallVector<StRec, 16> Recs;
+  for (StoreInst *SI : St) {
+    Value *Base = nullptr;
+    int64_t Off = 0;
+    splitConstByteGEP(SI->getPointerOperand(), Base, Off);
+    Recs.push_back({SI, Off, peekI32(SI->getValueOperand())});
+  }
+  llvm::sort(Recs, [](const StRec &A, const StRec &B) { return A.Off < B.Off; });
+  for (unsigned I = 1; I < 16; ++I)
+    if (Recs[I].Off == Recs[I - 1].Off)
+      return false;
+  const int64_t Step = Recs[1].Off - Recs[0].Off;
+  if (Step != 1 && Step != 2)
+    return false;
+  for (unsigned I = 0; I < 16; ++I)
+    if (Recs[I].Off != Recs[0].Off + static_cast<int64_t>(I) * Step)
+      return false;
+
+  Value *ColS[4][4];
+  for (unsigned K = 0; K < 4; ++K) {
+    Value *O[4] = {Recs[K * 4 + 0].Val, Recs[K * 4 + 1].Val,
+                   Recs[K * 4 + 2].Val, Recs[K * 4 + 3].Val};
+    if (!matchDCT4Ordered(O[0], O[1], O[2], O[3], ColS[K]))
+      return false;
+  }
+  Value *RowDiff[4][4];
+  for (unsigned R = 0; R < 4; ++R) {
+    Value *Dk[4] = {ColS[0][R], ColS[1][R], ColS[2][R], ColS[3][R]};
+    if (!matchDCT4Ordered(Dk[0], Dk[1], Dk[2], Dk[3], RowDiff[R]))
+      return false;
+  }
+
+  Value *RowA[4] = {};
+  Value *RowB[4] = {};
+  bool IsSExt = false;
+  for (unsigned R = 0; R < 4; ++R) {
+    LoadInst *La[4] = {};
+    LoadInst *Lb[4] = {};
+    for (unsigned C = 0; C < 4; ++C) {
+      bool S = false;
+      if (!matchI8ZExtDiff(RowDiff[R][C], La[C], Lb[C], S))
+        return false;
+      if (R == 0 && C == 0)
+        IsSExt = S;
+      else if (S != IsSExt)
+        return false;
+    }
+    Value *Diffs[] = {RowDiff[R][0], RowDiff[R][1], RowDiff[R][2],
+                      RowDiff[R][3]};
+    if (!matchI8DiffRow4(Diffs, RowA[R], RowB[R], IsSExt))
+      return false;
+  }
+
+  Instruction *InsertAt = Recs[0].SI;
+  for (const StRec &R : Recs) {
+    if (R.SI->getParent() != InsertAt->getParent())
+      return false;
+    if (R.SI->comesBefore(InsertAt))
+      InsertAt = R.SI;
+  }
+  for (unsigned R = 0; R < 4; ++R)
+    if (!valueDominatesInBB(RowA[R], *InsertAt) ||
+        !valueDominatesInBB(RowB[R], *InsertAt))
+      return false;
+
+  Type *I32Ty = Type::getInt32Ty(F.getContext());
+  IRBuilder<> B(InsertAt);
+  Value *RV[4];
+  Value *DV[4];
+  Value *TV[4];
+  Value *OV[4];
+  for (unsigned R = 0; R < 4; ++R)
+    RV[R] = emitI8RowDiffV4(B, RowA[R], RowB[R], IsSExt, I32Ty, 0);
+  for (unsigned R = 0; R < 4; ++R)
+    DV[R] = emitDCT4OnV4(B, RV[R]);
+  emitTranspose4x4V4I32(B, DV, TV);
+  for (unsigned K = 0; K < 4; ++K)
+    OV[K] = emitDCT4OnV4(B, TV[K]);
+  auto *V4I16 = FixedVectorType::get(B.getInt16Ty(), 4);
+  for (unsigned K = 0; K < 4; ++K) {
+    Value *Tr = B.CreateTrunc(OV[K], V4I16, "loong.dct.tr");
+    B.CreateAlignedStore(Tr, Recs[K * 4].SI->getPointerOperand(), Align(1));
+  }
+  for (const StRec &R : Recs)
+    R.SI->eraseFromParent();
+  ++NumSWARDCT;
+  return true;
+}
+
+static bool matchKTimes(Value *V, Value *S, int64_t K) {
+  if (!V || !S || K == 0)
+    return false;
+  if (K == 1)
+    return V == S;
+  ConstantInt *C = nullptr;
+  Value *A = nullptr;
+  if (match(V, m_Mul(m_Value(A), m_ConstantInt(C))) && A == S &&
+      C->getSExtValue() == K)
+    return true;
+  if (match(V, m_Mul(m_ConstantInt(C), m_Value(A))) && A == S &&
+      C->getSExtValue() == K)
+    return true;
+  if (K == -1 && (match(V, m_Neg(m_Specific(S))) ||
+                  match(V, m_Sub(m_Zero(), m_Specific(S)))))
+    return true;
+  if (K == 2 && (match(V, m_Shl(m_Specific(S), m_One())) ||
+                 match(V, m_Add(m_Specific(S), m_Specific(S)))))
+    return true;
+  if (K < 0) {
+    Value *T = nullptr;
+    if (match(V, m_Neg(m_Value(T))) || match(V, m_Sub(m_Zero(), m_Value(T))))
+      return matchKTimes(T, S, -K);
+  }
+  return false;
+}
+
+static Value *matchI8ZExtOf(LoadInst *Ld) {
+  for (User *U : Ld->users())
+    if (auto *Z = dyn_cast<CastInst>(U))
+      if ((isa<ZExtInst>(Z) || isa<SExtInst>(Z)) &&
+          Z->getDestTy()->isIntegerTy(32) && Z->getOperand(0) == Ld)
+        return Z;
+  return nullptr;
+}
+
+static bool matchAbsLtBound(Value *A, Value *B, Value *&Bound) {
+  auto checkSub = [&](Value *Sub) -> bool {
+    Value *AbsSrc = nullptr;
+    for (User *U : Sub->users()) {
+      if (!matchI32Abs(U, AbsSrc) || AbsSrc != Sub)
+        continue;
+      for (User *U2 : U->users()) {
+        auto *Cmp = dyn_cast<ICmpInst>(U2);
+        if (!Cmp || !Cmp->isRelational())
+          continue;
+        if (Cmp->getOperand(0) == U) {
+          Bound = Cmp->getOperand(1);
+          return Bound && Bound->getType()->isIntegerTy(32);
+        }
+      }
+    }
+    return false;
+  };
+  for (User *U : A->users()) {
+    Value *X = nullptr, *Y = nullptr;
+    if (!match(U, m_Sub(m_Value(X), m_Value(Y))))
+      continue;
+    if ((X == A && Y == B) || (X == B && Y == A))
+      if (checkSub(U))
+        return true;
+  }
+  return false;
+}
+
+static bool hasDeblockDeltaAshr3(Function &F, Value *P0z, Value *Q0z) {
+  for (Instruction &I : instructions(F)) {
+    Value *X = nullptr;
+    if (!match(&I, m_AShr(m_Value(X), m_SpecificInt(3))))
+      continue;
+    Value *Sh = nullptr, *Rest = nullptr;
+    if (!match(X, m_c_Add(m_Shl(m_Value(Sh), m_SpecificInt(2)), m_Value(Rest))))
+      continue;
+    if (match(Sh, m_Sub(m_Specific(Q0z), m_Specific(P0z))) ||
+        match(Sh, m_Sub(m_Specific(P0z), m_Specific(Q0z))))
+      return true;
+  }
+  return false;
+}
+
+static Value *emitClip3Vec(IRBuilder<> &B, Value *V, Value *Lo, Value *Hi) {
+  Value *Mx = B.CreateIntrinsic(Intrinsic::smax, {V->getType()}, {V, Lo});
+  return B.CreateIntrinsic(Intrinsic::smin, {V->getType()}, {Mx, Hi});
+}
+
+static Value *emitClipPixVec(IRBuilder<> &B, Value *V) {
+  Type *Ty = V->getType();
+  Value *Z = ConstantInt::get(Ty, 0);
+  Value *Hi = ConstantInt::get(Ty, 255);
+  return emitClip3Vec(B, V, Z, Hi);
+}
+
+static Value *emitZextLoadI8Row(IRBuilder<> &B, Value *Ptr, Type *EltTy,
+                                unsigned N) {
+  // Load 4 bytes as i32 so ISel emits ld.w, never a 16-byte xvld/vld.
+  (void)N;
+  auto *V4I8 = FixedVectorType::get(B.getInt8Ty(), 4);
+  auto *VW = FixedVectorType::get(EltTy, 4);
+  Value *W = B.CreateAlignedLoad(B.getInt32Ty(), Ptr, Align(1), "loong.db.w");
+  Value *L = B.CreateBitCast(W, V4I8, "loong.db.ld");
+  return B.CreateZExt(L, VW, "loong.db.z");
+}
+
+static void emitDeblockUnit4(IRBuilder<> &B, Value *Pix, Value *XStride,
+                             Value *Alpha, Value *Beta, Value *TcS, Type *I32Ty) {
+  auto *I8Ty = B.getInt8Ty();
+  auto *V4I8 = FixedVectorType::get(I8Ty, 4);
+  auto gepK = [&](int64_t K) -> Value * {
+    Value *Off = XStride;
+    if (K != 1)
+      Off = B.CreateMul(XStride, ConstantInt::getSigned(XStride->getType(), K),
+                        "loong.db.off");
+    return B.CreateInBoundsGEP(I8Ty, Pix, Off, "loong.db.row");
+  };
+  Value *P2p = gepK(-3);
+  Value *P1p = gepK(-2);
+  Value *P0p = gepK(-1);
+  Value *Q0p = Pix;
+  Value *Q1p = gepK(1);
+  Value *Q2p = gepK(2);
+
+  Value *P2 = emitZextLoadI8Row(B, P2p, I32Ty, 4);
+  Value *P1 = emitZextLoadI8Row(B, P1p, I32Ty, 4);
+  Value *P0 = emitZextLoadI8Row(B, P0p, I32Ty, 4);
+  Value *Q0 = emitZextLoadI8Row(B, Q0p, I32Ty, 4);
+  Value *Q1 = emitZextLoadI8Row(B, Q1p, I32Ty, 4);
+  Value *Q2 = emitZextLoadI8Row(B, Q2p, I32Ty, 4);
+
+  Value *AlphaV = B.CreateVectorSplat(4, Alpha);
+  Value *BetaV = B.CreateVectorSplat(4, Beta);
+  auto vabs = [&](Value *X) {
+    return B.CreateIntrinsic(Intrinsic::abs, {X->getType()}, {X, B.getFalse()});
+  };
+  Value *Mask = B.CreateAnd(
+      B.CreateICmpSLT(vabs(B.CreateSub(P0, Q0)), AlphaV),
+      B.CreateAnd(B.CreateICmpSLT(vabs(B.CreateSub(P1, P0)), BetaV),
+                  B.CreateICmpSLT(vabs(B.CreateSub(Q1, Q0)), BetaV)));
+  Value *MaskP = B.CreateICmpSLT(vabs(B.CreateSub(P2, P0)), BetaV);
+  Value *MaskQ = B.CreateICmpSLT(vabs(B.CreateSub(Q2, Q0)), BetaV);
+
+  Value *Skip = B.CreateICmpSLT(TcS, ConstantInt::get(TcS->getType(), 0));
+  Value *Tc0NZ = B.CreateICmpNE(TcS, ConstantInt::get(TcS->getType(), 0));
+  Value *TC = B.CreateSExt(TcS, I32Ty);
+  Value *TCV = B.CreateVectorSplat(4, TC);
+  Value *One = B.CreateVectorSplat(4, ConstantInt::get(I32Ty, 1));
+  Value *Tc = B.CreateSelect(MaskP, B.CreateAdd(TCV, One), TCV);
+  Tc = B.CreateSelect(MaskQ, B.CreateAdd(Tc, One), Tc);
+
+  Value *Avg = B.CreateLShr(B.CreateAdd(B.CreateAdd(P0, Q0), One), One);
+  Value *NegTC = B.CreateNeg(TCV);
+  Value *P1f = B.CreateAdd(
+      P1, emitClip3Vec(B, B.CreateSub(B.CreateLShr(B.CreateAdd(P2, Avg), One), P1),
+                       NegTC, TCV));
+  Value *Q1f = B.CreateAdd(
+      Q1, emitClip3Vec(B, B.CreateSub(B.CreateLShr(B.CreateAdd(Q2, Avg), One), Q1),
+                       NegTC, TCV));
+  Value *Two = B.CreateVectorSplat(4, ConstantInt::get(I32Ty, 2));
+  Value *Three = B.CreateVectorSplat(4, ConstantInt::get(I32Ty, 3));
+  Value *Four = B.CreateVectorSplat(4, ConstantInt::get(I32Ty, 4));
+  Value *Delta = B.CreateAShr(
+      B.CreateAdd(B.CreateAdd(B.CreateShl(B.CreateSub(Q0, P0), Two),
+                              B.CreateSub(P1, Q1)),
+                  Four),
+      Three);
+  Delta = emitClip3Vec(B, Delta, B.CreateNeg(Tc), Tc);
+  Value *P0n = emitClipPixVec(B, B.CreateAdd(P0, Delta));
+  Value *Q0n = emitClipPixVec(B, B.CreateSub(Q0, Delta));
+
+  Value *Keep = B.CreateNot(B.CreateVectorSplat(4, Skip));
+  Value *M0 = B.CreateAnd(Mask, Keep);
+  Value *NZ = B.CreateVectorSplat(4, Tc0NZ);
+  Value *MP = B.CreateAnd(M0, B.CreateAnd(MaskP, NZ));
+  Value *MQ = B.CreateAnd(M0, B.CreateAnd(MaskQ, NZ));
+
+  auto blendStore = [&](Value *Ptr, Value *NewV, Value *M) {
+    Value *OldW = B.CreateAlignedLoad(I32Ty, Ptr, Align(1));
+    Value *Old = B.CreateBitCast(OldW, V4I8);
+    Value *Tr = B.CreateTrunc(NewV, V4I8);
+    Value *Sel = B.CreateSelect(M, Tr, Old);
+    B.CreateAlignedStore(B.CreateBitCast(Sel, I32Ty), Ptr, Align(1));
+  };
+  blendStore(P1p, P1f, MP);
+  blendStore(Q1p, Q1f, MQ);
+  blendStore(P0p, P0n, M0);
+  blendStore(Q0p, Q0n, M0);
+}
+
+/// Predicated H.264-style luma edge filter: 4 groups of 4 unit-stride samples.
+static void emitDeblockUnit16(IRBuilder<> &B, Value *Pix, Value *XStride,
+                              Value *Alpha, Value *Beta, Value *Tc0) {
+  auto *I8Ty = B.getInt8Ty();
+  Type *I32Ty = B.getInt32Ty();
+  for (unsigned G = 0; G < 4; ++G) {
+    Value *TcP = Tc0;
+    if (G)
+      TcP = B.CreateInBoundsGEP(I8Ty, Tc0, B.getInt64(G));
+    Value *TcS = B.CreateAlignedLoad(I8Ty, TcP, Align(1), "loong.db.tc");
+    Value *PixG = Pix;
+    if (G)
+      PixG = B.CreateInBoundsGEP(I8Ty, Pix, B.getInt64(G * 4), "loong.db.pixg");
+    emitDeblockUnit4(B, PixG, XStride, Alpha, Beta, TcS, I32Ty);
+  }
+}
+
+static bool isValueFromArg(Value *V, Value *Arg) {
+  if (!V || !Arg)
+    return false;
+  if (V == Arg)
+    return true;
+  if (V->stripPointerCasts() == Arg->stripPointerCasts())
+    return true;
+  unsigned Depth = 0;
+  while (auto *C = dyn_cast<CastInst>(V)) {
+    V = C->getOperand(0);
+    if (V == Arg)
+      return true;
+    if (++Depth > 4)
+      break;
+  }
+  return false;
+}
+
+static bool isDeblockLumaSignature(Function &F) {
+  if (!F.getReturnType()->isVoidTy() || F.arg_size() != 6)
+    return false;
+  if (!F.getArg(0)->getType()->isPointerTy() ||
+      !F.getArg(5)->getType()->isPointerTy())
+    return false;
+  return F.getArg(1)->getType()->isIntegerTy() &&
+         F.getArg(2)->getType()->isIntegerTy() &&
+         F.getArg(3)->getType()->isIntegerTy() &&
+         F.getArg(4)->getType()->isIntegerTy();
+}
+
+static bool tryRewriteDeblockLumaEdge(Function &F, const LoongArchSubtarget &ST) {
+  if (!ST.hasExtLSX() || !isDeblockLumaSignature(F))
+    return false;
+  // Disabled: even a full cmake rebuild SIGBUS's in integral_init4v xvldx
+  // when this rewrite is on (deblock_luma_c grows to ~621 ins). Also never
+  // mix a 5-file hand compile into an x264 link whose other .o used a
+  // different x264_t.mc.integral_init4v offset (0xBBD0 vs 0xBBC0).
+  return false;
+  for (Instruction &I : instructions(F))
+    if (I.getName().starts_with("loong.db."))
+      return false;
+
+  bool Matched = false;
+  Value *MatchXS = nullptr, *MatchAlpha = nullptr, *MatchBeta = nullptr,
+        *MatchTc0 = nullptr, *MatchPix = nullptr;
+  for (BasicBlock &BB : F) {
+    PHINode *PtrPhi = nullptr;
+    SmallVector<std::pair<Value *, LoadInst *>, 8> GepLoads;
+    LoadInst *Q0 = nullptr;
+    for (Instruction &I : BB) {
+      auto *LI = dyn_cast<LoadInst>(&I);
+      if (!LI || !LI->getType()->isIntegerTy(8))
+        continue;
+      Value *P = LI->getPointerOperand()->stripPointerCasts();
+      if (auto *PN = dyn_cast<PHINode>(P)) {
+        PtrPhi = PN;
+        Q0 = LI;
+        continue;
+      }
+      if (auto *G = dyn_cast<GetElementPtrInst>(P))
+        if (G->getNumIndices() == 1)
+          GepLoads.push_back({G->getOperand(1), LI});
+    }
+    if (!PtrPhi || !Q0 || GepLoads.size() < 5)
+      continue;
+
+    Value *XStride = nullptr;
+    LoadInst *P2 = nullptr, *P1 = nullptr, *P0 = nullptr, *Q1 = nullptr,
+             *Q2 = nullptr;
+    Value *A1 = F.getArg(1);
+    for (auto &E : GepLoads)
+      if (E.first == A1 || isValueFromArg(E.first, A1))
+        XStride = E.first;
+    if (!XStride) {
+      for (auto &E : GepLoads) {
+        unsigned Hit = 0;
+        for (auto &E2 : GepLoads) {
+          for (int K : {-3, -2, -1, 1, 2})
+            if (matchKTimes(E2.first, E.first, K))
+              ++Hit;
+        }
+        if (Hit >= 4) {
+          XStride = E.first;
+          break;
+        }
+      }
+    }
+    if (!XStride)
+      continue;
+    for (auto [Off, LI] : GepLoads) {
+      if (matchKTimes(Off, XStride, -3))
+        P2 = LI;
+      else if (matchKTimes(Off, XStride, -2))
+        P1 = LI;
+      else if (matchKTimes(Off, XStride, -1))
+        P0 = LI;
+      else if (matchKTimes(Off, XStride, 1))
+        Q1 = LI;
+      else if (matchKTimes(Off, XStride, 2))
+        Q2 = LI;
+    }
+    if (!P2 || !P1 || !P0 || !Q1 || !Q2)
+      continue;
+
+    Value *P0z = matchI8ZExtOf(P0);
+    Value *Q0z = matchI8ZExtOf(Q0);
+    Value *P1z = matchI8ZExtOf(P1);
+    Value *Q1z = matchI8ZExtOf(Q1);
+    if (!P0z || !Q0z || !P1z || !Q1z)
+      continue;
+    Value *Alpha = nullptr, *Beta = nullptr, *Beta2 = nullptr;
+    if (!matchAbsLtBound(P0z, Q0z, Alpha) ||
+        !matchAbsLtBound(P1z, P0z, Beta) ||
+        !matchAbsLtBound(Q1z, Q0z, Beta2))
+      continue;
+    if (Beta != Beta2 || !hasDeblockDeltaAshr3(F, P0z, Q0z))
+      continue;
+
+    bool Trip4 = false;
+    for (PHINode &P : BB.phis()) {
+      if (!P.getType()->isIntegerTy(32))
+        continue;
+      for (User *U : P.users()) {
+        if (!match(U, m_Add(m_Specific(&P), m_One())))
+          continue;
+        for (User *U2 : cast<Instruction>(U)->users()) {
+          auto *Cmp = dyn_cast<ICmpInst>(U2);
+          if (!Cmp || !Cmp->isEquality())
+            continue;
+          Value *RHS = Cmp->getOperand(0) == U ? Cmp->getOperand(1)
+                                               : Cmp->getOperand(0);
+          if (auto *C = dyn_cast<ConstantInt>(RHS))
+            if (C->equalsInt(4))
+              Trip4 = true;
+        }
+      }
+    }
+    if (!Trip4)
+      continue;
+
+    Value *YStride = nullptr;
+    Value *PixStart = nullptr;
+    for (unsigned I = 0, E = PtrPhi->getNumIncomingValues(); I != E; ++I) {
+      Value *V = PtrPhi->getIncomingValue(I);
+      if (auto *G = dyn_cast<GetElementPtrInst>(V)) {
+        if (G->getPointerOperand()->stripPointerCasts() == PtrPhi &&
+            G->getNumIndices() == 1) {
+          YStride = G->getOperand(1);
+          continue;
+        }
+      }
+      PixStart = V;
+    }
+    if (!YStride || !PixStart)
+      continue;
+
+    Value *Pix = PixStart;
+    if (auto *OP = dyn_cast<PHINode>(PixStart)) {
+      Pix = nullptr;
+      for (unsigned I = 0, E = OP->getNumIncomingValues(); I != E; ++I)
+        if (!isa<GetElementPtrInst>(OP->getIncomingValue(I))) {
+          Pix = OP->getIncomingValue(I);
+          break;
+        }
+      if (!Pix)
+        continue;
+    }
+
+    Value *Tc0 = nullptr;
+    if (auto *OP = dyn_cast<PHINode>(PixStart)) {
+      BasicBlock *OuterHdr = OP->getParent();
+      for (Instruction &I : *OuterHdr) {
+        auto *LI = dyn_cast<LoadInst>(&I);
+        if (!LI || !LI->getType()->isIntegerTy(8))
+          continue;
+        bool IsSkip = false;
+        for (User *U : LI->users())
+          if (auto *Cmp = dyn_cast<ICmpInst>(U))
+            if (Cmp->getPredicate() == ICmpInst::ICMP_SLT &&
+                (match(Cmp->getOperand(1), m_Zero()) ||
+                 match(Cmp->getOperand(1), m_SpecificInt(0))))
+              IsSkip = true;
+        if (!IsSkip)
+          continue;
+        Value *P = LI->getPointerOperand()->stripPointerCasts();
+        if (auto *G = dyn_cast<GetElementPtrInst>(P))
+          Tc0 = G->getPointerOperand()->stripPointerCasts();
+        else
+          Tc0 = P;
+        break;
+      }
+    }
+    if (!Pix || !Tc0 || !Pix->getType()->isPointerTy() ||
+        !Tc0->getType()->isPointerTy())
+      continue;
+    if (!isValueFromArg(Pix, F.getArg(0)) ||
+        !isValueFromArg(XStride, F.getArg(1)) ||
+        !isValueFromArg(YStride, F.getArg(2)) ||
+        !isValueFromArg(Alpha, F.getArg(3)) ||
+        !isValueFromArg(Beta, F.getArg(4)) ||
+        !isValueFromArg(Tc0, F.getArg(5)))
+      continue;
+    Matched = true;
+    MatchXS = F.getArg(1);
+    MatchAlpha = F.getArg(3);
+    MatchBeta = F.getArg(4);
+    MatchTc0 = F.getArg(5);
+    MatchPix = F.getArg(0);
+    break;
+  }
+  if (!Matched)
+    return false;
+
+  BasicBlock *OldEntry = &F.getEntryBlock();
+  LLVMContext &Ctx = F.getContext();
+  BasicBlock *NewEntry =
+      BasicBlock::Create(Ctx, "loong.deblock.entry", &F, OldEntry);
+  BasicBlock *VecBB =
+      BasicBlock::Create(Ctx, "loong.deblock.vec", &F, OldEntry);
+  IRBuilder<> EB(NewEntry);
+  Value *Y = F.getArg(2);
+  if (!Y->getType()->isIntegerTy(64))
+    Y = EB.CreateSExtOrTrunc(Y, EB.getInt64Ty());
+  EB.CreateCondBr(EB.CreateICmpEQ(Y, EB.getInt64(1), "loong.deblock.unity"),
+                  VecBB, OldEntry);
+  IRBuilder<> VB(VecBB);
+  Value *XS = MatchXS;
+  if (!XS->getType()->isIntegerTy(64))
+    XS = VB.CreateSExtOrTrunc(XS, VB.getInt64Ty());
+  Value *Alpha = MatchAlpha;
+  Value *Beta = MatchBeta;
+  Type *I32Ty = Type::getInt32Ty(Ctx);
+  if (Alpha->getType() != I32Ty)
+    Alpha = VB.CreateSExtOrTrunc(Alpha, I32Ty);
+  if (Beta->getType() != I32Ty)
+    Beta = VB.CreateSExtOrTrunc(Beta, I32Ty);
+  emitDeblockUnit16(VB, MatchPix, XS, Alpha, Beta, MatchTc0);
+  VB.CreateRetVoid();
+  ++NumDeblock;
+  return true;
+}
+
+
+static bool tryRewriteSA8D8x8(Function &F, const LoongArchSubtarget &ST) {
+  if (!ST.hasExtLSX())
+    return false;
+  BasicBlock *Pre = nullptr, *Exit = nullptr, *LoopBB = nullptr;
+  Value *Pix1 = nullptr, *Pix2 = nullptr, *Stride1 = nullptr, *Stride2 = nullptr;
+  bool IsSExt = false;
+  for (BasicBlock &BB : F) {
+    if (matchSA8DRowLoop(BB, Pre, Exit, Pix1, Pix2, Stride1, Stride2, IsSExt)) {
+      LoopBB = &BB;
+      break;
+    }
+  }
+  if (!LoopBB || !Pre || !Pix1 || !Pix2 || !Stride1 || !Stride2)
+    return false;
+
+  Type *I32Ty = Type::getInt32Ty(F.getContext());
+  IRBuilder<> B(Pre->getTerminator());
+  Value *New = emitSA8D8x8(B, Pix1, Pix2, Stride1, Stride2, IsSExt, I32Ty,
+                           ST.hasExtLASX());
+  Pre->getTerminator()->eraseFromParent();
+  IRBuilder<> RB(Pre);
+  RB.CreateRet(New);
+  eraseDeadBlocks({LoopBB, Exit});
+  ++NumSWARSA8D;
+  return true;
+}
+
+static bool matchHadamardACRet(Value *V, Value *&Pix, Value *&Stride) {
+  auto *OrI = dyn_cast<BinaryOperator>(V);
+  if (!OrI || OrI->getOpcode() != Instruction::Or ||
+      !OrI->getType()->isIntegerTy(64))
+    return false;
+  Value *Shl = OrI->getOperand(0);
+  Value *ZLo = OrI->getOperand(1);
+  if (!match(Shl, m_Shl(m_Value(), m_SpecificInt(32))))
+    std::swap(Shl, ZLo);
+  Value *ZHi = nullptr;
+  if (!match(Shl, m_Shl(m_Value(ZHi), m_SpecificInt(32))))
+    return false;
+  Value *AC8 = nullptr, *AC4 = nullptr;
+  if (!match(ZHi, m_ZExt(m_Value(AC8))) || !match(ZLo, m_ZExt(m_Value(AC4))))
+    return false;
+  if (!AC8->getType()->isIntegerTy(32) || !AC4->getType()->isIntegerTy(32))
+    return false;
+  Value *Hadd8 = nullptr, *Hadd4 = nullptr, *DC8 = nullptr, *DC4 = nullptr;
+  if (!match(AC8, m_Sub(m_Value(Hadd8), m_Value(DC8))) ||
+      !match(AC4, m_Sub(m_Value(Hadd4), m_Value(DC4))) || DC8 != DC4)
+    return false;
+  Value *DCSrc = nullptr;
+  if (!match(DC8, m_And(m_Value(DCSrc), m_SpecificInt(65535))))
+    return false;
+
+  Function *Fn = OrI->getFunction();
+  if (!Fn || Fn->arg_size() < 2)
+    return false;
+  auto *A0 = Fn->getArg(0);
+  auto *A1 = Fn->getArg(1);
+  if (!A0->getType()->isPointerTy() || !A1->getType()->isIntegerTy())
+    return false;
+  Pix = A0;
+  Stride = A1;
+
+  bool Seen[8][8] = {};
+  unsigned NLoad = 0;
+  for (Instruction &I : instructions(*Fn)) {
+    auto *LI = dyn_cast<LoadInst>(&I);
+    if (!LI || !LI->getType()->isIntegerTy(8))
+      continue;
+    unsigned Row = 0;
+    int64_t Col = 0;
+    if (!matchPtrRowCol(LI->getPointerOperand(), Pix, Stride, Row, Col))
+      return false;
+    if (Seen[Row][Col])
+      return false;
+    Seen[Row][Col] = true;
+    ++NLoad;
+  }
+  if (NLoad != 64)
+    return false;
+  for (unsigned R = 0; R < 8; ++R)
+    for (unsigned C = 0; C < 8; ++C)
+      if (!Seen[R][C])
+        return false;
+  return countPackedAbs2InFunc(*Fn) == 64;
+}
+
+static bool tryRewriteHadamardAC(Function &F, const LoongArchSubtarget &ST) {
+  if (!ST.hasExtLSX())
+    return false;
+  Instruction *RetOr = nullptr;
+  Value *Pix = nullptr, *Stride = nullptr;
+  for (BasicBlock &BB : F) {
+    auto *RI = dyn_cast<ReturnInst>(BB.getTerminator());
+    if (!RI)
+      continue;
+    Value *RV = RI->getReturnValue();
+    if (!RV || !RV->getType()->isIntegerTy(64))
+      continue;
+    Value *P = nullptr, *S = nullptr;
+    if (matchHadamardACRet(RV, P, S)) {
+      RetOr = dyn_cast<Instruction>(RV);
+      Pix = P;
+      Stride = S;
+      break;
+    }
+  }
+  if (!RetOr || !Pix || !Stride)
+    return false;
+
+  Type *I32Ty = Type::getInt32Ty(F.getContext());
+  IRBuilder<> B(RetOr);
+  Value *New = emitHadamardAC(B, Pix, Stride, I32Ty, ST.hasExtLASX());
+  RetOr->replaceAllUsesWith(New);
+  RecursivelyDeleteTriviallyDeadInstructions(RetOr);
+  ++NumSWARHadAC;
+  return true;
+}
+
+static bool tryRewriteSWARSATD(Instruction &I, const LoongArchSubtarget &ST) {
+  if (!ST.hasExtLSX() || I.getOpcode() != Instruction::LShr)
+    return false;
+  if (!I.getType()->isIntegerTy(32))
+    return false;
+  auto *ShC = dyn_cast<ConstantInt>(I.getOperand(1));
+  if (!ShC || !ShC->equalsInt(1))
+    return false;
+  Value *Sum = I.getOperand(0);
+  SmallVector<SmallVector<Value *, 16>, 2> Groups;
+  if (!collectSATDPackedSrcGroups(Sum, Groups))
+    return false;
+
+  unsigned Total = 0;
+  for (auto &G : Groups)
+    Total += G.size();
+
+  IRBuilder<> B(&I);
+  Type *I32Ty = I.getType();
+
+  if (Groups.size() == 2 && Total == 8 && Groups[0].size() == 4 &&
+      Groups[1].size() == 4) {
+    Value *S0[4] = {}, *S1[4] = {};
+    if (!matchHadamard4(Groups[0], S0) || !matchHadamard4(Groups[1], S1))
+      return false;
+    SWARButterflyRow Probe;
+    bool ProbeIsTmp0 = false;
+    if (!matchButterflyRowFromTmp(S0[0], Probe, ProbeIsTmp0))
+      return false;
+    Value *const *Col0S = ProbeIsTmp0 ? S0 : S1;
+    Value *const *Col1S = ProbeIsTmp0 ? S1 : S0;
+    SWARButterflyRow Rows[4];
+    for (unsigned R = 0; R < 4; ++R) {
+      bool IsTmp0 = false;
+      if (!matchButterflyRowFromTmp(Col0S[R], Rows[R], IsTmp0) || !IsTmp0)
+        return false;
+      if (R && (Rows[R].IsSExt != Rows[0].IsSExt))
+        return false;
+      if (Col1S[R] != Rows[R].Tmp1)
+        return false;
+      if (!valueDominatesInBB(Rows[R].BaseA, I) ||
+          !valueDominatesInBB(Rows[R].BaseB, I))
+        return false;
+    }
+    Value *BaseA[4], *BaseB[4];
+    for (unsigned R = 0; R < 4; ++R) {
+      BaseA[R] = Rows[R].BaseA;
+      BaseB[R] = Rows[R].BaseB;
+    }
+    Value *New = emitSATD4x4(B, BaseA, BaseB, Rows[0].IsSExt, I32Ty,
+                            ST.hasExtLASX());
+    I.replaceAllUsesWith(New);
+    I.eraseFromParent();
+    ++NumSWARSATD;
+    return true;
+  }
+
+  if (Groups.size() == 1 && Total == 16 && Groups[0].size() == 16) {
+    SmallVector<std::array<Value *, 4>, 4> SCols;
+    if (!partitionHadamardGroups(Groups[0], SCols) || SCols.size() != 4)
+      return false;
+
+    auto samePackSet = [](ArrayRef<Value *> A, ArrayRef<Value *> B) {
+      if (A.size() != B.size())
+        return false;
+      SmallPtrSet<Value *, 8> SA(A.begin(), A.end());
+      for (Value *V : B)
+        if (!SA.contains(V))
+          return false;
+      return true;
+    };
+
+    Value *BaseA[4] = {}, *BaseB[4] = {};
+    bool IsSExt = false;
+    SmallVector<Value *, 4> RowPacks[4];
+    SmallPtrSet<Value *, 4> SeenBase;
+    for (unsigned R = 0; R < 4; ++R) {
+      SmallVector<Value *, 8> Leaves;
+      SmallPtrSet<Value *, 16> Seen;
+      flattenAddSubUntilPack(SCols[0][R], Leaves, Seen);
+      if (Leaves.size() != 4)
+        return false;
+      bool RowSExt = false;
+      if (!matchSpatialRow8(Leaves, BaseA[R], BaseB[R], RowSExt))
+        return false;
+      if (R == 0)
+        IsSExt = RowSExt;
+      else if (RowSExt != IsSExt)
+        return false;
+      if (!SeenBase.insert(BaseA[R]).second)
+        return false;
+      if (!valueDominatesInBB(BaseA[R], I) || !valueDominatesInBB(BaseB[R], I))
+        return false;
+      RowPacks[R] = std::move(Leaves);
+    }
+    for (unsigned C = 1; C < 4; ++C)
+      for (unsigned R = 0; R < 4; ++R) {
+        SmallVector<Value *, 8> Leaves;
+        SmallPtrSet<Value *, 16> Seen;
+        flattenAddSubUntilPack(SCols[C][R], Leaves, Seen);
+        if (!samePackSet(RowPacks[R], Leaves))
+          return false;
+      }
+    Value *New = emitSATD8x4(B, BaseA, BaseB, IsSExt, I32Ty, ST.hasExtLASX());
+    I.replaceAllUsesWith(New);
+    I.eraseFromParent();
+    ++NumSWARSATD;
+    return true;
+  }
+
+  return false;
+}
+
+/// Four consecutive i8 diffs packed as two butterfly i32s, then (b0+b1, b0-b1).
+/// Replace with one v4i8 load pair + v4i32 widen + pack. Bit-exact vs the
+/// i32 SWAR sequence.
+static LLVM_ATTRIBUTE_UNUSED bool
+tryRewriteI8QuadButterflyPack(Instruction &I,
+                                          const LoongArchSubtarget &ST) {
+  if (!ST.hasExtLSX() || I.getOpcode() != Instruction::Add)
+    return false;
+  if (!I.getType()->isIntegerTy(32))
+    return false;
+
+  Value *P01 = nullptr;
+  Value *P23 = nullptr;
+  if (!match(&I, m_c_Add(m_Value(P01), m_Value(P23))))
+    return false;
+  Value *D0 = nullptr, *D1 = nullptr, *D2 = nullptr, *D3 = nullptr;
+  if (!matchButterflyPack(P01, D0, D1) || !matchButterflyPack(P23, D2, D3))
+    return false;
+
+  Instruction *Tmp1 = nullptr;
+  bool SubRev = false;
+  for (User *U : P01->users()) {
+    auto *SI = dyn_cast<Instruction>(U);
+    if (!SI || SI->getOpcode() != Instruction::Sub)
+      continue;
+    if (SI->getOperand(0) == P01 && SI->getOperand(1) == P23) {
+      Tmp1 = SI;
+      SubRev = false;
+      break;
+    }
+    if (SI->getOperand(0) == P23 && SI->getOperand(1) == P01) {
+      Tmp1 = SI;
+      SubRev = true;
+      break;
+    }
+  }
+  if (!Tmp1 || Tmp1->getParent() != I.getParent())
+    return false;
+
+  LoadInst *La[4] = {};
+  LoadInst *Lb[4] = {};
+  bool IsSExt = false;
+  Value *Diffs[4] = {D0, D1, D2, D3};
+  for (unsigned Idx = 0; Idx < 4; ++Idx) {
+    bool SExtI = false;
+    if (!matchI8ZExtDiff(Diffs[Idx], La[Idx], Lb[Idx], SExtI))
+      return false;
+    if (Idx == 0)
+      IsSExt = SExtI;
+    else if (IsSExt != SExtI)
+      return false;
+  }
+
+  Value *BaseA = nullptr;
+  Value *BaseB = nullptr;
+  int64_t OffA[4] = {};
+  int64_t OffB[4] = {};
+  for (unsigned Idx = 0; Idx < 4; ++Idx) {
+    Value *BA = nullptr;
+    Value *BB = nullptr;
+    if (!splitConstByteGEP(La[Idx]->getPointerOperand(), BA, OffA[Idx]) ||
+        !splitConstByteGEP(Lb[Idx]->getPointerOperand(), BB, OffB[Idx]))
+      return false;
+    if (Idx == 0) {
+      BaseA = BA;
+      BaseB = BB;
+    } else if (BA != BaseA || BB != BaseB)
+      return false;
+  }
+  bool SeenOff[4] = {};
+  for (unsigned Idx = 0; Idx < 4; ++Idx) {
+    if (OffA[Idx] < 0 || OffA[Idx] > 3 || OffA[Idx] != OffB[Idx] ||
+        SeenOff[OffA[Idx]])
+      return false;
+    SeenOff[OffA[Idx]] = true;
+  }
+  if (!SeenOff[0] || !SeenOff[1] || !SeenOff[2] || !SeenOff[3])
+    return false;
+  // Each butterfly must be (d[i]+d[i+1])+((d[i]-d[i+1])<<16) with i even.
+  if (!(OffA[1] == OffA[0] + 1 && (OffA[0] == 0 || OffA[0] == 2)) ||
+      !(OffA[3] == OffA[2] + 1 && (OffA[2] == 0 || OffA[2] == 2)) ||
+      OffA[0] == OffA[2])
+    return false;
+  if (!valueDominatesInBB(BaseA, I) || !valueDominatesInBB(BaseB, I))
+    return false;
+  const bool Pack01IsLow = OffA[0] == 0;
+
+  IRBuilder<> B(&I);
+  auto *I8Ty = Type::getInt8Ty(I.getContext());
+  auto *I32Ty = I.getType();
+  auto *V4I8 = FixedVectorType::get(I8Ty, 4);
+  auto *V4I32 = FixedVectorType::get(I32Ty, 4);
+  auto *V2I32 = FixedVectorType::get(I32Ty, 2);
+  Value *VA = B.CreateAlignedLoad(V4I8, BaseA, Align(1), "loong.swar.a");
+  Value *VB = B.CreateAlignedLoad(V4I8, BaseB, Align(1), "loong.swar.b");
+  Value *ZA =
+      IsSExt ? B.CreateSExt(VA, V4I32, "loong.swar.za")
+             : B.CreateZExt(VA, V4I32, "loong.swar.za");
+  Value *ZB =
+      IsSExt ? B.CreateSExt(VB, V4I32, "loong.swar.zb")
+             : B.CreateZExt(VB, V4I32, "loong.swar.zb");
+  Value *DiffV = B.CreateSub(ZA, ZB, "loong.swar.d");
+  const int EvenM[] = {0, 2};
+  const int OddM[] = {1, 3};
+  Value *Even = B.CreateShuffleVector(DiffV, EvenM, "loong.swar.ev");
+  Value *Odd = B.CreateShuffleVector(DiffV, OddM, "loong.swar.od");
+  Value *Sum = B.CreateAdd(Even, Odd, "loong.swar.ps");
+  Value *Dif = B.CreateSub(Even, Odd, "loong.swar.pd");
+  Value *Sh = B.CreateShl(Dif, ConstantInt::get(V2I32, 16), "loong.swar.psh");
+  Value *Pack = B.CreateAdd(Sum, Sh, "loong.swar.pk");
+  Value *P0 = B.CreateExtractElement(Pack, B.getInt32(0), "loong.swar.p0");
+  Value *P1 = B.CreateExtractElement(Pack, B.getInt32(1), "loong.swar.p1");
+  Value *NewTmp0 = B.CreateAdd(P0, P1, "loong.swar.t0");
+  // Vector pack lanes are (d0,d1) then (d2,d3). Map back to the matched
+  // P01/P23 subtraction polarity.
+  const bool Tmp1IsLowMinusHigh = Pack01IsLow ? !SubRev : SubRev;
+  Value *NewTmp1 =
+      Tmp1IsLowMinusHigh ? B.CreateSub(P0, P1, "loong.swar.t1")
+                         : B.CreateSub(P1, P0, "loong.swar.t1");
+  I.replaceAllUsesWith(NewTmp0);
+  Tmp1->replaceAllUsesWith(NewTmp1);
+  I.eraseFromParent();
+  Tmp1->eraseFromParent();
+  ++NumSWARPack;
+  return true;
+}
+
+/// Spatial pack: (d[i]) + (d[i+4] << 16) for i=0..3 from 8 consecutive i8 diffs.
+/// satd_8x4 / sa8d row prologue. Emits v8i8 loads + v4i32 packs.
+static LLVM_ATTRIBUTE_UNUSED bool
+tryRewriteI8SpatialPack4(Instruction &I,
+                                     const LoongArchSubtarget &ST) {
+  if (!ST.hasExtLSX() || I.getOpcode() != Instruction::Add)
+    return false;
+  if (!I.getType()->isIntegerTy(32))
+    return false;
+
+  Value *Lo0 = nullptr;
+  Value *Hi0 = nullptr;
+  if (!matchSpatialPack(&I, Lo0, Hi0))
+    return false;
+  // Reject butterfly: Lo would be an add, not an i8 diff.
+  LoadInst *La0 = nullptr, *Lb0 = nullptr, *La4 = nullptr, *Lb4 = nullptr;
+  bool IsSExt = false;
+  bool Dummy = false;
+  if (!matchI8ZExtDiff(Lo0, La0, Lb0, IsSExt) ||
+      !matchI8ZExtDiff(Hi0, La4, Lb4, Dummy) || Dummy != IsSExt)
+    return false;
+
+  Value *BaseA = nullptr;
+  Value *BaseB = nullptr;
+  Value *BaseA4 = nullptr;
+  Value *BaseB4 = nullptr;
+  int64_t OffA0 = 0, OffB0 = 0, OffA4 = 0, OffB4 = 0;
+  if (!splitConstByteGEP(La0->getPointerOperand(), BaseA, OffA0) ||
+      !splitConstByteGEP(Lb0->getPointerOperand(), BaseB, OffB0) ||
+      !splitConstByteGEP(La4->getPointerOperand(), BaseA4, OffA4) ||
+      !splitConstByteGEP(Lb4->getPointerOperand(), BaseB4, OffB4))
+    return false;
+  if (BaseA != BaseA4 || BaseB != BaseB4)
+    return false;
+  if (OffA0 != 0 || OffB0 != 0 || OffA4 != 4 || OffB4 != 4)
+    return false;
+
+  // Collect sibling packs d[1]+(d[5]<<16) ... d[3]+(d[7]<<16) in this BB.
+  Instruction *Packs[4] = {&I, nullptr, nullptr, nullptr};
+  for (Instruction &OI : *I.getParent()) {
+    if (&OI == &I || OI.getOpcode() != Instruction::Add)
+      continue;
+    Value *Lo = nullptr, *Hi = nullptr;
+    if (!matchSpatialPack(&OI, Lo, Hi))
+      continue;
+    LoadInst *La = nullptr, *Lb = nullptr, *LaH = nullptr, *LbH = nullptr;
+    bool SExtL = false, SExtH = false;
+    if (!matchI8ZExtDiff(Lo, La, Lb, SExtL) ||
+        !matchI8ZExtDiff(Hi, LaH, LbH, SExtH) || SExtL != IsSExt ||
+        SExtH != IsSExt)
+      continue;
+    int64_t OA = 0, OB = 0, OAH = 0, OBH = 0;
+    Value *BA = nullptr, *BB = nullptr, *BAH = nullptr, *BBH = nullptr;
+    if (!splitConstByteGEP(La->getPointerOperand(), BA, OA) ||
+        !splitConstByteGEP(Lb->getPointerOperand(), BB, OB) ||
+        !splitConstByteGEP(LaH->getPointerOperand(), BAH, OAH) ||
+        !splitConstByteGEP(LbH->getPointerOperand(), BBH, OBH))
+      continue;
+    if (BA != BaseA || BB != BaseB || BAH != BaseA || BBH != BaseB)
+      continue;
+    if (OA != OB || OAH != OBH || OAH != OA + 4)
+      continue;
+    if (OA < 1 || OA > 3 || Packs[OA])
+      continue;
+    Packs[OA] = &OI;
+  }
+  if (!Packs[1] || !Packs[2] || !Packs[3])
+    return false;
+  if (!valueDominatesInBB(BaseA, I) || !valueDominatesInBB(BaseB, I))
+    return false;
+
+  IRBuilder<> B(&I);
+  auto *I8Ty = Type::getInt8Ty(I.getContext());
+  auto *I32Ty = I.getType();
+  auto *V4I8 = FixedVectorType::get(I8Ty, 4);
+  auto *V4I32 = FixedVectorType::get(I32Ty, 4);
+  Value *Off4 = B.getInt64(4);
+  Value *PA4 = B.CreateInBoundsGEP(I8Ty, BaseA, Off4);
+  Value *PB4 = B.CreateInBoundsGEP(I8Ty, BaseB, Off4);
+  Value *VA0 = B.CreateAlignedLoad(V4I8, BaseA, Align(1), "loong.swar.a0");
+  Value *VA4 = B.CreateAlignedLoad(V4I8, PA4, Align(1), "loong.swar.a4");
+  Value *VB0 = B.CreateAlignedLoad(V4I8, BaseB, Align(1), "loong.swar.b0");
+  Value *VB4 = B.CreateAlignedLoad(V4I8, PB4, Align(1), "loong.swar.b4");
+  Value *ZA0 = IsSExt ? B.CreateSExt(VA0, V4I32) : B.CreateZExt(VA0, V4I32);
+  Value *ZA4 = IsSExt ? B.CreateSExt(VA4, V4I32) : B.CreateZExt(VA4, V4I32);
+  Value *ZB0 = IsSExt ? B.CreateSExt(VB0, V4I32) : B.CreateZExt(VB0, V4I32);
+  Value *ZB4 = IsSExt ? B.CreateSExt(VB4, V4I32) : B.CreateZExt(VB4, V4I32);
+  Value *LoV = B.CreateSub(ZA0, ZB0, "loong.swar.lo4");
+  Value *HiV = B.CreateSub(ZA4, ZB4, "loong.swar.hi4");
+  Value *Sh = B.CreateShl(HiV, ConstantInt::get(V4I32, 16));
+  Value *PackV = B.CreateAdd(LoV, Sh, "loong.swar.spk");
+  for (unsigned Idx = 0; Idx < 4; ++Idx) {
+    Value *El =
+        B.CreateExtractElement(PackV, B.getInt32(Idx), "loong.swar.spe");
+    Packs[Idx]->replaceAllUsesWith(El);
+  }
+  for (unsigned Idx = 0; Idx < 4; ++Idx)
+    Packs[Idx]->eraseFromParent();
+  ++NumSWARPack;
+  return true;
+}
+
+static Value *emitVAvgrHU(IRBuilder<> &Bld, Value *LHS, Value *RHS,
+                          bool HasLASX) {
+  auto *VTy = cast<FixedVectorType>(LHS->getType());
+  const unsigned N = VTy->getNumElements();
+  Intrinsic::ID ID = Intrinsic::not_intrinsic;
+  if (N == 16 && HasLASX)
+    ID = Intrinsic::loongarch_lasx_xvavgr_hu;
+  else if (N == 8)
+    ID = Intrinsic::loongarch_lsx_vavgr_hu;
+  else
+    return nullptr;
+  Function *Fn = Intrinsic::getOrInsertDeclaration(
+      Bld.GetInsertBlock()->getModule(), ID, {});
+  Value *Args[] = {LHS, RHS};
+  return Bld.CreateCall(Fn, Args, "loong.avgr");
+}
+
+static bool matchI8ZExtLoad(Value *V, LoadInst *&Ld) {
+  auto *Z = dyn_cast<ZExtInst>(V);
+  if (!Z)
+    return false;
+  if (!Z->getSrcTy()->isIntegerTy(8))
+    return false;
+  if (!Z->getDestTy()->isIntegerTy(16) && !Z->getDestTy()->isIntegerTy(32))
+    return false;
+  Ld = dyn_cast<LoadInst>(Z->getOperand(0));
+  return Ld && Ld->getType()->isIntegerTy(8);
+}
+
+static bool matchI8AvgrPair(Value *V, LoadInst *&La, LoadInst *&Lb) {
+  Value *T = V;
+  if (auto *Tr = dyn_cast<TruncInst>(V))
+    T = Tr->getOperand(0);
+  Value *A = nullptr, *B = nullptr;
+  if (match(T, m_LShr(m_NUWAdd(m_NUWAdd(m_Value(A), m_Value(B)), m_One()),
+                      m_One())) ||
+      match(T, m_LShr(m_NUWAdd(m_NUWAdd(m_Value(A), m_One()), m_Value(B)),
+                      m_One()))) {
+    return matchI8ZExtLoad(A, La) && matchI8ZExtLoad(B, Lb);
+  }
+  return false;
+}
+
+static bool tryRewriteI8AvgrRows(Function &F, const LoongArchSubtarget &ST) {
+  if (!ST.hasExtLSX())
+    return false;
+  bool Changed = false;
+  SmallPtrSet<StoreInst *, 32> Used;
+  for (BasicBlock &BB : F) {
+    SmallVector<StoreInst *, 16> Cands;
+    for (Instruction &I : BB) {
+      auto *SI = dyn_cast<StoreInst>(&I);
+      if (!SI || !SI->getValueOperand()->getType()->isIntegerTy(8))
+        continue;
+      if (Used.contains(SI))
+        continue;
+      LoadInst *La = nullptr, *Lb = nullptr;
+      if (matchI8AvgrPair(SI->getValueOperand(), La, Lb))
+        Cands.push_back(SI);
+    }
+    for (unsigned Start = 0; Start < Cands.size(); ++Start) {
+      if (Used.contains(Cands[Start]))
+        continue;
+      LoadInst *La0 = nullptr, *Lb0 = nullptr;
+      if (!matchI8AvgrPair(Cands[Start]->getValueOperand(), La0, Lb0))
+        continue;
+      Value *BA = nullptr, *BBp = nullptr, *BD = nullptr;
+      int64_t OA = 0, OB = 0, OD = 0;
+      splitConstByteGEP(La0->getPointerOperand(), BA, OA);
+      splitConstByteGEP(Lb0->getPointerOperand(), BBp, OB);
+      splitConstByteGEP(Cands[Start]->getPointerOperand(), BD, OD);
+      unsigned N = 1;
+      SmallVector<StoreInst *, 16> Row{Cands[Start]};
+      for (unsigned K = 1; K < 16 && Start + K < Cands.size(); ++K) {
+        if (Used.contains(Cands[Start + K]))
+          break;
+        LoadInst *La = nullptr, *Lb = nullptr;
+        if (!matchI8AvgrPair(Cands[Start + K]->getValueOperand(), La, Lb))
+          break;
+        Value *BA2 = nullptr, *BB2 = nullptr, *BD2 = nullptr;
+        int64_t OA2 = 0, OB2 = 0, OD2 = 0;
+        splitConstByteGEP(La->getPointerOperand(), BA2, OA2);
+        splitConstByteGEP(Lb->getPointerOperand(), BB2, OB2);
+        splitConstByteGEP(Cands[Start + K]->getPointerOperand(), BD2, OD2);
+        if (BA2 != BA || BB2 != BBp || BD2 != BD)
+          break;
+        if (OA2 != OA + static_cast<int64_t>(K) ||
+            OB2 != OB + static_cast<int64_t>(K) ||
+            OD2 != OD + static_cast<int64_t>(K))
+          break;
+        Row.push_back(Cands[Start + K]);
+        N = K + 1;
+      }
+      if (N != 8 && N != 16)
+        continue;
+      if (N == 16 && !ST.hasExtLASX())
+        continue;
+      Instruction *InsertAt = Row[0];
+      for (StoreInst *S : Row)
+        if (S->comesBefore(InsertAt))
+          InsertAt = S;
+      if (!valueDominatesInBB(BA, *InsertAt) ||
+          !valueDominatesInBB(BBp, *InsertAt) ||
+          !valueDominatesInBB(BD, *InsertAt))
+        continue;
+      IRBuilder<> Bld(InsertAt);
+      auto *I8Ty = Type::getInt8Ty(F.getContext());
+      auto *VI8 = FixedVectorType::get(I8Ty, N);
+      auto *VI16 = FixedVectorType::get(Type::getInt16Ty(F.getContext()), N);
+      auto gep = [&](Value *Base, int64_t Off) -> Value * {
+        if (!Off)
+          return Base;
+        return Bld.CreateInBoundsGEP(I8Ty, Base, Bld.getInt64(Off),
+                                     "loong.avgr.p");
+      };
+      Value *VA =
+          Bld.CreateAlignedLoad(VI8, gep(BA, OA), Align(1), "loong.avgr.a");
+      Value *VB =
+          Bld.CreateAlignedLoad(VI8, gep(BBp, OB), Align(1), "loong.avgr.b");
+      Value *ZA = Bld.CreateZExt(VA, VI16, "loong.avgr.za");
+      Value *ZB = Bld.CreateZExt(VB, VI16, "loong.avgr.zb");
+      Value *Avg = emitVAvgrHU(Bld, ZA, ZB, ST.hasExtLASX());
+      if (!Avg)
+        continue;
+      Value *Tr = Bld.CreateTrunc(Avg, VI8, "loong.avgr.tr");
+      Bld.CreateAlignedStore(Tr, gep(BD, OD), Align(1));
+      for (StoreInst *S : Row) {
+        Used.insert(S);
+        S->eraseFromParent();
+      }
+      Changed = true;
+      ++NumI8AvgrRow;
+    }
+  }
+  return Changed;
+}
+
+static bool tryRewriteI8DeinterleaveRows(Function &F,
+                                         const LoongArchSubtarget &ST) {
+  if (!ST.hasExtLSX())
+    return false;
+  bool Changed = false;
+  for (BasicBlock &BB : F) {
+    struct Rec {
+      StoreInst *SI;
+      LoadInst *Ld;
+      Value *DstBase;
+      Value *SrcBase;
+      int64_t DstOff;
+      int64_t SrcOff;
+    };
+    SmallVector<Rec, 16> Recs;
+    for (Instruction &I : BB) {
+      auto *SI = dyn_cast<StoreInst>(&I);
+      if (!SI || !SI->getValueOperand()->getType()->isIntegerTy(8))
+        continue;
+      auto *Ld = dyn_cast<LoadInst>(SI->getValueOperand());
+      if (!Ld || !Ld->getType()->isIntegerTy(8) || Ld->getParent() != &BB)
+        continue;
+      Rec R;
+      R.SI = SI;
+      R.Ld = Ld;
+      splitConstByteGEP(SI->getPointerOperand(), R.DstBase, R.DstOff);
+      splitConstByteGEP(Ld->getPointerOperand(), R.SrcBase, R.SrcOff);
+      Recs.push_back(R);
+    }
+    if (Recs.size() != 16)
+      continue;
+    Value *Src = Recs[0].SrcBase;
+    int64_t Src0 = Recs[0].SrcOff;
+    bool Ok = true;
+    for (const Rec &R : Recs) {
+      if (R.SrcBase != Src)
+        Ok = false;
+      if ((R.SrcOff - Src0) < 0 || (R.SrcOff - Src0) > 15)
+        Ok = false;
+    }
+    if (!Ok)
+      continue;
+    SmallVector<const Rec *, 8> Even, Odd;
+    for (const Rec &R : Recs) {
+      int64_t Rel = R.SrcOff - Src0;
+      if ((Rel & 1) == 0)
+        Even.push_back(&R);
+      else
+        Odd.push_back(&R);
+    }
+    if (Even.size() != 8 || Odd.size() != 8)
+      continue;
+    llvm::sort(Even, [](const Rec *A, const Rec *B) {
+      return A->SrcOff < B->SrcOff;
+    });
+    llvm::sort(Odd, [](const Rec *A, const Rec *B) {
+      return A->SrcOff < B->SrcOff;
+    });
+    Value *DstE = Even[0]->DstBase;
+    Value *DstO = Odd[0]->DstBase;
+    if (DstE == DstO)
+      continue;
+    for (unsigned I = 0; I < 8; ++I) {
+      if (Even[I]->SrcOff != Src0 + static_cast<int64_t>(2 * I) ||
+          Odd[I]->SrcOff != Src0 + static_cast<int64_t>(2 * I + 1) ||
+          Even[I]->DstBase != DstE || Odd[I]->DstBase != DstO ||
+          Even[I]->DstOff != Even[0]->DstOff + static_cast<int64_t>(I) ||
+          Odd[I]->DstOff != Odd[0]->DstOff + static_cast<int64_t>(I)) {
+        Ok = false;
+        break;
+      }
+    }
+    if (!Ok)
+      continue;
+    Instruction *InsertAt = Recs[0].SI;
+    for (const Rec &R : Recs)
+      if (R.SI->comesBefore(InsertAt))
+        InsertAt = R.SI;
+    if (!valueDominatesInBB(Src, *InsertAt) ||
+        !valueDominatesInBB(DstE, *InsertAt) ||
+        !valueDominatesInBB(DstO, *InsertAt))
+      continue;
+    IRBuilder<> Bld(InsertAt);
+    auto *I8Ty = Type::getInt8Ty(F.getContext());
+    auto *V16 = FixedVectorType::get(I8Ty, 16);
+    Value *SP = Src0 ? Bld.CreateInBoundsGEP(I8Ty, Src, Bld.getInt64(Src0),
+                                             "loong.deint.s")
+                     : Src;
+    Value *Vec = Bld.CreateAlignedLoad(V16, SP, Align(1), "loong.deint.v");
+    SmallVector<int, 8> Em, Om;
+    for (int I = 0; I < 8; ++I) {
+      Em.push_back(2 * I);
+      Om.push_back(2 * I + 1);
+    }
+    Value *VE = Bld.CreateShuffleVector(Vec, Em, "loong.deint.e");
+    Value *VO = Bld.CreateShuffleVector(Vec, Om, "loong.deint.o");
+    Value *PE =
+        Even[0]->DstOff
+            ? Bld.CreateInBoundsGEP(I8Ty, DstE, Bld.getInt64(Even[0]->DstOff),
+                                    "loong.deint.pe")
+            : DstE;
+    Value *PO =
+        Odd[0]->DstOff
+            ? Bld.CreateInBoundsGEP(I8Ty, DstO, Bld.getInt64(Odd[0]->DstOff),
+                                    "loong.deint.po")
+            : DstO;
+    Bld.CreateAlignedStore(VE, PE, Align(1));
+    Bld.CreateAlignedStore(VO, PO, Align(1));
+    for (const Rec &R : Recs)
+      R.SI->eraseFromParent();
+    Changed = true;
+    ++NumI8Deinterleave;
+  }
+  return Changed;
+}
+
+static bool tryRewriteI8InterleaveRows(Function &F,
+                                       const LoongArchSubtarget &ST) {
+  if (!ST.hasExtLSX())
+    return false;
+  bool Changed = false;
+  for (BasicBlock &BB : F) {
+    struct Rec {
+      StoreInst *SI;
+      LoadInst *Ld;
+      Value *DstBase;
+      Value *SrcBase;
+      int64_t DstOff;
+      int64_t SrcOff;
+    };
+    SmallVector<Rec, 16> Recs;
+    for (Instruction &I : BB) {
+      auto *SI = dyn_cast<StoreInst>(&I);
+      if (!SI || !SI->getValueOperand()->getType()->isIntegerTy(8))
+        continue;
+      auto *Ld = dyn_cast<LoadInst>(SI->getValueOperand());
+      if (!Ld || Ld->getParent() != &BB)
+        continue;
+      Rec R;
+      R.SI = SI;
+      R.Ld = Ld;
+      splitConstByteGEP(SI->getPointerOperand(), R.DstBase, R.DstOff);
+      splitConstByteGEP(Ld->getPointerOperand(), R.SrcBase, R.SrcOff);
+      Recs.push_back(R);
+    }
+    if (Recs.size() != 16)
+      continue;
+    Value *Dst = Recs[0].DstBase;
+    int64_t D0 = Recs[0].DstOff;
+    bool Ok = true;
+    for (const Rec &R : Recs) {
+      if (R.DstBase != Dst || R.DstOff < D0 || R.DstOff > D0 + 15)
+        Ok = false;
+    }
+    if (!Ok)
+      continue;
+    SmallVector<const Rec *, 8> Even, Odd;
+    for (const Rec &R : Recs) {
+      int64_t Rel = R.DstOff - D0;
+      if ((Rel & 1) == 0)
+        Even.push_back(&R);
+      else
+        Odd.push_back(&R);
+    }
+    if (Even.size() != 8 || Odd.size() != 8)
+      continue;
+    llvm::sort(Even, [](const Rec *A, const Rec *B) {
+      return A->DstOff < B->DstOff;
+    });
+    llvm::sort(Odd, [](const Rec *A, const Rec *B) {
+      return A->DstOff < B->DstOff;
+    });
+    Value *SrcE = Even[0]->SrcBase;
+    Value *SrcO = Odd[0]->SrcBase;
+    if (SrcE == SrcO)
+      continue;
+    for (unsigned I = 0; I < 8; ++I) {
+      if (Even[I]->DstOff != D0 + static_cast<int64_t>(2 * I) ||
+          Odd[I]->DstOff != D0 + static_cast<int64_t>(2 * I + 1) ||
+          Even[I]->SrcBase != SrcE || Odd[I]->SrcBase != SrcO ||
+          Even[I]->SrcOff != Even[0]->SrcOff + static_cast<int64_t>(I) ||
+          Odd[I]->SrcOff != Odd[0]->SrcOff + static_cast<int64_t>(I)) {
+        Ok = false;
+        break;
+      }
+    }
+    if (!Ok)
+      continue;
+    Instruction *InsertAt = Recs[0].SI;
+    for (const Rec &R : Recs)
+      if (R.SI->comesBefore(InsertAt))
+        InsertAt = R.SI;
+    if (!valueDominatesInBB(Dst, *InsertAt) ||
+        !valueDominatesInBB(SrcE, *InsertAt) ||
+        !valueDominatesInBB(SrcO, *InsertAt))
+      continue;
+    IRBuilder<> Bld(InsertAt);
+    auto *I8Ty = Type::getInt8Ty(F.getContext());
+    auto *V8 = FixedVectorType::get(I8Ty, 8);
+    Value *PE =
+        Even[0]->SrcOff
+            ? Bld.CreateInBoundsGEP(I8Ty, SrcE, Bld.getInt64(Even[0]->SrcOff),
+                                    "loong.int.pe")
+            : SrcE;
+    Value *PO =
+        Odd[0]->SrcOff
+            ? Bld.CreateInBoundsGEP(I8Ty, SrcO, Bld.getInt64(Odd[0]->SrcOff),
+                                    "loong.int.po")
+            : SrcO;
+    Value *VE = Bld.CreateAlignedLoad(V8, PE, Align(1), "loong.int.e");
+    Value *VO = Bld.CreateAlignedLoad(V8, PO, Align(1), "loong.int.o");
+    SmallVector<int, 16> Mask;
+    for (int I = 0; I < 8; ++I) {
+      Mask.push_back(I);
+      Mask.push_back(8 + I);
+    }
+    Value *Mix = Bld.CreateShuffleVector(VE, VO, Mask, "loong.int.mix");
+    Value *PD =
+        D0 ? Bld.CreateInBoundsGEP(I8Ty, Dst, Bld.getInt64(D0), "loong.int.d")
+           : Dst;
+    Bld.CreateAlignedStore(Mix, PD, Align(1));
+    for (const Rec &R : Recs)
+      R.SI->eraseFromParent();
+    Changed = true;
+    ++NumI8Interleave;
+  }
+  return Changed;
+}
+
+static bool matchStride2IVK(Value *Ptr, PHINode *IV, Value *&Base, int64_t &K) {
+  Value *B = nullptr;
+  int64_t Off = 0;
+  splitConstByteGEP(Ptr, B, Off);
+  auto takeShl = [&](Value *Idx) -> bool {
+    ConstantInt *C = nullptr;
+    if (match(Idx, m_Shl(m_Specific(IV), m_One())) ||
+        match(Idx, m_Add(m_Specific(IV), m_Specific(IV))) ||
+        match(Idx, m_Mul(m_Specific(IV), m_SpecificInt(2)))) {
+      K = Off;
+      return true;
+    }
+    if (match(Idx, m_Add(m_Shl(m_Specific(IV), m_One()), m_ConstantInt(C))) ||
+        match(Idx, m_Add(m_ConstantInt(C), m_Shl(m_Specific(IV), m_One())))) {
+      K = Off + C->getSExtValue();
+      return true;
+    }
+    if (match(Idx, m_Or(m_Shl(m_Specific(IV), m_One()), m_One())) ||
+        match(Idx, m_Or(m_Add(m_Specific(IV), m_Specific(IV)), m_One()))) {
+      K = Off + 1;
+      return true;
+    }
+    return false;
+  };
+  if (auto *G = dyn_cast<GetElementPtrInst>(B)) {
+    if (G->getNumIndices() == 1 && takeShl(G->getOperand(1))) {
+      Base = G->getPointerOperand()->stripPointerCasts();
+      return K >= 0 && K <= 3;
+    }
+  }
+  return false;
+}
+
+static bool matchUnitIVOff(Value *Ptr, PHINode *IV, Value *&Base, int64_t &Off) {
+  Value *B = nullptr;
+  int64_t O = 0;
+  splitConstByteGEP(Ptr, B, O);
+  if (auto *G = dyn_cast<GetElementPtrInst>(B)) {
+    if (G->getNumIndices() == 1 && G->getOperand(1) == IV) {
+      Base = G->getPointerOperand()->stripPointerCasts();
+      Off = O;
+      return Off == 0;
+    }
+  }
+  return false;
+}
+
+static Value *emitEvenOddI8(IRBuilder<> &B, Value *V16, bool Even) {
+  SmallVector<int, 8> M;
+  for (int I = 0; I < 8; ++I)
+    M.push_back(Even ? 2 * I : 2 * I + 1);
+  return B.CreateShuffleVector(V16, M, Even ? "loong.even" : "loong.odd");
+}
+
+static bool definedOutsideBlock(Value *V, BasicBlock *BB) {
+  if (!V)
+    return false;
+  if (isa<Argument>(V) || isa<Constant>(V))
+    return true;
+  auto *I = dyn_cast<Instruction>(V);
+  return I && I->getParent() && I->getParent() != BB;
+}
+
+static void retargetPhiIncoming(BasicBlock *BB, BasicBlock *From,
+                                BasicBlock *To) {
+  for (PHINode &PN : BB->phis()) {
+    int Idx = PN.getBasicBlockIndex(From);
+    if (Idx >= 0)
+      PN.setIncomingBlock(Idx, To);
+  }
+}
+
+/// Remainder bodies are do-while (work, then inc==trip). If N8==Trip the
+/// vector loop already covered every iteration; branching into the remainder
+/// would execute one OOB iteration at iv==width.
+static bool remainderExitPhisSafe(BasicBlock *Rem, BasicBlock *Exit) {
+  for (PHINode &PN : Exit->phis()) {
+    int Idx = PN.getBasicBlockIndex(Rem);
+    if (Idx < 0)
+      return false;
+    if (!definedOutsideBlock(PN.getIncomingValue(Idx), Rem))
+      return false;
+  }
+  return true;
+}
+
+static BasicBlock *emitRemainderGuard(Function &F, BasicBlock *Rem,
+                                      BasicBlock *Exit, Value *N8, Value *Trip,
+                                      const Twine &Name) {
+  BasicBlock *RemPH = BasicBlock::Create(F.getContext(), Name, &F, Rem);
+  IRBuilder<> B(RemPH);
+  Value *T = Trip;
+  if (T->getType() != N8->getType()) {
+    if (T->getType()->getIntegerBitWidth() < N8->getType()->getIntegerBitWidth())
+      T = B.CreateZExt(T, N8->getType());
+    else
+      T = B.CreateTrunc(T, N8->getType());
+  }
+  B.CreateCondBr(B.CreateICmpEQ(N8, T), Exit, Rem);
+  for (PHINode &PN : Exit->phis()) {
+    int Idx = PN.getBasicBlockIndex(Rem);
+    if (Idx >= 0)
+      PN.addIncoming(PN.getIncomingValue(Idx), RemPH);
+  }
+  return RemPH;
+}
+
+static bool blockHasVectorInst(BasicBlock &BB) {
+  for (Instruction &I : BB)
+    if (I.getType()->isVectorTy() ||
+        (isa<StoreInst>(I) &&
+         cast<StoreInst>(I).getValueOperand()->getType()->isVectorTy()) ||
+        (isa<LoadInst>(I) && I.getType()->isVectorTy()))
+      return true;
+  return false;
+}
+
+// CreateVectorSplat may insert freeze; LoongArch ISel crashes on freeze of a
+// value that is not yet in FunctionLoweringInfo after CFG rewrites.
+static Value *splatNoFreeze(IRBuilder<> &B, Value *S, unsigned N) {
+  auto *VTy = FixedVectorType::get(S->getType(), N);
+  Value *Ins =
+      B.CreateInsertElement(PoisonValue::get(VTy), S, B.getInt64(0));
+  SmallVector<int, 16> Zeros(N, 0);
+  return B.CreateShuffleVector(Ins, Zeros);
+}
+
+static Value *emitBilinearPacked(IRBuilder<> &B, Value *A, Value *C, Value *E,
+                                 Value *G, Value *CA, Value *CB, Value *CC,
+                                 Value *CD) {
+  auto *V8I32 = FixedVectorType::get(B.getInt32Ty(), 8);
+  Value *ZA = B.CreateZExt(A, V8I32);
+  Value *ZC = B.CreateZExt(C, V8I32);
+  Value *ZE = B.CreateZExt(E, V8I32);
+  Value *ZG = B.CreateZExt(G, V8I32);
+  Value *P = B.CreateMul(ZA, splatNoFreeze(B, CA, 8));
+  P = B.CreateAdd(P, B.CreateMul(ZC, splatNoFreeze(B, CB, 8)));
+  P = B.CreateAdd(P, B.CreateMul(ZE, splatNoFreeze(B, CC, 8)));
+  P = B.CreateAdd(P, B.CreateMul(ZG, splatNoFreeze(B, CD, 8)));
+  P = B.CreateAdd(P, ConstantInt::get(V8I32, 32));
+  P = B.CreateLShr(P, ConstantInt::get(V8I32, 6));
+  return B.CreateTrunc(P, FixedVectorType::get(B.getInt8Ty(), 8));
+}
+
+static Value *emitBilinearV8(IRBuilder<> &B, Value *S0, Value *S1, Value *T0,
+                             Value *T1, Value *CA, Value *CB, Value *CC,
+                             Value *CD, bool Even) {
+  return emitBilinearPacked(B, emitEvenOddI8(B, S0, Even),
+                            emitEvenOddI8(B, S1, Even),
+                            emitEvenOddI8(B, T0, Even),
+                            emitEvenOddI8(B, T1, Even), CA, CB, CC, CD);
+}
+
+static bool tryRewriteChromaBilinearInner(Function &F,
+                                          const LoongArchSubtarget &ST) {
+  if (!ST.hasExtLASX())
+    return false;
+  bool Changed = false;
+  for (BasicBlock &BB : F) {
+    auto *Br = dyn_cast<BranchInst>(BB.getTerminator());
+    if (!Br || !Br->isConditional())
+      continue;
+    unsigned Back = Br->getSuccessor(0) == &BB
+                        ? 0
+                        : (Br->getSuccessor(1) == &BB ? 1 : 2);
+    if (Back > 1)
+      continue;
+    PHINode *IV = nullptr;
+    BasicBlock *Pre = nullptr;
+    for (PHINode &PN : BB.phis()) {
+      if (!PN.getType()->isIntegerTy())
+        continue;
+      int IncIdx = PN.getBasicBlockIndex(&BB);
+      Value *Inc = IncIdx >= 0 ? PN.getIncomingValue(IncIdx) : nullptr;
+      if (!Inc)
+        continue;
+      if (!match(Inc, m_c_Add(m_Specific(&PN), m_One())))
+        continue;
+      IV = &PN;
+      for (unsigned I = 0, E = PN.getNumIncomingValues(); I < E; ++I)
+        if (PN.getIncomingBlock(I) != &BB)
+          Pre = PN.getIncomingBlock(I);
+      break;
+    }
+    if (!IV || !Pre || Pre == &BB)
+      continue;
+    auto *Cmp = dyn_cast<ICmpInst>(Br->getCondition());
+    if (!Cmp || Cmp->getPredicate() != ICmpInst::ICMP_EQ)
+      continue;
+    int LatchIdx = IV->getBasicBlockIndex(&BB);
+    Value *Inc = LatchIdx >= 0 ? IV->getIncomingValue(LatchIdx) : nullptr;
+    Value *Trip = nullptr;
+    if (Cmp->getOperand(0) == IV || Cmp->getOperand(0) == Inc)
+      Trip = Cmp->getOperand(1);
+    else if (Cmp->getOperand(1) == IV || Cmp->getOperand(1) == Inc)
+      Trip = Cmp->getOperand(0);
+    if (!Trip)
+      continue;
+
+    Value *SrcA = nullptr, *SrcB = nullptr;
+    Value *DstU = nullptr, *DstV = nullptr;
+    Value *Coeff[4] = {};
+    unsigned NLoad = 0, NStore = 0;
+    bool Ok = true;
+    for (Instruction &I : BB) {
+      if (auto *Ld = dyn_cast<LoadInst>(&I)) {
+        if (!Ld->getType()->isIntegerTy(8)) {
+          Ok = false;
+          break;
+        }
+        Value *Base = nullptr;
+        int64_t K = 0;
+        if (!matchStride2IVK(Ld->getPointerOperand(), IV, Base, K)) {
+          Ok = false;
+          break;
+        }
+        if (!SrcA)
+          SrcA = Base;
+        else if (Base != SrcA && !SrcB)
+          SrcB = Base;
+        else if (Base != SrcA && Base != SrcB) {
+          Ok = false;
+          break;
+        }
+        ++NLoad;
+      } else if (auto *SI = dyn_cast<StoreInst>(&I)) {
+        if (!SI->getValueOperand()->getType()->isIntegerTy(8)) {
+          Ok = false;
+          break;
+        }
+        Value *Base = nullptr;
+        int64_t Off = 0;
+        if (!matchUnitIVOff(SI->getPointerOperand(), IV, Base, Off) || Off) {
+          Ok = false;
+          break;
+        }
+        if (!DstU)
+          DstU = Base;
+        else if (!DstV && Base != DstU)
+          DstV = Base;
+        else if (Base != DstU && Base != DstV) {
+          Ok = false;
+          break;
+        }
+        ++NStore;
+        Value *Tr = SI->getValueOperand();
+        Value *Sh = nullptr;
+        if (auto *T = dyn_cast<TruncInst>(Tr))
+          Sh = T->getOperand(0);
+        Value *Sum = nullptr;
+        if (!Sh || !match(Sh, m_LShr(m_Value(Sum), m_SpecificInt(6)))) {
+          Ok = false;
+          break;
+        }
+        SmallVector<Value *, 8> Leaves;
+        SmallPtrSet<Value *, 16> Seen;
+        flattenI32AddTree(Sum, Leaves, Seen);
+        unsigned NMul = 0;
+        for (Value *L : Leaves) {
+          if (match(L, m_SpecificInt(32)))
+            continue;
+          Value *X = nullptr, *Y = nullptr;
+          if (!match(L, m_Mul(m_Value(X), m_Value(Y))))
+            continue;
+          Value *ZOp = isa<ZExtInst>(X) ? X : (isa<ZExtInst>(Y) ? Y : nullptr);
+          Value *Cnd = ZOp == X ? Y : X;
+          LoadInst *Ld = nullptr;
+          if (!ZOp || !matchI8ZExtLoad(ZOp, Ld)) {
+            Ok = false;
+            break;
+          }
+          Value *LB = nullptr;
+          int64_t LK = 0;
+          if (!matchStride2IVK(Ld->getPointerOperand(), IV, LB, LK)) {
+            Ok = false;
+            break;
+          }
+          if (LB == SrcA && (LK == 0 || LK == 1))
+            Coeff[0] = Cnd;
+          else if (LB == SrcA && (LK == 2 || LK == 3))
+            Coeff[1] = Cnd;
+          else if (LB == SrcB && (LK == 0 || LK == 1))
+            Coeff[2] = Cnd;
+          else if (LB == SrcB && (LK == 2 || LK == 3))
+            Coeff[3] = Cnd;
+          else {
+            Ok = false;
+            break;
+          }
+          ++NMul;
+        }
+        if (NMul != 4) {
+          Ok = false;
+          break;
+        }
+      }
+    }
+    if (!Ok || NLoad != 8 || NStore != 2 || !SrcA || !SrcB || !DstU || !DstV)
+      continue;
+    if (!Coeff[0] || !Coeff[1] || !Coeff[2] || !Coeff[3])
+      continue;
+    if (blockHasVectorInst(BB))
+      continue;
+    if (IV->getIncomingValueForBlock(Pre) !=
+        ConstantInt::get(IV->getType(), 0))
+      continue;
+    if (!definedOutsideBlock(Trip, &BB) || !definedOutsideBlock(SrcA, &BB) ||
+        !definedOutsideBlock(SrcB, &BB) || !definedOutsideBlock(DstU, &BB) ||
+        !definedOutsideBlock(DstV, &BB))
+      continue;
+    bool CoeffOk = true;
+    for (int CI = 0; CI < 4; ++CI)
+      if (!definedOutsideBlock(Coeff[CI], &BB))
+        CoeffOk = false;
+    if (!CoeffOk)
+      continue;
+
+    auto *PHBr = dyn_cast<BranchInst>(Pre->getTerminator());
+    if (!PHBr || !PHBr->isUnconditional() || PHBr->getSuccessor(0) != &BB)
+      continue;
+    BasicBlock *Exit = Br->getSuccessor(1 - Back);
+    if (!Exit || !remainderExitPhisSafe(&BB, Exit))
+      continue;
+
+    LLVMContext &Ctx = F.getContext();
+    // N8 must live in Pre so the vector header can start with a PHI.
+    IRBuilder<> PreBld(PHBr);
+    Value *N8 = PreBld.CreateAnd(Trip, ConstantInt::get(Trip->getType(), -8),
+                                 "loong.chroma.n8");
+    if (N8->getType() != IV->getType()) {
+      if (N8->getType()->getIntegerBitWidth() <
+          IV->getType()->getIntegerBitWidth())
+        N8 = PreBld.CreateZExt(N8, IV->getType(), "loong.chroma.n8z");
+      else
+        N8 = PreBld.CreateTrunc(N8, IV->getType(), "loong.chroma.n8t");
+    }
+    BasicBlock *Vec = BasicBlock::Create(Ctx, "loong.chroma.vec", &F, &BB);
+    BasicBlock *VecBody =
+        BasicBlock::Create(Ctx, "loong.chroma.body", &F, &BB);
+    BasicBlock *RemPH =
+        emitRemainderGuard(F, &BB, Exit, N8, Trip, "loong.chroma.rem");
+    PHBr->setSuccessor(0, Vec);
+
+    IRBuilder<> PBld(Vec);
+    PHINode *IV8 = PBld.CreatePHI(IV->getType(), 2, "loong.chroma.iv");
+    IV8->addIncoming(ConstantInt::get(IV->getType(), 0), Pre);
+    Value *Eq = PBld.CreateICmpEQ(IV8, N8, "loong.chroma.done");
+    PBld.CreateCondBr(Eq, RemPH, VecBody);
+
+    IRBuilder<> VBld(VecBody);
+    auto *I8Ty = Type::getInt8Ty(Ctx);
+    Value *Off = VBld.CreateShl(IV8, 1, "loong.chroma.off");
+    Value *PA = VBld.CreateInBoundsGEP(I8Ty, SrcA, Off, "loong.chroma.a");
+    Value *PBs = VBld.CreateInBoundsGEP(I8Ty, SrcB, Off, "loong.chroma.b");
+    auto *V16 = FixedVectorType::get(I8Ty, 16);
+    Value *S0 = VBld.CreateAlignedLoad(V16, PA, Align(1), "loong.chroma.s0");
+    Value *T0 = VBld.CreateAlignedLoad(V16, PBs, Align(1), "loong.chroma.t0");
+    // S1/T1 even/odd need bytes off+16 and off+17, not a 16-byte load at +2.
+    auto plus2EvenOdd = [&](Value *V0, Value *Base, bool Even) {
+      Value *P16 = VBld.CreateInBoundsGEP(I8Ty, Base,
+                                          VBld.CreateAdd(Off, VBld.getInt64(16)),
+                                          "loong.chroma.p16");
+      Value *W16 = VBld.CreateAlignedLoad(Type::getInt16Ty(Ctx), P16, Align(1),
+                                          "loong.chroma.w16");
+      Value *B0 = VBld.CreateTrunc(W16, I8Ty);
+      Value *B1 = VBld.CreateTrunc(VBld.CreateLShr(W16, 8), I8Ty);
+      SmallVector<int, 8> M;
+      for (int I = 0; I < 7; ++I)
+        M.push_back(Even ? 2 * I + 2 : 2 * I + 3);
+      M.push_back(M.back());
+      Value *S = VBld.CreateShuffleVector(V0, M);
+      return VBld.CreateInsertElement(S, Even ? B0 : B1, VBld.getInt64(7));
+    };
+    Value *S1e = plus2EvenOdd(S0, SrcA, true);
+    Value *S1o = plus2EvenOdd(S0, SrcA, false);
+    Value *T1e = plus2EvenOdd(T0, SrcB, true);
+    Value *T1o = plus2EvenOdd(T0, SrcB, false);
+    Value *CU = emitBilinearPacked(VBld, emitEvenOddI8(VBld, S0, true), S1e,
+                                   emitEvenOddI8(VBld, T0, true), T1e, Coeff[0],
+                                   Coeff[1], Coeff[2], Coeff[3]);
+    Value *CV = emitBilinearPacked(VBld, emitEvenOddI8(VBld, S0, false), S1o,
+                                   emitEvenOddI8(VBld, T0, false), T1o, Coeff[0],
+                                   Coeff[1], Coeff[2], Coeff[3]);
+    Value *DU = VBld.CreateInBoundsGEP(I8Ty, DstU, IV8, "loong.chroma.du");
+    Value *DV = VBld.CreateInBoundsGEP(I8Ty, DstV, IV8, "loong.chroma.dv");
+    VBld.CreateAlignedStore(CU, DU, Align(1));
+    VBld.CreateAlignedStore(CV, DV, Align(1));
+    Value *Next = VBld.CreateAdd(IV8, ConstantInt::get(IV->getType(), 8),
+                                 "loong.chroma.next");
+    VBld.CreateBr(Vec);
+    IV8->addIncoming(Next, VecBody);
+
+    retargetPhiIncoming(&BB, Pre, RemPH);
+    int PreIdx = IV->getBasicBlockIndex(RemPH);
+    if (PreIdx >= 0)
+      IV->setIncomingValue(PreIdx, N8);
+    Changed = true;
+    ++NumChromaBilinear;
+    break;
+  }
+  return Changed;
+}
+
+static bool matchNestedAvgr4(Value *V, LoadInst *L[4]) {
+  Value *T = V;
+  if (auto *Tr = dyn_cast<TruncInst>(V))
+    T = Tr->getOperand(0);
+  Value *X = nullptr, *Y = nullptr;
+  if (!(match(T, m_LShr(m_NUWAdd(m_NUWAdd(m_Value(X), m_Value(Y)), m_One()),
+                        m_One())) ||
+        match(T, m_LShr(m_NUWAdd(m_NUWAdd(m_Value(X), m_One()), m_Value(Y)),
+                        m_One()))))
+    return false;
+  LoadInst *La = nullptr, *Lb = nullptr, *Lc = nullptr, *Ld = nullptr;
+  if (!matchI8AvgrPair(X, La, Lb) || !matchI8AvgrPair(Y, Lc, Ld))
+    return false;
+  L[0] = La;
+  L[1] = Lb;
+  L[2] = Lc;
+  L[3] = Ld;
+  return true;
+}
+
+static bool tryRewriteLowresBoxInner(Function &F, const LoongArchSubtarget &ST) {
+  if (!ST.hasExtLSX())
+    return false;
+  bool Changed = false;
+  for (BasicBlock &BB : F) {
+    auto *Br = dyn_cast<BranchInst>(BB.getTerminator());
+    if (!Br || !Br->isConditional())
+      continue;
+    unsigned Back = Br->getSuccessor(0) == &BB
+                        ? 0
+                        : (Br->getSuccessor(1) == &BB ? 1 : 2);
+    if (Back > 1)
+      continue;
+    PHINode *IV = nullptr;
+    BasicBlock *Pre = nullptr;
+    for (PHINode &PN : BB.phis()) {
+      if (!PN.getType()->isIntegerTy())
+        continue;
+      int IncIdx = PN.getBasicBlockIndex(&BB);
+      Value *Inc = IncIdx >= 0 ? PN.getIncomingValue(IncIdx) : nullptr;
+      if (!Inc || !match(Inc, m_c_Add(m_Specific(&PN), m_One())))
+        continue;
+      IV = &PN;
+      for (unsigned I = 0, E = PN.getNumIncomingValues(); I < E; ++I)
+        if (PN.getIncomingBlock(I) != &BB)
+          Pre = PN.getIncomingBlock(I);
+      break;
+    }
+    if (!IV || !Pre)
+      continue;
+    auto *Cmp = dyn_cast<ICmpInst>(Br->getCondition());
+    if (!Cmp || Cmp->getPredicate() != ICmpInst::ICMP_EQ)
+      continue;
+    int LatchIdx = IV->getBasicBlockIndex(&BB);
+    Value *IncV = LatchIdx >= 0 ? IV->getIncomingValue(LatchIdx) : nullptr;
+    Value *Trip = nullptr;
+    if (Cmp->getOperand(0) == IV || Cmp->getOperand(0) == IncV)
+      Trip = Cmp->getOperand(1);
+    else if (Cmp->getOperand(1) == IV || Cmp->getOperand(1) == IncV)
+      Trip = Cmp->getOperand(0);
+    if (!Trip)
+      continue;
+    if (IV->getIncomingValueForBlock(Pre) !=
+        ConstantInt::get(IV->getType(), 0))
+      continue;
+
+    SmallVector<StoreInst *, 4> Sts;
+    for (Instruction &I : BB)
+      if (auto *SI = dyn_cast<StoreInst>(&I))
+        if (SI->getValueOperand()->getType()->isIntegerTy(8))
+          Sts.push_back(SI);
+    if (Sts.size() != 4)
+      continue;
+
+    Value *Rows[3] = {};
+    Value *Dsts[4] = {};
+    unsigned NRow = 0;
+    bool Ok = true;
+    for (unsigned S = 0; S < 4; ++S) {
+      Value *DB = nullptr;
+      int64_t DO = 0;
+      if (!matchUnitIVOff(Sts[S]->getPointerOperand(), IV, DB, DO) || DO) {
+        Ok = false;
+        break;
+      }
+      Dsts[S] = DB;
+      LoadInst *Ls[4] = {};
+      if (!matchNestedAvgr4(Sts[S]->getValueOperand(), Ls)) {
+        Ok = false;
+        break;
+      }
+      for (unsigned K = 0; K < 4; ++K) {
+        Value *RB = nullptr;
+        int64_t KK = 0;
+        if (!matchStride2IVK(Ls[K]->getPointerOperand(), IV, RB, KK) ||
+            KK > 2) {
+          Ok = false;
+          break;
+        }
+        bool Found = false;
+        for (unsigned R = 0; R < NRow; ++R)
+          if (Rows[R] == RB)
+            Found = true;
+        if (!Found) {
+          if (NRow >= 3) {
+            Ok = false;
+            break;
+          }
+          Rows[NRow++] = RB;
+        }
+      }
+      if (!Ok)
+        break;
+    }
+    if (!Ok || NRow != 3)
+      continue;
+    for (unsigned I = 0; I < 4; ++I)
+      for (unsigned J = I + 1; J < 4; ++J)
+        if (Dsts[I] == Dsts[J])
+          Ok = false;
+    if (!Ok)
+      continue;
+
+    Value *Src0 = nullptr, *Src1 = nullptr, *Src2 = nullptr;
+    for (unsigned I = 0; I < 3; ++I) {
+      auto *G = dyn_cast<GetElementPtrInst>(Rows[I]);
+      if (!G) {
+        Src0 = Rows[I];
+        continue;
+      }
+      Value *P = G->getPointerOperand()->stripPointerCasts();
+      bool ParentIn = false;
+      for (unsigned J = 0; J < 3; ++J)
+        if (Rows[J] == P)
+          ParentIn = true;
+      if (!ParentIn)
+        Src0 = Rows[I];
+    }
+    if (!Src0)
+      continue;
+    for (unsigned I = 0; I < 3; ++I) {
+      auto *G = dyn_cast<GetElementPtrInst>(Rows[I]);
+      if (!G)
+        continue;
+      Value *P = G->getPointerOperand()->stripPointerCasts();
+      if (P == Src0)
+        Src1 = Rows[I];
+    }
+    for (unsigned I = 0; I < 3; ++I) {
+      auto *G = dyn_cast<GetElementPtrInst>(Rows[I]);
+      if (!G)
+        continue;
+      Value *P = G->getPointerOperand()->stripPointerCasts();
+      if (P == Src1)
+        Src2 = Rows[I];
+    }
+    if (!Src1 || !Src2)
+      continue;
+
+    Value *DstMap[4] = {};
+    for (unsigned S = 0; S < 4; ++S) {
+      LoadInst *Ls[4] = {};
+      if (!matchNestedAvgr4(Sts[S]->getValueOperand(), Ls))
+        continue;
+      bool U0 = false, U1 = false, U2 = false;
+      int64_t MinK = 99, MaxK = -1;
+      for (unsigned K = 0; K < 4; ++K) {
+        Value *RB = nullptr;
+        int64_t KK = 0;
+        if (!matchStride2IVK(Ls[K]->getPointerOperand(), IV, RB, KK))
+          continue;
+        if (RB == Src0)
+          U0 = true;
+        if (RB == Src1)
+          U1 = true;
+        if (RB == Src2)
+          U2 = true;
+        MinK = std::min(MinK, KK);
+        MaxK = std::max(MaxK, KK);
+      }
+      int Kind = -1;
+      if (U0 && U1 && !U2 && MinK == 0 && MaxK == 1)
+        Kind = 0;
+      else if (U0 && U1 && !U2 && MinK == 1 && MaxK == 2)
+        Kind = 1;
+      else if (!U0 && U1 && U2 && MinK == 0 && MaxK == 1)
+        Kind = 2;
+      else if (!U0 && U1 && U2 && MinK == 1 && MaxK == 2)
+        Kind = 3;
+      if (Kind < 0 || DstMap[Kind]) {
+        Ok = false;
+        break;
+      }
+      DstMap[Kind] = Dsts[S];
+    }
+    if (!Ok || !DstMap[0] || !DstMap[1] || !DstMap[2] || !DstMap[3])
+      continue;
+    if (blockHasVectorInst(BB))
+      continue;
+    if (!definedOutsideBlock(Trip, &BB) || !definedOutsideBlock(Src0, &BB) ||
+        !definedOutsideBlock(Src1, &BB) || !definedOutsideBlock(Src2, &BB) ||
+        !definedOutsideBlock(DstMap[0], &BB) ||
+        !definedOutsideBlock(DstMap[1], &BB) ||
+        !definedOutsideBlock(DstMap[2], &BB) ||
+        !definedOutsideBlock(DstMap[3], &BB))
+      continue;
+    Rows[0] = Src0;
+    Rows[1] = Src1;
+    Rows[2] = Src2;
+    for (unsigned I = 0; I < 4; ++I)
+      Dsts[I] = DstMap[I];
+
+    auto *PHBr = dyn_cast<BranchInst>(Pre->getTerminator());
+    if (!PHBr || !PHBr->isUnconditional() || PHBr->getSuccessor(0) != &BB)
+      continue;
+    BasicBlock *Exit = Br->getSuccessor(1 - Back);
+    if (!Exit || !remainderExitPhisSafe(&BB, Exit))
+      continue;
+
+    LLVMContext &Ctx = F.getContext();
+    IRBuilder<> PreBld(PHBr);
+    Value *N8 = PreBld.CreateAnd(Trip, ConstantInt::get(Trip->getType(), -8),
+                                 "loong.lowres.n8");
+    if (N8->getType() != IV->getType()) {
+      if (N8->getType()->getIntegerBitWidth() <
+          IV->getType()->getIntegerBitWidth())
+        N8 = PreBld.CreateZExt(N8, IV->getType(), "loong.lowres.n8z");
+      else
+        N8 = PreBld.CreateTrunc(N8, IV->getType(), "loong.lowres.n8t");
+    }
+    BasicBlock *Vec = BasicBlock::Create(Ctx, "loong.lowres.vec", &F, &BB);
+    BasicBlock *VecBody =
+        BasicBlock::Create(Ctx, "loong.lowres.body", &F, &BB);
+    BasicBlock *RemPH =
+        emitRemainderGuard(F, &BB, Exit, N8, Trip, "loong.lowres.rem");
+    PHBr->setSuccessor(0, Vec);
+    IRBuilder<> PBld(Vec);
+    PHINode *IV8 = PBld.CreatePHI(IV->getType(), 2, "loong.lowres.iv");
+    IV8->addIncoming(ConstantInt::get(IV->getType(), 0), Pre);
+    PBld.CreateCondBr(PBld.CreateICmpEQ(IV8, N8), RemPH, VecBody);
+
+    IRBuilder<> VBld(VecBody);
+    auto *I8Ty = Type::getInt8Ty(Ctx);
+    auto *V16 = FixedVectorType::get(I8Ty, 16);
+    auto *V8I16 = FixedVectorType::get(Type::getInt16Ty(Ctx), 8);
+    Value *Off = VBld.CreateShl(IV8, 1, "loong.lowres.off");
+    auto loadRow = [&](Value *Row, int64_t Extra) {
+      Value *P = VBld.CreateInBoundsGEP(I8Ty, Row, Off, "loong.lowres.p");
+      if (Extra)
+        P = VBld.CreateInBoundsGEP(I8Ty, P, VBld.getInt64(Extra),
+                                   "loong.lowres.pe");
+      return VBld.CreateAlignedLoad(V16, P, Align(1), "loong.lowres.ld");
+    };
+    Value *R0 = loadRow(Rows[0], 0);
+    Value *R1 = loadRow(Rows[1], 0);
+    Value *R2 = loadRow(Rows[2], 0);
+    // Even of a load at off+2 is bytes 2,4,...,14 of the 16-byte load plus
+    // the single byte at off+16. A 16-byte load at off+2 over-reads ~14
+    // bytes past the scalar kernel (SIGSEGV on the last row).
+    auto evenFromPlus2 = [&](Value *V0, Value *Row) {
+      Value *P16 = VBld.CreateInBoundsGEP(
+          I8Ty, Row, VBld.CreateAdd(Off, VBld.getInt64(16)), "loong.lowres.p16");
+      Value *B16 =
+          VBld.CreateAlignedLoad(I8Ty, P16, Align(1), "loong.lowres.b16");
+      SmallVector<int, 8> M = {2, 4, 6, 8, 10, 12, 14, 14};
+      Value *S = VBld.CreateShuffleVector(V0, M, "loong.lowres.e2");
+      return VBld.CreateInsertElement(S, B16, VBld.getInt64(7),
+                                      "loong.lowres.e2i");
+    };
+    auto avgr8 = [&](Value *A8, Value *B8) {
+      Value *ZA = VBld.CreateZExt(A8, V8I16);
+      Value *ZB = VBld.CreateZExt(B8, V8I16);
+      return emitVAvgrHU(VBld, ZA, ZB, ST.hasExtLASX());
+    };
+    auto pack = [&](Value *AvgI16) {
+      return VBld.CreateTrunc(AvgI16, FixedVectorType::get(I8Ty, 8));
+    };
+    Value *E0 = emitEvenOddI8(VBld, R0, true);
+    Value *O0 = emitEvenOddI8(VBld, R0, false);
+    Value *E1 = emitEvenOddI8(VBld, R1, true);
+    Value *O1 = emitEvenOddI8(VBld, R1, false);
+    Value *E2 = emitEvenOddI8(VBld, R2, true);
+    Value *O2 = emitEvenOddI8(VBld, R2, false);
+    Value *E0s = evenFromPlus2(R0, Rows[0]);
+    Value *E1s = evenFromPlus2(R1, Rows[1]);
+    Value *E2s = evenFromPlus2(R2, Rows[2]);
+    Value *Out[4];
+    Out[0] = pack(avgr8(pack(avgr8(E0, E1)), pack(avgr8(O0, O1))));
+    Out[1] = pack(avgr8(pack(avgr8(O0, O1)), pack(avgr8(E0s, E1s))));
+    Out[2] = pack(avgr8(pack(avgr8(E1, E2)), pack(avgr8(O1, O2))));
+    Out[3] = pack(avgr8(pack(avgr8(O1, O2)), pack(avgr8(E1s, E2s))));
+
+    for (unsigned S = 0; S < 4; ++S) {
+      Value *DP =
+          VBld.CreateInBoundsGEP(I8Ty, Dsts[S], IV8, "loong.lowres.d");
+      VBld.CreateAlignedStore(Out[S], DP, Align(1));
+    }
+    Value *Next = VBld.CreateAdd(IV8, ConstantInt::get(IV->getType(), 8),
+                                 "loong.lowres.next");
+    VBld.CreateBr(Vec);
+    IV8->addIncoming(Next, VecBody);
+    retargetPhiIncoming(&BB, Pre, RemPH);
+    int PreIdx = IV->getBasicBlockIndex(RemPH);
+    if (PreIdx >= 0)
+      IV->setIncomingValue(PreIdx, N8);
+    Changed = true;
+    ++NumLowresBox;
+    break;
+  }
+  return Changed;
+}
