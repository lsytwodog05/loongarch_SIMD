+} // namespace
+
+PreservedAnalyses LoongArchVectorIdiomPass::run(Function &F,
+                                                FunctionAnalysisManager &AM) {
+  if (!EnableLoongArchVectorIdiom || !TM)
+    return PreservedAnalyses::all();
+
+  const LoongArchSubtarget *ST = TM->getSubtargetImpl(F);
+  if (!ST || !ST->hasExtLSX())
+    return PreservedAnalyses::all();
+
+  bool Changed = false;
+  // Collect candidate instructions first; we mutate IR during iteration.
+  SmallVector<Instruction *, 16> Worklist;
+  for (BasicBlock &BB : F)
+    for (Instruction &I : BB)
+      if (I.getOpcode() == Instruction::LShr)
+        Worklist.push_back(&I);
+
+  for (Instruction *I : Worklist)
+    if (I->getParent())
+      Changed |= tryFoldAverageLshr(*I, *ST);
+
+  // Whole-kernel SWAR SATD/sa8d/hadamard_ac first. Do not run the
+  // extract/insert pack+abs2 rewrites: those keep Hadamard scalar and
+  // regress x264 vs a pure C SATD.
+  bool ChangedCFG = tryRewriteSA8D8x8(F, *ST);
+  Changed |= ChangedCFG;
+  Changed |= tryRewriteHadamardAC(F, *ST);
+  SmallVector<Instruction *, 16> SATDWork;
+  for (Instruction &Inst : instructions(F))
+    if (Inst.getOpcode() == Instruction::LShr)
+      SATDWork.push_back(&Inst);
+  for (Instruction *Inst : SATDWork)
+    if (Inst->getParent())
+      Changed |= tryRewriteSWARSATD(*Inst, *ST);
+
+  Changed |= tryRewriteI8AbsDiffRows(F, *ST);
+  Changed |= tryRewriteSub4x4DCT(F, *ST);
+  Changed |= tryRewriteI8AvgrRows(F, *ST);
+  Changed |= tryRewriteI8DeinterleaveRows(F, *ST);
+  Changed |= tryRewriteI8InterleaveRows(F, *ST);
+  bool NeedVerify = false;
+  if (tryRewriteChromaBilinearInner(F, *ST)) {
+    Changed = true;
+    ChangedCFG = true;
+    NeedVerify = true;
+  }
+  if (tryRewriteLowresBoxInner(F, *ST)) {
+    Changed = true;
+    ChangedCFG = true;
+    NeedVerify = true;
+  }
+  if (tryRewriteDeblockLumaEdge(F, *ST)) {
+    Changed = true;
+    ChangedCFG = true;
+  }
+
+  if (NeedVerify && verifyFunction(F, &errs()))
+    report_fatal_error("LoongArchVectorIdiom CFG rewrite produced invalid IR");
+
+  SmallVector<IntrinsicInst *, 8> ReduceWorklist;
+  for (Instruction &I : instructions(F)) {
+    auto *II = dyn_cast<IntrinsicInst>(&I);
+    if (!II)
+      continue;
+    if (II->getIntrinsicID() == Intrinsic::vector_reduce_fadd ||
+        II->getIntrinsicID() == Intrinsic::vector_reduce_fmul)
+      ReduceWorklist.push_back(II);
+  }
+  for (IntrinsicInst *II : ReduceWorklist)
+    Changed |= tryRewriteOrderedVectorReduce(*II, *ST);
+
+  if (!Changed)
+    return PreservedAnalyses::all();
+  if (ChangedCFG)
+    return PreservedAnalyses::none();
+  // We replaced loop-resident integer expressions with intrinsic calls of
+  // identical type; CFG and loop info are preserved.
+  PreservedAnalyses PA;
+  PA.preserveSet<CFGAnalyses>();
+  return PA;
+}
+
+//===----------------------------------------------------------------------===//
+// Exact FP add-recurrence → closed form (pre-LV)
+//===----------------------------------------------------------------------===//
+
+static bool isExactScaledIndex(Type *FPTy, const APFloat &Step, uint64_t MaxI) {
+  // Check that iterative add of Step from +0 equals Step*(i+1) for i in
+  // [0, MaxI). Uses APFloat round-to-nearest semantics matching IR fadd.
+  if (!FPTy->isFloatTy() && !FPTy->isDoubleTy())
+    return false;
+  APFloat Acc = APFloat::getZero(Step.getSemantics());
+  for (uint64_t I = 0; I < MaxI; ++I) {
+    APFloat Idx(Step.getSemantics());
+    Idx.convertFromAPInt(APInt(64, I + 1), /*IsSigned=*/false,
+                         APFloat::rmNearestTiesToEven);
+    APFloat Expected = Step;
+    Expected.multiply(Idx, APFloat::rmNearestTiesToEven);
+    APFloat::opStatus St =
+        Acc.add(Step, APFloat::rmNearestTiesToEven);
+    (void)St;
+    if (!Acc.bitwiseIsEqual(Expected))
+      return false;
+  }
+  return true;
+}
+
+static bool tryRewriteFPAddRecurrence(Loop &L, ScalarEvolution &SE) {
+  if (!L.isInnermost())
+    return false;
+
+  // Need a known constant max trip count small enough to validate exactness.
+  const SCEV *BTC = SE.getBackedgeTakenCount(&L);
+  if (isa<SCEVCouldNotCompute>(BTC))
+    return false;
+  auto *C = dyn_cast<SCEVConstant>(BTC);
+  if (!C)
+    return false;
+  // Trip count = backedge count + 1 for typical counted loops.
+  const APInt &BE = C->getAPInt();
+  if (BE.uge(1ull << 24))
+    return false;
+  uint64_t TripCount = BE.getZExtValue() + 1;
+
+  PHINode *RecPhi = nullptr;
+  BinaryOperator *FAdd = nullptr;
+  ConstantFP *StepC = nullptr;
+
+  for (PHINode &PN : L.getHeader()->phis()) {
+    if (!PN.getType()->isFloatingPointTy())
+      continue;
+    if (PN.getNumIncomingValues() != 2)
+      continue;
+    BasicBlock *Preheader = L.getLoopPreheader();
+    BasicBlock *Latch = L.getLoopLatch();
+    if (!Preheader || !Latch)
+      continue;
+    Value *Start = PN.getIncomingValueForBlock(Preheader);
+    Value *LatchV = PN.getIncomingValueForBlock(Latch);
+    auto *StartCF = dyn_cast<ConstantFP>(Start);
+    if (!StartCF || !StartCF->isZero())
+      continue;
+    auto *BO = dyn_cast<BinaryOperator>(LatchV);
+    if (!BO || BO->getOpcode() != Instruction::FAdd)
+      continue;
+    Value *X = BO->getOperand(0);
+    Value *Y = BO->getOperand(1);
+    ConstantFP *Step = nullptr;
+    if (X == &PN)
+      Step = dyn_cast<ConstantFP>(Y);
+    else if (Y == &PN)
+      Step = dyn_cast<ConstantFP>(X);
+    if (!Step || Step->isZero() || Step->isNaN())
+      continue;
+    // Recurrence value used in loop body is typically the FAdd result (after
+    // update). Collect both.
+    RecPhi = &PN;
+    FAdd = BO;
+    StepC = Step;
+    break;
+  }
+  if (!RecPhi || !FAdd || !StepC)
+    return false;
+
+  if (!isExactScaledIndex(RecPhi->getType(), StepC->getValueAPF(), TripCount))
+    return false;
+
+  // Need a canonical integer induction 0..N-1.
+  PHINode *IndPhi = L.getCanonicalInductionVariable();
+  if (!IndPhi) {
+    // Fall back: find i = phi [0, pre] [i+1, latch]
+    for (PHINode &PN : L.getHeader()->phis()) {
+      if (!PN.getType()->isIntegerTy())
+        continue;
+      if (PN.getNumIncomingValues() != 2)
+        continue;
+      auto *Start = dyn_cast<ConstantInt>(
+          PN.getIncomingValueForBlock(L.getLoopPreheader()));
+      if (!Start || !Start->isZero())
+        continue;
+      Value *LatchV = PN.getIncomingValueForBlock(L.getLoopLatch());
+      Value *AddOp = nullptr;
+      if (match(LatchV, m_Add(m_Specific(&PN), m_One())) ||
+          match(LatchV, m_Add(m_One(), m_Specific(&PN)))) {
+        IndPhi = &PN;
+        break;
+      }
+      (void)AddOp;
+    }
+  }
+  if (!IndPhi)
+    return false;
+
+  // Replace uses of FAdd (post-update value) with Step * uitofp(i+1).
+  // Replace uses of RecPhi inside the loop (pre-update) with Step * uitofp(i).
+  IRBuilder<> Builder(FAdd);
+  Value *IV = IndPhi;
+  Value *IVNext = Builder.CreateAdd(
+      IV, ConstantInt::get(IV->getType(), 1), IndPhi->getName() + ".next.fpiv");
+  Value *IVAsFP =
+      Builder.CreateUIToFP(IV, RecPhi->getType(), "loong.fpiv.i");
+  Value *IVNextAsFP =
+      Builder.CreateUIToFP(IVNext, RecPhi->getType(), "loong.fpiv.i1");
+  Value *ClosedCur =
+      Builder.CreateFMul(StepC, IVAsFP, "loong.fpiv.cur");
+  Value *ClosedNext =
+      Builder.CreateFMul(StepC, IVNextAsFP, "loong.fpiv.next");
+
+  // RecPhi uses in loop (except FAdd itself) → ClosedCur
+  SmallVector<Use *, 8> PhiUses;
+  for (Use &U : RecPhi->uses())
+    PhiUses.push_back(&U);
+  for (Use *U : PhiUses) {
+    if (U->getUser() == FAdd)
+      continue;
+    if (auto *UI = dyn_cast<Instruction>(U->getUser()))
+      if (L.contains(UI))
+        U->set(ClosedCur);
+  }
+
+  FAdd->replaceAllUsesWith(ClosedNext);
+  FAdd->eraseFromParent();
+  // RecPhi now only used by (removed) FAdd or LCSSA outside; clean if dead.
+  if (RecPhi->use_empty())
+    RecPhi->eraseFromParent();
+
+  ++NumFPIndVar;
+  return true;
+}
+
+/// Fold `q = S; for (N times) q *= C` into a single ConstantFP computed with
+/// the same APFloat iterated multiply as IR fmul (bit-exact). Targets TSVC
+/// s317-style constant product loops.
+static bool tryRewriteFPMulRecurrence(Loop &L, ScalarEvolution &SE) {
+  if (!L.isInnermost())
+    return false;
+
+  const SCEV *BTC = SE.getBackedgeTakenCount(&L);
+  if (isa<SCEVCouldNotCompute>(BTC))
+    return false;
+  auto *BEConst = dyn_cast<SCEVConstant>(BTC);
+  if (!BEConst)
+    return false;
+  if (BEConst->getAPInt().uge(1ull << 24))
+    return false;
+  uint64_t TripCount = BEConst->getAPInt().getZExtValue() + 1;
+
+  BasicBlock *Preheader = L.getLoopPreheader();
+  BasicBlock *Latch = L.getLoopLatch();
+  if (!Preheader || !Latch)
+    return false;
+
+  PHINode *RecPhi = nullptr;
+  BinaryOperator *FMul = nullptr;
+  ConstantFP *StartC = nullptr;
+  ConstantFP *FactorC = nullptr;
+
+  for (PHINode &PN : L.getHeader()->phis()) {
+    if (!PN.getType()->isFloatingPointTy())
+      continue;
+    if (PN.getNumIncomingValues() != 2)
+      continue;
+    auto *Start = dyn_cast<ConstantFP>(PN.getIncomingValueForBlock(Preheader));
+    Value *LatchV = PN.getIncomingValueForBlock(Latch);
+    if (!Start || Start->isNaN())
+      continue;
+    auto *BO = dyn_cast<BinaryOperator>(LatchV);
+    if (!BO || BO->getOpcode() != Instruction::FMul)
+      continue;
+    Value *X = BO->getOperand(0);
+    Value *Y = BO->getOperand(1);
+    ConstantFP *Factor = nullptr;
+    if (X == &PN)
+      Factor = dyn_cast<ConstantFP>(Y);
+    else if (Y == &PN)
+      Factor = dyn_cast<ConstantFP>(X);
+    if (!Factor || Factor->isNaN() || Factor->isZero())
+      continue;
+
+    // Require a pure mul recurrence: phi only used by this fmul; fmul only
+    // feeds back to the phi (plus LCSSA outside the loop).
+    bool Impure = false;
+    for (User *U : PN.users()) {
+      if (U == BO)
+        continue;
+      if (auto *UI = dyn_cast<Instruction>(U))
+        if (L.contains(UI)) {
+          Impure = true;
+          break;
+        }
+    }
+    if (Impure)
+      continue;
+    for (User *U : BO->users()) {
+      if (U == &PN)
+        continue;
+      if (auto *UI = dyn_cast<Instruction>(U))
+        if (L.contains(UI)) {
+          Impure = true;
+          break;
+        }
+    }
+    if (Impure)
+      continue;
+
+    RecPhi = &PN;
+    FMul = BO;
+    StartC = Start;
+    FactorC = Factor;
+    break;
+  }
+  if (!RecPhi || !FMul || !StartC || !FactorC)
+    return false;
+
+  // Bit-exact fold: Acc = Start; Acc *= Factor, N times.
+  APFloat Acc = StartC->getValueAPF();
+  const APFloat &Fac = FactorC->getValueAPF();
+  for (uint64_t I = 0; I < TripCount; ++I)
+    Acc.multiply(Fac, APFloat::rmNearestTiesToEven);
+  Constant *Folded = ConstantFP::get(RecPhi->getContext(), Acc);
+
+  // RAUW fmul first (updates phi latch + LCSSA), then drop the mul, then phi.
+  FMul->replaceAllUsesWith(Folded);
+  FMul->eraseFromParent();
+  if (!RecPhi->use_empty())
+    RecPhi->replaceAllUsesWith(Folded);
+  RecPhi->eraseFromParent();
+
+  ++NumFPMulFold;
+  return true;
+}
+
+/// True if SCEV expression contains an AddRec for \p L with a negative step
+/// (e.g. pointer a[i-j-1] as j increases).
+static bool scevHasNegativeAddRec(const SCEV *S, const Loop *L,
+                                  ScalarEvolution &SE) {
+  if (!S)
+    return false;
+  if (const auto *AR = dyn_cast<SCEVAddRecExpr>(S)) {
+    if (AR->getLoop() == L) {
+      const SCEV *Step = AR->getStepRecurrence(SE);
+      if (const auto *C = dyn_cast<SCEVConstant>(Step))
+        if (C->getAPInt().isNegative())
+          return true;
+    }
+    return scevHasNegativeAddRec(AR->getStart(), L, SE);
+  }
+  if (const auto *Add = dyn_cast<SCEVAddExpr>(S)) {
+    for (const SCEV *Op : Add->operands())
+      if (scevHasNegativeAddRec(Op, L, SE))
+        return true;
+    return false;
+  }
+  if (const auto *Mul = dyn_cast<SCEVMulExpr>(S)) {
+    for (const SCEV *Op : Mul->operands())
+      if (scevHasNegativeAddRec(Op, L, SE))
+        return true;
+    return false;
+  }
+  if (const auto *Z = dyn_cast<SCEVZeroExtendExpr>(S))
+    return scevHasNegativeAddRec(Z->getOperand(), L, SE);
+  if (const auto *N = dyn_cast<SCEVSignExtendExpr>(S))
+    return scevHasNegativeAddRec(N->getOperand(), L, SE);
+  if (const auto *T = dyn_cast<SCEVTruncateExpr>(S))
+    return scevHasNegativeAddRec(T->getOperand(), L, SE);
+  return false;
+}
+
+/// s118 indexes a[i-j-1] as GEP(base, xor(j, -1)); also accept SCEV
+/// AddRec with a negative step when InstCombine rewrote the address.
+static bool valueHasReverseIndexedLoad(Value *V, const Loop *L,
+                                       ScalarEvolution &SE) {
+  auto *LI = dyn_cast<LoadInst>(V);
+  if (!LI)
+    return false;
+
+  Value *Ptr = LI->getPointerOperand()->stripPointerCasts();
+  if (auto *GEP = dyn_cast<GetElementPtrInst>(Ptr)) {
+    for (Value *Idx : GEP->indices()) {
+      Value *X = nullptr;
+      if (match(Idx, m_c_Xor(m_Value(X), m_AllOnes()))) {
+        if (auto *I = dyn_cast<Instruction>(X))
+          if (L->contains(I))
+            return true;
+      }
+      // C - j (invariant minus loop-variant).
+      Value *A = nullptr, *B = nullptr;
+      if (match(Idx, m_Sub(m_Value(A), m_Value(B)))) {
+        if (L->isLoopInvariant(A))
+          if (auto *I = dyn_cast<Instruction>(B))
+            if (L->contains(I))
+              return true;
+      }
+    }
+  }
+
+  const SCEV *PtrS = SE.getSCEV(LI->getPointerOperand());
+  return scevHasNegativeAddRec(PtrS, L, SE);
+}
+
+static void setLoopVectorizeEnable(Loop &L, bool Enable) {
+  LLVMContext &Ctx = L.getHeader()->getContext();
+  SmallVector<Metadata *, 8> MDs;
+  MDs.push_back(nullptr); // self-ref placeholder
+
+  if (MDNode *LoopID = L.getLoopID()) {
+    for (unsigned I = 1, E = LoopID->getNumOperands(); I < E; ++I) {
+      MDNode *MD = dyn_cast<MDNode>(LoopID->getOperand(I));
+      if (!MD || MD->getNumOperands() < 1)
+        continue;
+      if (auto *S = dyn_cast<MDString>(MD->getOperand(0)))
+        if (S->getString() == "llvm.loop.vectorize.enable")
+          continue;
+      MDs.push_back(MD);
+    }
+  }
+
+  Metadata *EnableMD[] = {
+      MDString::get(Ctx, "llvm.loop.vectorize.enable"),
+      ConstantAsMetadata::get(
+          ConstantInt::get(Type::getInt1Ty(Ctx), Enable ? 1 : 0))};
+  MDs.push_back(MDNode::get(Ctx, EnableMD));
+
+  MDNode *NewLoopID = MDNode::get(Ctx, MDs);
+  NewLoopID->replaceOperandWith(0, NewLoopID);
+  L.setLoopID(NewLoopID);
+}
+
+/// Collect (X, Y) for Acc = Acc + X*Y or Acc = fmuladd(X, Y, Acc).
+static bool matchFPMulAcc(Value *LatchV, PHINode &PN, Value *&X, Value *&Y) {
+  if (auto *BO = dyn_cast<BinaryOperator>(LatchV)) {
+    if (BO->getOpcode() != Instruction::FAdd)
+      return false;
+    Value *Other = BO->getOperand(0) == &PN ? BO->getOperand(1)
+                                            : BO->getOperand(0);
+    if (Other == &PN)
+      return false;
+    return match(Other, m_FMul(m_Value(X), m_Value(Y)));
+  }
+  if (auto *II = dyn_cast<IntrinsicInst>(LatchV)) {
+    Intrinsic::ID ID = II->getIntrinsicID();
+    if (ID != Intrinsic::fmuladd && ID != Intrinsic::fma)
+      return false;
+    if (II->getArgOperand(2) != &PN)
+      return false;
+    X = II->getArgOperand(0);
+    Y = II->getArgOperand(1);
+    return true;
+  }
+  return false;
+}
+
+/// Disable LV on innermost FP reduction loops whose addend loads a value with
+/// a negative IV stride (TSVC s118). Ordered vectorization of that pattern
+/// disagrees with scalar -O3 FMA checksums, while reversed *non-reduction*
+/// loops (s1112/s112) must keep cheap vector reverses.
+static bool tryDisableReverseIndexedFPReduction(Loop &L, ScalarEvolution &SE) {
+  if (!L.isInnermost())
+    return false;
+
+  BasicBlock *Preheader = L.getLoopPreheader();
+  BasicBlock *Latch = L.getLoopLatch();
+  if (!Preheader || !Latch)
+    return false;
+
+  for (PHINode &PN : L.getHeader()->phis()) {
+    if (!PN.getType()->isFloatingPointTy())
+      continue;
+    if (PN.getNumIncomingValues() != 2)
+      continue;
+    Value *LatchV = PN.getIncomingValueForBlock(Latch);
+    Value *X = nullptr, *Y = nullptr;
+    if (!matchFPMulAcc(LatchV, PN, X, Y))
+      continue;
+    if (!valueHasReverseIndexedLoad(X, &L, SE) &&
+        !valueHasReverseIndexedLoad(Y, &L, SE))
+      continue;
+
+    setLoopVectorizeEnable(L, /*Enable=*/false);
+    ++NumRevRdxDisable;
+    return true;
+  }
+  return false;
+}
+
+/// Rewrite `select(fcmp ogt/olt Val, Phi), Val, Phi` into maxnum/minnum so LV
+/// can vectorize FP min/max without -ffast-math (TSVC s314/s316/s3113).
+static bool tryRewriteFPSelectMinMax(Loop &L) {
+  if (!L.isInnermost())
+    return false;
+  BasicBlock *Latch = L.getLoopLatch();
+  BasicBlock *Preheader = L.getLoopPreheader();
+  if (!Latch || !Preheader)
+    return false;
+
+  bool Changed = false;
+  for (PHINode &PN : L.getHeader()->phis()) {
+    if (!PN.getType()->isFloatingPointTy())
+      continue;
+    if (PN.getNumIncomingValues() != 2)
+      continue;
+    Value *LatchV = PN.getIncomingValueForBlock(Latch);
+    auto *Sel = dyn_cast<SelectInst>(LatchV);
+    if (!Sel)
+      continue;
+    auto *Cmp = dyn_cast<FCmpInst>(Sel->getCondition());
+    if (!Cmp)
+      continue;
+
+    Value *LHS = Cmp->getOperand(0);
+    Value *RHS = Cmp->getOperand(1);
+    Value *TV = Sel->getTrueValue();
+    Value *FV = Sel->getFalseValue();
+
+    // Canonical reduction: select(cmp(Phi, Val) or cmp(Val, Phi), {Phi,Val}).
+    // Operand order of the fcmp matters: (Phi > Val ? Phi : Val) is max, but
+    // (Val > Phi ? Phi : Val) is min — do not treat them as interchangeable.
+    Value *Val = nullptr;
+    Intrinsic::ID IID = Intrinsic::not_intrinsic;
+    FCmpInst::Predicate Pred = Cmp->getPredicate();
+
+    auto matchMax = [&](FCmpInst::Predicate P) {
+      return P == FCmpInst::FCMP_OGT || P == FCmpInst::FCMP_UGT;
+    };
+    auto matchMin = [&](FCmpInst::Predicate P) {
+      return P == FCmpInst::FCMP_OLT || P == FCmpInst::FCMP_ULT;
+    };
+
+    if (TV == &PN && FV != &PN) {
+      Val = FV;
+      if (LHS == &PN && RHS == Val) {
+        if (matchMax(Pred))
+          IID = Intrinsic::maxnum; // Phi > Val ? Phi : Val
+        else if (matchMin(Pred))
+          IID = Intrinsic::minnum; // Phi < Val ? Phi : Val
+      } else if (LHS == Val && RHS == &PN) {
+        if (matchMin(Pred))
+          IID = Intrinsic::maxnum; // Val < Phi ? Phi : Val
+        else if (matchMax(Pred))
+          IID = Intrinsic::minnum; // Val > Phi ? Phi : Val
+      }
+    } else if (FV == &PN && TV != &PN) {
+      Val = TV;
+      if (LHS == Val && RHS == &PN) {
+        if (matchMax(Pred))
+          IID = Intrinsic::maxnum; // Val > Phi ? Val : Phi
+        else if (matchMin(Pred))
+          IID = Intrinsic::minnum; // Val < Phi ? Val : Phi
+      } else if (LHS == &PN && RHS == Val) {
+        if (matchMin(Pred))
+          IID = Intrinsic::maxnum; // Phi < Val ? Val : Phi
+        else if (matchMax(Pred))
+          IID = Intrinsic::minnum; // Phi > Val ? Val : Phi
+      }
+    }
+    if (!Val || IID == Intrinsic::not_intrinsic)
+      continue;
+    // Val should be loop-variant (typically a load or fabs(load)).
+    if (L.isLoopInvariant(Val))
+      continue;
+
+    IRBuilder<> Builder(Sel);
+    Value *NewV = Builder.CreateBinaryIntrinsic(IID, Val, &PN, nullptr,
+                                                Sel->getName() + ".mnmx");
+    Sel->replaceAllUsesWith(NewV);
+    Sel->eraseFromParent();
+    if (Cmp->use_empty())
+      Cmp->eraseFromParent();
+    ++NumFPMinMaxCanon;
+    Changed = true;
+  }
+  return Changed;
+}
+
+static bool matchUnitStrideGEP(GetElementPtrInst *GEP, Value *Base, Value *IV,
+                               unsigned Offset, Value *&OutPtr) {
+  if (!GEP || GEP->getPointerOperand() != Base)
+    return false;
+  if (GEP->getNumIndices() != 1)
+    return false;
+  Value *Idx = GEP->getOperand(1);
+  if (Offset == 0) {
+    if (Idx != IV)
+      return false;
+  } else {
+    Value *X = nullptr;
+    ConstantInt *C = nullptr;
+    if (!match(Idx, m_Add(m_Value(X), m_ConstantInt(C))) || X != IV ||
+        !C || C->getZExtValue() != Offset)
+      return false;
+  }
+  OutPtr = GEP;
+  return true;
+}
+
+/// Reroll `for (i=0;i<N;i+=K) acc = fmuladd(a[i+k],b[i+k],acc) for k<K`
+/// into unit-stride so ordered LV can treat it like vdotr (TSVC s352).
+static bool tryRerollUnrolledDot(Loop &L) {
+  if (!L.isInnermost() || !L.getLoopLatch() || !L.getLoopPreheader())
+    return false;
+  if (!L.isLoopSimplifyForm())
+    return false;
+
+  BasicBlock *Header = L.getHeader();
+  BasicBlock *Latch = L.getLoopLatch();
+  if (Header != Latch)
+    return false; // single-block loop only
+
+  // Find integer IV with constant step S in {4,5}.
+  PHINode *IndPhi = nullptr;
+  BinaryOperator *IndNext = nullptr;
+  unsigned Step = 0;
+  for (PHINode &PN : Header->phis()) {
+    if (!PN.getType()->isIntegerTy())
+      continue;
+    Value *LatchV = PN.getIncomingValueForBlock(Latch);
+    ConstantInt *C = nullptr;
+    if (!match(LatchV, m_Add(m_Specific(&PN), m_ConstantInt(C))) &&
+        !match(LatchV, m_Add(m_ConstantInt(C), m_Specific(&PN))))
+      continue;
+    if (!C)
+      continue;
+    uint64_t S = C->getZExtValue();
+    if (S != 4 && S != 5)
+      continue;
+    auto *BO = dyn_cast<BinaryOperator>(LatchV);
+    if (!BO)
+      continue;
+    IndPhi = &PN;
+    IndNext = BO;
+    Step = static_cast<unsigned>(S);
+    break;
+  }
+  if (!IndPhi || !IndNext || Step < 2)
+    return false;
+
+  // Find FP reduction phi whose latch is a chain of `Step` fmuladds.
+  PHINode *RedPhi = nullptr;
+  SmallVector<IntrinsicInst *, 8> Chain;
+  for (PHINode &PN : Header->phis()) {
+    if (!PN.getType()->isFloatingPointTy())
+      continue;
+    Value *LatchV = PN.getIncomingValueForBlock(Latch);
+    Chain.clear();
+    Value *Cur = LatchV;
+    bool Ok = true;
+    for (unsigned K = 0; K < Step; ++K) {
+      auto *II = dyn_cast<IntrinsicInst>(Cur);
+      if (!II || II->getIntrinsicID() != Intrinsic::fmuladd) {
+        Ok = false;
+        break;
+      }
+      Chain.push_back(II);
+      Cur = II->getArgOperand(2);
+    }
+    if (!Ok || Chain.size() != Step)
+      continue;
+    // Innermost accumulator must be the phi.
+    if (Chain.back()->getArgOperand(2) != &PN)
+      continue;
+    // Chain order: Chain[0] is last (latch), Chain[Step-1] is first after phi.
+    // Reverse so Chain[k] corresponds to offset k.
+    std::reverse(Chain.begin(), Chain.end());
+    if (Chain[0]->getArgOperand(2) != &PN)
+      continue;
+    RedPhi = &PN;
+    break;
+  }
+  if (!RedPhi || Chain.size() != Step)
+    return false;
+
+  // Verify Chain[k] = fmuladd(load(A, iv+k), load(B, iv+k), prev)
+  Value *BaseA = nullptr, *BaseB = nullptr;
+  for (unsigned K = 0; K < Step; ++K) {
+    IntrinsicInst *II = Chain[K];
+    Value *Op0 = II->getArgOperand(0);
+    Value *Op1 = II->getArgOperand(1);
+    auto *L0 = dyn_cast<LoadInst>(Op0);
+    auto *L1 = dyn_cast<LoadInst>(Op1);
+    if (!L0 || !L1)
+      return false;
+    auto *G0 = dyn_cast<GetElementPtrInst>(L0->getPointerOperand());
+    auto *G1 = dyn_cast<GetElementPtrInst>(L1->getPointerOperand());
+    Value *P0 = nullptr, *P1 = nullptr;
+    if (!G0 || !G1)
+      return false;
+    if (K == 0) {
+      BaseA = G0->getPointerOperand();
+      BaseB = G1->getPointerOperand();
+    }
+    if (!matchUnitStrideGEP(G0, BaseA, IndPhi, K, P0) ||
+        !matchUnitStrideGEP(G1, BaseB, IndPhi, K, P1)) {
+      // Try swapped A/B on first iteration.
+      if (K == 0) {
+        BaseA = G1->getPointerOperand();
+        BaseB = G0->getPointerOperand();
+        if (!matchUnitStrideGEP(G1, BaseA, IndPhi, K, P0) ||
+            !matchUnitStrideGEP(G0, BaseB, IndPhi, K, P1))
+          return false;
+      } else {
+        return false;
+      }
+    }
+    Value *ExpectPrev = K == 0 ? static_cast<Value *>(RedPhi) : Chain[K - 1];
+    if (II->getArgOperand(2) != ExpectPrev)
+      return false;
+  }
+
+  // Live-out may use the last fmuladd directly (not via the phi). Retarget
+  // those uses to the reduction phi before erasing the chain tail.
+  if (RedPhi->getIncomingValueForBlock(Latch) != Chain[Step - 1])
+    return false;
+
+  RedPhi->setIncomingValueForBlock(Latch, Chain[0]);
+  // Match the usual LCSSA-less form: exit uses the latch fmuladd, not the phi
+  // (LV rejects "phi used outside" here as a non-reduction escape).
+  Chain[Step - 1]->replaceUsesWithIf(Chain[0], [&](Use &U) {
+    if (U.getUser() == RedPhi)
+      return false;
+    if (auto *UI = dyn_cast<Instruction>(U.getUser()))
+      return !L.contains(UI);
+    return true;
+  });
+
+  for (int K = static_cast<int>(Step) - 1; K >= 1; --K) {
+    IntrinsicInst *II = Chain[K];
+    if (!II->use_empty()) {
+      // Roll back reduction latch.
+      RedPhi->setIncomingValueForBlock(Latch, Chain[Step - 1]);
+      return false;
+    }
+    II->eraseFromParent();
+  }
+
+  // Mutate IV increment in place (preserve the instruction identity).
+  if (IndNext->getOperand(0) == IndPhi)
+    IndNext->setOperand(1, ConstantInt::get(IndPhi->getType(), 1));
+  else
+    IndNext->setOperand(0, ConstantInt::get(IndPhi->getType(), 1));
+
+  auto *Br = dyn_cast<BranchInst>(Latch->getTerminator());
+  if (Br && Br->isConditional()) {
+    if (auto *Cmp = dyn_cast<ICmpInst>(Br->getCondition())) {
+      ConstantInt *Bound = nullptr;
+      unsigned BoundOp = 0;
+      if (Cmp->getOperand(0) == IndPhi) {
+        Bound = dyn_cast<ConstantInt>(Cmp->getOperand(1));
+        BoundOp = 1;
+      } else if (Cmp->getOperand(1) == IndPhi) {
+        Bound = dyn_cast<ConstantInt>(Cmp->getOperand(0));
+        BoundOp = 0;
+      }
+      if (Bound)
+        Cmp->setOperand(
+            BoundOp,
+            ConstantInt::get(Bound->getType(), Bound->getValue() + (Step - 1)));
+    }
+  }
+
+  for (Instruction &I : make_early_inc_range(*Header)) {
+    if (isa<PHINode>(I) || I.isTerminator())
+      continue;
+    RecursivelyDeleteTriviallyDeadInstructions(&I);
+  }
+
+  ++NumStrideReroll;
+  return true;
+}
+
+/// Reroll unrolled saxpy `a[i+k]+=alpha*b[i+k]` for k in 0..S-1, step S
+/// (TSVC s351) into unit stride.
+static bool tryRerollUnrolledSaxpy(Loop &L) {
+  if (!L.isInnermost() || !L.getLoopLatch() || !L.getLoopPreheader())
+    return false;
+  if (!L.isLoopSimplifyForm())
+    return false;
+  BasicBlock *Header = L.getHeader();
+  BasicBlock *Latch = L.getLoopLatch();
+  if (Header != Latch)
+    return false;
+
+  PHINode *IndPhi = nullptr;
+  BinaryOperator *IndNext = nullptr;
+  unsigned Step = 0;
+  for (PHINode &PN : Header->phis()) {
+    if (!PN.getType()->isIntegerTy())
+      continue;
+    Value *LatchV = PN.getIncomingValueForBlock(Latch);
+    ConstantInt *C = nullptr;
+    if (!match(LatchV, m_Add(m_Specific(&PN), m_ConstantInt(C))) &&
+        !match(LatchV, m_Add(m_ConstantInt(C), m_Specific(&PN))))
+      continue;
+    if (!C)
+      continue;
+    uint64_t S = C->getZExtValue();
+    if (S != 4 && S != 5)
+      continue;
+    auto *BO = dyn_cast<BinaryOperator>(LatchV);
+    if (!BO)
+      continue;
+    IndPhi = &PN;
+    IndNext = BO;
+    Step = static_cast<unsigned>(S);
+    break;
+  }
+  if (!IndPhi || !IndNext || Step < 2)
+    return false;
+
+  // Collect Step stores of fmuladd(alpha, load b[iv+k], load a[iv+k]) → a[iv+k]
+  SmallVector<StoreInst *, 8> Stores;
+  Value *Alpha = nullptr;
+  Value *BaseA = nullptr, *BaseB = nullptr;
+  for (Instruction &I : *Header) {
+    auto *St = dyn_cast<StoreInst>(&I);
+    if (!St)
+      continue;
+    auto *II = dyn_cast<IntrinsicInst>(St->getValueOperand());
+    if (!II || II->getIntrinsicID() != Intrinsic::fmuladd)
+      continue;
+    Stores.push_back(St);
+  }
+  if (Stores.size() != Step)
+    return false;
+
+  // Order stores by offset k.
+  SmallVector<StoreInst *, 8> Ordered(Step, nullptr);
+  for (StoreInst *St : Stores) {
+    auto *II = cast<IntrinsicInst>(St->getValueOperand());
+    auto *GEP = dyn_cast<GetElementPtrInst>(
+        St->getPointerOperand()->stripPointerCasts());
+    if (!GEP)
+      return false;
+    Value *Idx = GEP->getOperand(GEP->getNumOperands() - 1);
+    unsigned Off = 0;
+    if (Idx == IndPhi) {
+      Off = 0;
+    } else {
+      Value *X = nullptr;
+      ConstantInt *C = nullptr;
+      if (!match(Idx, m_Add(m_Value(X), m_ConstantInt(C))) || X != IndPhi || !C)
+        return false;
+      Off = C->getZExtValue();
+    }
+    if (Off >= Step || Ordered[Off])
+      return false;
+
+    Value *A0 = II->getArgOperand(0);
+    Value *A1 = II->getArgOperand(1);
+    Value *A2 = II->getArgOperand(2);
+    // fmuladd(alpha, b, a) or fmuladd(b, alpha, a)
+    Value *BLoad = nullptr, *ALoad = nullptr;
+    if (L.isLoopInvariant(A0)) {
+      if (!Alpha)
+        Alpha = A0;
+      else if (Alpha != A0)
+        return false;
+      BLoad = A1;
+      ALoad = A2;
+    } else if (L.isLoopInvariant(A1)) {
+      if (!Alpha)
+        Alpha = A1;
+      else if (Alpha != A1)
+        return false;
+      BLoad = A0;
+      ALoad = A2;
+    } else {
+      return false;
+    }
+    auto *LB = dyn_cast<LoadInst>(BLoad);
+    auto *LA = dyn_cast<LoadInst>(ALoad);
+    if (!LB || !LA)
+      return false;
+    auto *GB = dyn_cast<GetElementPtrInst>(LB->getPointerOperand());
+    auto *GA = dyn_cast<GetElementPtrInst>(LA->getPointerOperand());
+    if (!GB || !GA)
+      return false;
+    if (Off == 0) {
+      BaseB = GB->getPointerOperand();
+      BaseA = GA->getPointerOperand();
+    }
+    Value *Dummy = nullptr;
+    if (!matchUnitStrideGEP(GB, BaseB, IndPhi, Off, Dummy) ||
+        !matchUnitStrideGEP(GA, BaseA, IndPhi, Off, Dummy))
+      return false;
+    if (GA != GEP && GA->stripPointerCasts() != St->getPointerOperand()) {
+      // Store must write back to a[iv+off]
+      if (St->getPointerOperand() != GA)
+        return false;
+    }
+    Ordered[Off] = St;
+  }
+  for (unsigned K = 0; K < Step; ++K)
+    if (!Ordered[K])
+      return false;
+
+  // Drop stores/fmuladds for k>=1; keep k=0; step→1; fix bound.
+  for (unsigned K = 1; K < Step; ++K) {
+    StoreInst *St = Ordered[K];
+    Value *V = St->getValueOperand();
+    St->eraseFromParent();
+    RecursivelyDeleteTriviallyDeadInstructions(V);
+  }
+
+  IRBuilder<> B(IndNext);
+  Value *NewNext =
+      B.CreateAdd(IndPhi, ConstantInt::get(IndPhi->getType(), 1),
+                  IndNext->getName() + ".reroll");
+  IndNext->replaceAllUsesWith(NewNext);
+  IndNext->eraseFromParent();
+
+  BranchInst *Br = dyn_cast<BranchInst>(Latch->getTerminator());
+  if (Br && Br->isConditional()) {
+    if (auto *Cmp = dyn_cast<ICmpInst>(Br->getCondition())) {
+      ConstantInt *Bound = nullptr;
+      if (Cmp->getOperand(0) == IndPhi)
+        Bound = dyn_cast<ConstantInt>(Cmp->getOperand(1));
+      else if (Cmp->getOperand(1) == IndPhi)
+        Bound = dyn_cast<ConstantInt>(Cmp->getOperand(0));
+      if (Bound) {
+        Constant *NC = ConstantInt::get(Bound->getType(),
+                                        Bound->getValue() + (Step - 1));
+        if (Cmp->getOperand(0) == IndPhi)
+          Cmp->setOperand(1, NC);
+        else
+          Cmp->setOperand(0, NC);
+      }
+    }
+  }
+
+  ++NumStrideReroll;
+  return true;
+}
+
+/// IV used by the latch compare (the counted IV), not a sibling +1 PHI (s126 k).
+static PHINode *getLatchComparedIV(Loop &L) {
+  BasicBlock *Header = L.getHeader();
+  BasicBlock *Latch = L.getLoopLatch();
+  if (!Header || !Latch)
+    return nullptr;
+  auto *Br = dyn_cast<BranchInst>(Latch->getTerminator());
+  if (!Br || !Br->isConditional())
+    return nullptr;
+  auto *Cmp = dyn_cast<ICmpInst>(Br->getCondition());
+  if (!Cmp)
+    return nullptr;
+  auto pick = [&](Value *V) -> PHINode * {
+    if (auto *PN = dyn_cast<PHINode>(V))
+      if (PN->getParent() == Header && PN->getType()->isIntegerTy())
+        return PN;
+    Value *X = nullptr;
+    ConstantInt *C = nullptr;
+    if ((match(V, m_Add(m_Value(X), m_ConstantInt(C))) ||
+         match(V, m_Add(m_ConstantInt(C), m_Value(X)))) &&
+        C)
+      if (auto *PN = dyn_cast<PHINode>(X))
+        if (PN->getParent() == Header && PN->getType()->isIntegerTy())
+          return PN;
+    return nullptr;
+  };
+  if (PHINode *P = pick(Cmp->getOperand(0)))
+    return P;
+  return pick(Cmp->getOperand(1));
+}
+
+/// Find the primary integer induction PHI of a simplified loop.
+static PHINode *getLoopInductionPHI(Loop &L) {
+  BasicBlock *Header = L.getHeader();
+  BasicBlock *Latch = L.getLoopLatch();
+  if (!Header || !Latch)
+    return nullptr;
+  if (PHINode *CmpIV = getLatchComparedIV(L)) {
+    Value *Inc = CmpIV->getIncomingValueForBlock(Latch);
+    ConstantInt *C = nullptr;
+    if ((match(Inc, m_Add(m_Specific(CmpIV), m_ConstantInt(C))) ||
+         match(Inc, m_Add(m_ConstantInt(C), m_Specific(CmpIV)))) &&
+        C && !C->isZero())
+      return CmpIV;
+  }
+  PHINode *Found = nullptr;
+  for (PHINode &PN : Header->phis()) {
+    if (!PN.getType()->isIntegerTy())
+      continue;
+    Value *Inc = PN.getIncomingValueForBlock(Latch);
+    ConstantInt *C = nullptr;
+    if (!match(Inc, m_Add(m_Specific(&PN), m_ConstantInt(C))) &&
+        !match(Inc, m_Add(m_ConstantInt(C), m_Specific(&PN))))
+      continue;
+    if (!C || C->isZero())
+      continue;
+    Found = &PN;
+    if (PN.getType()->isIntegerTy(64))
+      return &PN;
+  }
+  return Found;
+}
+
+static bool isInductionUpdateOf(Instruction *I, PHINode *IV) {
+  if (!I || !IV)
+    return false;
+  return match(I, m_Add(m_Specific(IV), m_ConstantInt())) ||
+         match(I, m_Add(m_ConstantInt(), m_Specific(IV)));
+}
+
+/// True if Inst is (part of) L's exiting compare / branch for IV.
+static bool isLoopControlUser(Instruction *Inst, Loop &L, PHINode *IV) {
+  (void)IV;
+  BasicBlock *Header = L.getHeader();
+  auto *Br = Header ? dyn_cast<BranchInst>(Header->getTerminator()) : nullptr;
+  if (!Br || !Br->isConditional())
+    return false;
+  SmallVector<Instruction *, 8> Work{Inst};
+  SmallPtrSet<Instruction *, 8> Visited;
+  while (!Work.empty()) {
+    Instruction *Cur = Work.pop_back_val();
+    if (!Visited.insert(Cur).second)
+      continue;
+    if (Cur == Br)
+      return true;
+    for (llvm::User *U : Cur->users()) {
+      auto *UI = dyn_cast<Instruction>(U);
+      if (!UI || !L.contains(UI))
+        continue;
+      // Don't walk into the loop body through the latch backedge values.
+      if (isa<PHINode>(UI) && UI->getParent() == Header)
+        continue;
+      Work.push_back(UI);
+    }
+  }
+  return false;
+}
+
+/// Interchange a perfect 2-nest whose inner body is a column recurrence
+///   A[*j*][*i*] = A[*j*-1][*i*] + …
+/// LLVM's LoopInterchange rejects these (conservative DA) or bubble-sorts the
+/// nl wrapper into a bad order. Manual source interchange is bit-exact and
+/// ~30× on TSVC s231; this does a single i↔j swap and stops.
+
+static bool usesValueIV(Value *V, PHINode *IV) {
+  SmallPtrSet<Value *, 8> Visited;
+  SmallVector<Value *, 8> Work{V};
+  while (!Work.empty()) {
+    Value *Cur = Work.pop_back_val();
+    if (!Visited.insert(Cur).second)
+      continue;
+    if (Cur == IV)
+      return true;
+    if (auto *I = dyn_cast<Instruction>(Cur)) {
+      if (isa<PHINode>(I))
+        continue;
+      for (Value *Op : I->operands())
+        Work.push_back(Op);
+    }
+  }
+  return false;
+}
+
+static Value *phiIncomingOrNull(PHINode *PN, BasicBlock *BB) {
+  if (!PN || !BB)
+    return nullptr;
+  int Idx = PN->getBasicBlockIndex(BB);
+  return Idx >= 0 ? PN->getIncomingValue(Idx) : nullptr;
+}
+
+static bool innerHasExtraFPPhi(Loop &Inner, PHINode *InnerIV) {
+  for (PHINode &PN : Inner.getHeader()->phis()) {
+    if (&PN == InnerIV)
+      continue;
+    if (PN.getType()->isFloatingPointTy() || PN.getType()->isVectorTy())
+      return true;
+  }
+  return false;
+}
+
+static bool innerHasExtraIntPhi(Loop &Inner, PHINode *InnerIV) {
+  for (PHINode &PN : Inner.getHeader()->phis()) {
+    if (&PN == InnerIV)
+      continue;
+    if (PN.getType()->isIntegerTy())
+      return true;
+  }
+  return false;
+}
+
+static bool isIVOrIVAddVal(Value *V, PHINode *IV) {
+  if (V == IV)
+    return true;
+  ConstantInt *C;
+  return match(V, m_Add(m_Specific(IV), m_ConstantInt(C))) ||
+         match(V, m_Add(m_ConstantInt(C), m_Specific(IV))) ||
+         match(V, m_Sub(m_Specific(IV), m_ConstantInt(C)));
+}
+
+static bool isIVOrIVAffine(Value *V, PHINode *IV) {
+  if (isIVOrIVAddVal(V, IV))
+    return true;
+  ConstantInt *C;
+  return match(V, m_Mul(m_Specific(IV), m_ConstantInt(C))) ||
+         match(V, m_Mul(m_ConstantInt(C), m_Specific(IV))) ||
+         match(V, m_Shl(m_Specific(IV), m_ConstantInt(C)));
+}
+
+static bool isFPArrayRowTy(Type *Ty) {
+  auto *AT = dyn_cast<ArrayType>(Ty);
+  return AT && AT->getElementType()->isFloatingPointTy();
+}
+
+/// aa[j][i] with j=InnerIV (row, non-unit) and i=OuterIV (column, unit).
+/// Clang emits two split forms:
+///   (A) row-first / s231: gep(float, gep([N x float], base, InnerIV), OuterIV)
+///   (B) col-first / s2275: gep([N x float], gep(float, base, OuterIV), InnerIV)
+static bool matchColumnStridePtr(Value *Ptr, PHINode *OuterIV, PHINode *InnerIV,
+                                 Value *&RowIdx, Value *&ColIdx) {
+  Ptr = Ptr->stripPointerCasts();
+  auto *G = dyn_cast<GetElementPtrInst>(Ptr);
+  if (!G)
+    return false;
+
+  if (G->getNumIndices() >= 2) {
+    RowIdx = G->getOperand(G->getNumOperands() - 2);
+    ColIdx = G->getOperand(G->getNumOperands() - 1);
+    return isIVOrIVAddVal(RowIdx, InnerIV) && isIVOrIVAddVal(ColIdx, OuterIV);
+  }
+  if (G->getNumIndices() != 1)
+    return false;
+
+  Value *Idx = G->getOperand(1);
+  Value *Base = G->getPointerOperand()->stripPointerCasts();
+  auto *BG = dyn_cast<GetElementPtrInst>(Base);
+  Type *SrcTy = G->getSourceElementType();
+
+  // Form B: last GEP steps by a whole FP row using InnerIV.
+  if (isFPArrayRowTy(SrcTy) && isIVOrIVAffine(Idx, InnerIV)) {
+    RowIdx = Idx;
+    if (BG && BG->getNumIndices() >= 1 &&
+        isIVOrIVAddVal(BG->getOperand(BG->getNumOperands() - 1), OuterIV) &&
+        !usesValueIV(BG, InnerIV)) {
+      ColIdx = BG->getOperand(BG->getNumOperands() - 1);
+      return true;
+    }
+    return false;
+  }
+
+  // Form A: last GEP is the contiguous column index (OuterIV).
+  if ((SrcTy->isFloatingPointTy() || SrcTy->isIntegerTy(8)) &&
+      isIVOrIVAddVal(Idx, OuterIV)) {
+    ColIdx = Idx;
+    if (!BG)
+      return false;
+    GetElementPtrInst *RowG = BG;
+    if (BG->getNumIndices() == 1 && isa<ConstantInt>(BG->getOperand(1))) {
+      Value *P = BG->getPointerOperand()->stripPointerCasts();
+      RowG = dyn_cast<GetElementPtrInst>(P);
+    }
+    if (!RowG || RowG->getNumIndices() < 1)
+      return false;
+    RowIdx = RowG->getOperand(RowG->getNumOperands() - 1);
+    return isIVOrIVAffine(RowIdx, InnerIV);
+  }
+
+  // Form C: flattened aa[j][i] as base[j*LEN + i] (j = InnerIV, i = OuterIV).
+  // Do not match i*LEN+j — that is already unit-stride in the inner loop.
+  Value *Mul = nullptr;
+  Value *Other = nullptr;
+  if (match(Idx, m_Add(m_Value(Mul), m_Value(Other)))) {
+    if (isIVOrIVAddVal(Other, OuterIV) && !usesValueIV(Mul, OuterIV)) {
+      Value *K = nullptr;
+      if (match(Mul, m_Mul(m_Specific(InnerIV), m_Value(K))) ||
+          match(Mul, m_Mul(m_Value(K), m_Specific(InnerIV))) ||
+          match(Mul, m_Shl(m_Specific(InnerIV), m_Value(K)))) {
+        if (K && !usesValueIV(K, OuterIV) && !usesValueIV(K, InnerIV)) {
+          RowIdx = InnerIV;
+          ColIdx = Other;
+          return true;
+        }
+      }
+    }
+  }
+  return false;
+}
+
+/// Row=InnerIV, Col=OuterIV for store pointer aa[j][i] with j-inner.
+static bool matchColumnStrideStore(StoreInst *St, PHINode *OuterIV,
+                                   PHINode *InnerIV, Value *&RowIdx,
+                                   Value *&ColIdx) {
+  if (!St || !St->getValueOperand()->getType()->isFloatingPointTy())
+    return false;
+  if (!usesValueIV(St->getPointerOperand(), OuterIV) ||
+      !usesValueIV(St->getPointerOperand(), InnerIV))
+    return false;
+  return matchColumnStridePtr(St->getPointerOperand(), OuterIV, InnerIV, RowIdx,
+                              ColIdx);
+}
+
+static bool innerTripIndependentOfOuter(Loop &Inner, PHINode *OuterIV) {
+  BasicBlock *Latch = Inner.getLoopLatch();
+  if (!Latch)
+    return false;
+  auto *Br = dyn_cast<BranchInst>(Latch->getTerminator());
+  if (!Br || !Br->isConditional())
+    return false;
+  return !usesValueIV(Br->getCondition(), OuterIV);
+}
+
+static bool collectInnerFPStores(Loop &Inner,
+                                 SmallVectorImpl<StoreInst *> &Stores) {
+  for (Instruction &I : *Inner.getHeader()) {
+    if (auto *St = dyn_cast<StoreInst>(&I)) {
+      if (!St->getValueOperand()->getType()->isFloatingPointTy())
+        return false;
+      Stores.push_back(St);
+    }
+  }
+  return !Stores.empty();
+}
+
+/// Column-stride 2D stores (aa[j][i]) plus optional inner-only 1D stores
+/// (a[j]=). Reject a[i] in the inner body — that becomes a[j] after the swap
+/// and is not a legal element-wise interchange.
+static bool collectColumnStrideInnerStores(Loop &Inner, PHINode *OuterIV,
+                                           PHINode *InnerIV,
+                                           SmallVectorImpl<StoreInst *> &ColStores) {
+  ColStores.clear();
+  SmallVector<StoreInst *, 4> All;
+  if (!collectInnerFPStores(Inner, All))
+    return false;
+  for (StoreInst *St : All) {
+    Value *Ptr = St->getPointerOperand();
+    const bool UsesOuter = usesValueIV(Ptr, OuterIV);
+    const bool UsesInner = usesValueIV(Ptr, InnerIV);
+    if (UsesOuter && UsesInner) {
+      Value *Row = nullptr, *Col = nullptr;
+      if (!matchColumnStrideStore(St, OuterIV, InnerIV, Row, Col))
+        return false;
+      ColStores.push_back(St);
+    } else if (UsesOuter && !UsesInner) {
+      return false;
+    }
+  }
+  return !ColStores.empty();
+}
+
+static bool isPrevRowLoadOf(LoadInst *Ld, PHINode *OuterIV, PHINode *InnerIV) {
+  Value *Ptr = Ld->getPointerOperand()->stripPointerCasts();
+  auto *ColG = dyn_cast<GetElementPtrInst>(Ptr);
+  if (!ColG)
+    return false;
+  Value *Col = ColG->getNumIndices() >= 1
+                   ? ColG->getOperand(ColG->getNumOperands() - 1)
+                   : nullptr;
+  if (!Col || !isIVOrIVAddVal(Col, OuterIV))
+    return false;
+  auto isPrevRowIdx = [&](Value *Row) {
+    if (match(Row, m_Sub(m_Specific(InnerIV), m_One())))
+      return true;
+    ConstantInt *C;
+    return match(Row, m_Add(m_Specific(InnerIV), m_ConstantInt(C))) &&
+           C->isMinusOne();
+  };
+  if (ColG->getNumIndices() >= 2) {
+    Value *Row = ColG->getOperand(ColG->getNumOperands() - 2);
+    return isPrevRowIdx(Row);
+  }
+  Value *RowBase = ColG->getPointerOperand()->stripPointerCasts();
+  if (auto *ByteG = dyn_cast<GetElementPtrInst>(RowBase)) {
+    if (ByteG->getNumIndices() == 1) {
+      if (auto *C = dyn_cast<ConstantInt>(ByteG->getOperand(1))) {
+        if (C->getSExtValue() < 0) {
+          Value *CurRow = ByteG->getPointerOperand()->stripPointerCasts();
+          if (auto *RowG = dyn_cast<GetElementPtrInst>(CurRow)) {
+            Value *Row = RowG->getOperand(RowG->getNumOperands() - 1);
+            if (isIVOrIVAddVal(Row, InnerIV))
+              return true;
+          }
+        }
+      }
+    }
+  }
+  if (auto *RowG = dyn_cast<GetElementPtrInst>(RowBase)) {
+    Value *Row = RowG->getOperand(RowG->getNumOperands() - 1);
+    return isPrevRowIdx(Row);
+  }
+  return false;
+}
+
+static bool isPrevColLoadOf(LoadInst *Ld, PHINode *OuterIV, PHINode *InnerIV) {
+  Value *Row = nullptr, *Col = nullptr;
+  if (!matchColumnStridePtr(Ld->getPointerOperand(), OuterIV, InnerIV, Row,
+                            Col))
+    return false;
+  if (match(Col, m_Sub(m_Specific(OuterIV), m_One())))
+    return true;
+  ConstantInt *C;
+  return match(Col, m_Add(m_Specific(OuterIV), m_ConstantInt(C))) &&
+         C->isMinusOne();
+}
+
+static bool innerLooksColumnStride(Loop &Inner, PHINode *OuterIV,
+                                   PHINode *InnerIV) {
+  SmallVector<StoreInst *, 4> ColStores;
+  return collectColumnStrideInnerStores(Inner, OuterIV, InnerIV, ColStores);
+}
+
+/// Clone Insts (program order) into a counted loop using ModelIV's init/step/bound.
+/// InsertAfter currently branches unconditionally to AfterLoop; it will instead
+/// enter the new loop, which then continues to AfterLoop.
+static bool emitDistributedIVLoop(BasicBlock *InsertAfter, BasicBlock *AfterLoop,
+                                  PHINode *ModelIV, BasicBlock *ModelPH,
+                                  BasicBlock *ModelLatch,
+                                  ArrayRef<Instruction *> Insts,
+                                  const Twine &Name) {
+  if (Insts.empty())
+    return false;
+  auto *PHBr = dyn_cast<BranchInst>(InsertAfter->getTerminator());
+  if (!PHBr || !PHBr->isUnconditional() || PHBr->getSuccessor(0) != AfterLoop)
+    return false;
+  auto *LatchBr = dyn_cast<BranchInst>(ModelLatch->getTerminator());
+  if (!LatchBr || !LatchBr->isConditional())
+    return false;
+  Value *ModelInc = phiIncomingOrNull(ModelIV, ModelLatch);
+  if (!ModelInc)
+    return false;
+  auto *IncBO = dyn_cast<BinaryOperator>(ModelInc);
+  if (!IncBO || IncBO->getOpcode() != Instruction::Add)
+    return false;
+  Value *Step = IncBO->getOperand(0) == ModelIV ? IncBO->getOperand(1)
+                                                : IncBO->getOperand(0);
+  if (!isa<ConstantInt>(Step))
+    return false;
+  auto *ModelCmp = dyn_cast<ICmpInst>(LatchBr->getCondition());
+  if (!ModelCmp)
+    return false;
+
+  Function *F = InsertAfter->getParent();
+  BasicBlock *DistBB =
+      BasicBlock::Create(F->getContext(), Name, F, AfterLoop);
+  PHBr->setSuccessor(0, DistBB);
+
+  IRBuilder<> B(DistBB);
+  PHINode *DistIV = B.CreatePHI(ModelIV->getType(), 2, Name + ".iv");
+  Value *Init = phiIncomingOrNull(ModelIV, ModelPH);
+  if (!Init)
+    return false;
+  DistIV->addIncoming(Init, InsertAfter);
+
+  ValueToValueMapTy VM;
+  VM[ModelIV] = DistIV;
+  for (Instruction *I : Insts) {
+    Instruction *C = I->clone();
+    RemapInstruction(C, VM,
+                     RF_NoModuleLevelChanges | RF_IgnoreMissingLocals);
+    B.Insert(C);
+    VM[I] = C;
+  }
+  Value *DistInc = B.CreateAdd(DistIV, Step, Name + ".next");
+  DistIV->addIncoming(DistInc, DistBB);
+
+  auto remapOp = [&](Value *V) -> Value * {
+    if (V == ModelIV)
+      return DistIV;
+    if (V == ModelInc)
+      return DistInc;
+    if (auto *VI = dyn_cast<Instruction>(V)) {
+      auto It = VM.find(VI);
+      if (It != VM.end())
+        return It->second;
+    }
+    return V;
+  };
+  Value *NewCmp = B.CreateICmp(ModelCmp->getPredicate(),
+                               remapOp(ModelCmp->getOperand(0)),
+                               remapOp(ModelCmp->getOperand(1)),
+                               Name + ".cmp");
+  BasicBlock *ModelHeader = ModelIV->getParent();
+  BasicBlock *TrueBB = LatchBr->getSuccessor(0) == ModelHeader ? DistBB
+                                                               : AfterLoop;
+  BasicBlock *FalseBB = LatchBr->getSuccessor(1) == ModelHeader ? DistBB
+                                                                : AfterLoop;
+  B.CreateCondBr(NewCmp, TrueBB, FalseBB);
+
+  for (PHINode &PN : AfterLoop->phis())
+    PN.replaceIncomingBlockWith(InsertAfter, DistBB);
+  return true;
+}
+
+static bool collect1DSlice(Loop &Inner, Loop &Outer, PHINode *OuterIV,
+                           PHINode *InnerIV, SmallVectorImpl<Instruction *> &Prefix,
+                           SmallVectorImpl<Instruction *> &Suffix,
+                           SmallVectorImpl<std::pair<Value *, Value *>> &Reloads) {
+  BasicBlock *OuterHeader = Outer.getHeader();
+  BasicBlock *OuterLatch = Outer.getLoopLatch();
+  SmallVector<StoreInst *, 4> FPStores;
+  auto considerBB = [&](BasicBlock *BB) {
+    for (Instruction &I : *BB) {
+      if (Inner.contains(&I))
+        continue;
+      if (auto *St = dyn_cast<StoreInst>(&I))
+        if (St->getValueOperand()->getType()->isFloatingPointTy() &&
+            !usesValueIV(St->getPointerOperand(), InnerIV) &&
+            usesValueIV(St->getPointerOperand(), OuterIV))
+          FPStores.push_back(St);
+    }
+  };
+  considerBB(OuterHeader);
+  if (OuterLatch && OuterLatch != OuterHeader)
+    considerBB(OuterLatch);
+  if (FPStores.empty())
+    return false;
+
+  SmallPtrSet<Instruction *, 16> Slice;
+  SmallVector<Instruction *, 16> Work(FPStores.begin(), FPStores.end());
+  while (!Work.empty()) {
+    Instruction *I = Work.pop_back_val();
+    if (!Slice.insert(I).second)
+      continue;
+    if (isa<PHINode>(I) || isInductionUpdateOf(I, OuterIV) || isa<CmpInst>(I) ||
+        I->isTerminator())
+      continue;
+    if (usesValueIV(I, InnerIV) && !isa<StoreInst>(I))
+      return false;
+    for (Value *Op : I->operands()) {
+      auto *OpI = dyn_cast<Instruction>(Op);
+      if (!OpI || isa<PHINode>(OpI))
+        continue;
+      if (OpI->getParent() != OuterHeader && OpI->getParent() != OuterLatch)
+        continue;
+      if (Inner.contains(OpI))
+        continue;
+      Work.push_back(OpI);
+    }
+  }
+
+  // Inner uses of slice values must be reloadable from a 1D store.
+  for (Instruction *I : Slice) {
+    for (User *U : I->users()) {
+      auto *UI = dyn_cast<Instruction>(U);
+      if (!UI || !Inner.contains(UI))
+        continue;
+      StoreInst *SrcSt = nullptr;
+      for (StoreInst *St : FPStores) {
+        if (St->getValueOperand() == I) {
+          SrcSt = St;
+          break;
+        }
+      }
+      if (!SrcSt)
+        return false;
+      Reloads.emplace_back(I, SrcSt->getPointerOperand());
+    }
+  }
+
+  auto takeFrom = [&](BasicBlock *BB, SmallVectorImpl<Instruction *> &Out) {
+    for (Instruction &I : *BB)
+      if (Slice.contains(&I) && !isa<PHINode>(I) && !I.isTerminator() &&
+          !isa<CmpInst>(I) && !isInductionUpdateOf(&I, OuterIV))
+        Out.push_back(&I);
+  };
+  takeFrom(OuterHeader, Prefix);
+  if (OuterLatch && OuterLatch != OuterHeader)
+    takeFrom(OuterLatch, Suffix);
+  return !Prefix.empty() || !Suffix.empty();
+}
+
+/// Split `for i { for j S1; for j S2; }` into two outer loops so a
+/// column-stride inner can be interchanged independently (s233 / s2233).
+static bool tryFissionSiblingInners(Loop &Outer, Function &F) {
+  if (Outer.getSubLoops().size() != 2 || !Outer.isLoopSimplifyForm())
+    return false;
+  if (!Outer.getLoopPreheader() || !Outer.getLoopLatch() ||
+      !Outer.getUniqueExitBlock())
+    return false;
+
+  SmallVector<Loop *, 2> Inners(Outer.getSubLoops().begin(),
+                                Outer.getSubLoops().end());
+  Loop *First = nullptr;
+  Loop *Second = nullptr;
+  SmallPtrSet<BasicBlock *, 16> Visited;
+  SmallVector<BasicBlock *, 16> Work{Outer.getHeader()};
+  while (!Work.empty() && (!First || !Second)) {
+    BasicBlock *BB = Work.pop_back_val();
+    if (!Visited.insert(BB).second)
+      continue;
+    for (Loop *L : Inners) {
+      if (L->getHeader() == BB) {
+        if (!First)
+          First = L;
+        else if (L != First && !Second)
+          Second = L;
+      }
+    }
+    if (First && First->contains(BB) && BB != First->getExitBlock()) {
+      if (BasicBlock *E = First->getExitBlock())
+        Work.push_back(E);
+      continue;
+    }
+    for (BasicBlock *S : successors(BB))
+      if (Outer.contains(S) && !Visited.contains(S))
+        Work.push_back(S);
+  }
+  if (!First || !Second || First == Second)
+    return false;
+  if (!First->isInnermost() || !Second->isInnermost())
+    return false;
+  if (First->getHeader() != First->getLoopLatch() ||
+      Second->getHeader() != Second->getLoopLatch())
+    return false;
+  if (!First->isLoopSimplifyForm() || !Second->isLoopSimplifyForm())
+    return false;
+
+  PHINode *OuterIV = getLoopInductionPHI(Outer);
+  PHINode *FirstIV = getLoopInductionPHI(*First);
+  PHINode *SecondIV = getLoopInductionPHI(*Second);
+  if (!OuterIV || !FirstIV || !SecondIV)
+    return false;
+  if (!innerTripIndependentOfOuter(*First, OuterIV) ||
+      !innerTripIndependentOfOuter(*Second, OuterIV))
+    return false;
+  if (innerHasExtraFPPhi(*First, FirstIV) ||
+      innerHasExtraFPPhi(*Second, SecondIV))
+    return false;
+
+  bool FirstCol = innerLooksColumnStride(*First, OuterIV, FirstIV);
+  bool SecondCol = innerLooksColumnStride(*Second, OuterIV, SecondIV);
+  if (!FirstCol && !SecondCol)
+    return false;
+
+  for (BasicBlock *BB : Second->blocks()) {
+    for (Instruction &I : *BB) {
+      for (Value *Op : I.operands()) {
+        if (auto *OpI = dyn_cast<Instruction>(Op))
+          if (First->contains(OpI))
+            return false;
+      }
+    }
+  }
+
+  BasicBlock *Exit = Outer.getUniqueExitBlock();
+  BasicBlock *Latch = Outer.getLoopLatch();
+  BasicBlock *Header = Outer.getHeader();
+  BasicBlock *PH = Outer.getLoopPreheader();
+  BasicBlock *FirstExit = First->getExitBlock();
+  auto *LatchBr = dyn_cast<BranchInst>(Latch->getTerminator());
+  auto *FirstLatchBr =
+      dyn_cast<BranchInst>(First->getLoopLatch()->getTerminator());
+  if (!FirstExit || !LatchBr || !LatchBr->isConditional() || !FirstLatchBr ||
+      !FirstLatchBr->isConditional() ||
+      !isa<BranchInst>(Header->getTerminator()))
+    return false;
+
+  unsigned FirstExitSucc =
+      FirstLatchBr->getSuccessor(0) == First->getHeader() ? 1 : 0;
+  if (FirstLatchBr->getSuccessor(FirstExitSucc) != FirstExit)
+    return false;
+  if (isa<PHINode>(&FirstExit->front()))
+    return false;
+  unsigned ExitSucc = LatchBr->getSuccessor(0) == Exit ? 0 : 1;
+  if (LatchBr->getSuccessor(ExitSucc) != Exit)
+    return false;
+  if (Exit->phis().begin() != Exit->phis().end())
+    return false;
+
+  ValueToValueMapTy VMap;
+  SmallVector<BasicBlock *, 16> NewBlocks;
+  for (BasicBlock *BB : Outer.blocks()) {
+    BasicBlock *NC = CloneBasicBlock(BB, VMap, ".fd", &F);
+    VMap[BB] = NC;
+    NewBlocks.push_back(NC);
+    NC->moveBefore(Exit);
+  }
+  for (BasicBlock *NB : NewBlocks)
+    for (Instruction &I : *NB)
+      RemapInstruction(&I, VMap,
+                       RF_NoModuleLevelChanges | RF_IgnoreMissingLocals);
+
+  BasicBlock *CloneHeader = cast<BasicBlock>(VMap[Header]);
+  LatchBr->setSuccessor(ExitSucc, CloneHeader);
+
+  for (PHINode &PN : CloneHeader->phis()) {
+    int Idx = PN.getBasicBlockIndex(PH);
+    if (Idx >= 0)
+      PN.setIncomingBlock(Idx, Latch);
+  }
+
+  FirstLatchBr->setSuccessor(FirstExitSucc, Latch);
+
+  auto *CHBr = dyn_cast<BranchInst>(CloneHeader->getTerminator());
+  BasicBlock *CloneFirstExit = cast<BasicBlock>(VMap[FirstExit]);
+  if (CHBr && CHBr->isUnconditional())
+    CHBr->setSuccessor(0, CloneFirstExit);
+  else if (CHBr && CHBr->isConditional()) {
+    if (CHBr->getSuccessor(0) == VMap[First->getHeader()])
+      CHBr->setSuccessor(0, CloneFirstExit);
+    else if (CHBr->getSuccessor(1) == VMap[First->getHeader()])
+      CHBr->setSuccessor(1, CloneFirstExit);
+  }
+
+  EliminateUnreachableBlocks(F);
+  ++NumSiblingFission;
+  return true;
+}
+
+static bool tryDistribute1DFPAroundInner(Loop &Inner) {
+  Loop *Outer = Inner.getParentLoop();
+  if (!Outer || Outer->getSubLoops().size() != 1 || !Inner.isInnermost())
+    return false;
+  if (!Inner.isLoopSimplifyForm() || !Outer->isLoopSimplifyForm())
+    return false;
+  if (Inner.getHeader() != Inner.getLoopLatch())
+    return false;
+
+  PHINode *OuterIV = getLoopInductionPHI(*Outer);
+  PHINode *InnerIV = getLoopInductionPHI(Inner);
+  if (!OuterIV || !InnerIV || OuterIV->getType() != InnerIV->getType())
+    return false;
+  if (!innerLooksColumnStride(Inner, OuterIV, InnerIV))
+    return false;
+  // s257-style 1D recurrence (a[i-1] / a[i] in the nest) is not a 1D slice
+  // we can legally peel; Form B GEPs would otherwise match and mis-distribute.
+  for (BasicBlock *BB : Outer->blocks()) {
+    for (Instruction &I : *BB) {
+      auto *Ld = dyn_cast<LoadInst>(&I);
+      auto *St = dyn_cast<StoreInst>(&I);
+      Value *Ptr = Ld ? Ld->getPointerOperand()
+                      : St ? St->getPointerOperand() : nullptr;
+      if (!Ptr || !usesValueIV(Ptr, OuterIV) || usesValueIV(Ptr, InnerIV))
+        continue;
+      auto *G = dyn_cast<GetElementPtrInst>(Ptr->stripPointerCasts());
+      if (!G || G->getOperand(G->getNumOperands() - 1) != OuterIV)
+        return false;
+    }
+  }
+
+  BasicBlock *OuterPH = Outer->getLoopPreheader();
+  BasicBlock *OuterLatch = Outer->getLoopLatch();
+  BasicBlock *OuterHeader = Outer->getHeader();
+  if (!OuterPH || !OuterLatch || !OuterHeader)
+    return false;
+
+  SmallVector<Instruction *, 16> Prefix, Suffix;
+  SmallVector<std::pair<Value *, Value *>, 4> Reloads;
+  if (!collect1DSlice(Inner, *Outer, OuterIV, InnerIV, Prefix, Suffix, Reloads))
+    return false;
+
+  // Replace inner uses of prefix/suffix SSA with loads of the stored 1D slot.
+  Instruction *InnerInsert = &*Inner.getHeader()->getFirstInsertionPt();
+  IRBuilder<> ReloadB(InnerInsert);
+  SmallPtrSet<Value *, 4> Done;
+  for (auto &RP : Reloads) {
+    if (!Done.insert(RP.first).second)
+      continue;
+    Value *Ld = ReloadB.CreateLoad(cast<Instruction>(RP.first)->getType(),
+                                   RP.second, "la.dist.reload");
+    RP.first->replaceUsesWithIf(Ld, [&](Use &U) {
+      auto *UI = dyn_cast<Instruction>(U.getUser());
+      return UI && Inner.contains(UI);
+    });
+  }
+
+  bool Changed = false;
+  if (!Prefix.empty()) {
+    if (!emitDistributedIVLoop(OuterPH, OuterHeader, OuterIV, OuterPH,
+                               OuterLatch, Prefix, "la.colix.pre"))
+      return false;
+    bool Prog = true;
+    while (Prog) {
+      Prog = false;
+      for (Instruction *I : reverse(Prefix))
+        if (I->getParent() && I->use_empty()) {
+          I->eraseFromParent();
+          Prog = true;
+        }
+    }
+    Changed = true;
+  }
+  if (!Suffix.empty()) {
+    BasicBlock *Exit = Outer->getUniqueExitBlock();
+    if (!Exit) {
+      auto *LB = dyn_cast<BranchInst>(OuterLatch->getTerminator());
+      if (LB && LB->isConditional()) {
+        BasicBlock *H = Outer->getHeader();
+        if (LB->getSuccessor(0) != H)
+          Exit = LB->getSuccessor(0);
+        else if (LB->getSuccessor(1) != H)
+          Exit = LB->getSuccessor(1);
+      }
+    }
+    if (!Exit)
+      return Changed;
+    auto *LatchBr = dyn_cast<BranchInst>(OuterLatch->getTerminator());
+    if (!LatchBr || !LatchBr->isConditional())
+      return Changed;
+    unsigned ExitSucc = LatchBr->getSuccessor(0) == Exit ? 0 : 1;
+    if (LatchBr->getSuccessor(ExitSucc) != Exit)
+      return Changed;
+    Function *F = Exit->getParent();
+    BasicBlock *SufPH =
+        BasicBlock::Create(F->getContext(), "la.colix.suf.ph", F, Exit);
+    IRBuilder<> PB(SufPH);
+    PB.CreateBr(Exit);
+    LatchBr->setSuccessor(ExitSucc, SufPH);
+    for (PHINode &PN : Exit->phis())
+      PN.replaceIncomingBlockWith(OuterLatch, SufPH);
+    if (!emitDistributedIVLoop(SufPH, Exit, OuterIV, OuterPH, OuterLatch,
+                               Suffix, "la.colix.suf"))
+      return Changed;
+    bool Prog = true;
+    while (Prog) {
+      Prog = false;
+      for (Instruction *I : reverse(Suffix))
+        if (I->getParent() && I->use_empty()) {
+          I->eraseFromParent();
+          Prog = true;
+        }
+    }
+    Changed = true;
+  }
+  if (Changed)
+    ++NumColumnDistribute;
+  return Changed;
+}
+
+/// TSVC s275: `for i { if (aa[0][i] > 0) for j aa[j][i] = aa[j-1][i] + … }`.
+/// The outer if is InnerIV-invariant, so it is legal to run the inner always
+/// and select-store (false → keep old). After that the nest is perfect and
+/// i↔j interchange makes the inner unit-stride. Rejects extra FP PHIs,
+/// InnerIV in the predicate, and latch PHIs that only come from the skip edge.
+static bool trySinkOuterPredicateIntoInner(Loop &Inner) {
+  Loop *Outer = Inner.getParentLoop();
+  if (!Outer || Outer->getSubLoops().size() != 1 || !Inner.isInnermost())
+    return false;
+  if (!Outer->isLoopSimplifyForm())
+    return false;
+  // The skip-edge `if (p[i]) for j` means Inner's exit is also Outer's latch
+  // (shared with the false path), so Inner is not LoopSimplify. After the
+  // skip is removed it becomes simplify-form and interchange can run.
+  if (!Inner.getLoopPreheader() || !Inner.getLoopLatch())
+    return false;
+  if (Inner.getHeader() != Inner.getLoopLatch())
+    return false;
+
+  PHINode *OuterIV = getLoopInductionPHI(*Outer);
+  PHINode *InnerIV = getLoopInductionPHI(Inner);
+  if (!OuterIV || !InnerIV || OuterIV->getType() != InnerIV->getType())
+    return false;
+  if (innerHasExtraFPPhi(Inner, InnerIV))
+    return false;
+  if (!innerLooksColumnStride(Inner, OuterIV, InnerIV))
+    return false;
+  if (!innerTripIndependentOfOuter(Inner, OuterIV))
+    return false;
+  if (usesValueIV(phiIncomingOrNull(InnerIV, Inner.getLoopPreheader()),
+                  OuterIV) ||
+      usesValueIV(phiIncomingOrNull(OuterIV, Outer->getLoopPreheader()),
+                  InnerIV))
+    return false;
+
+  BasicBlock *Latch = Outer->getLoopLatch();
+  BasicBlock *InnerPH = Inner.getLoopPreheader();
+  BasicBlock *InnerH = Inner.getHeader();
+  if (!Latch || !InnerPH)
+    return false;
+
+  auto entersInner = [&](BasicBlock *S) {
+    return S == InnerPH || S == InnerH;
+  };
+  BranchInst *GuardBr = nullptr;
+  unsigned EnterSucc = 0;
+  BasicBlock *SkipBB = nullptr;
+  for (BasicBlock *BB : Outer->blocks()) {
+    if (Inner.contains(BB))
+      continue;
+    auto *Br = dyn_cast<BranchInst>(BB->getTerminator());
+    if (!Br || !Br->isConditional())
+      continue;
+    Value *C = Br->getCondition();
+    if (!C || usesValueIV(C, InnerIV) || !usesValueIV(C, OuterIV))
+      continue;
+    unsigned ES = 0;
+    BasicBlock *Skip = nullptr;
+    if (entersInner(Br->getSuccessor(0)) && Br->getSuccessor(1) == Latch) {
+      ES = 0;
+      Skip = Br->getSuccessor(1);
+    } else if (entersInner(Br->getSuccessor(1)) &&
+               Br->getSuccessor(0) == Latch) {
+      ES = 1;
+      Skip = Br->getSuccessor(0);
+    } else
+      continue;
+    if (GuardBr)
+      return false;
+    GuardBr = Br;
+    EnterSucc = ES;
+    SkipBB = Skip;
+  }
+  if (!GuardBr || !SkipBB)
+    return false;
+  Value *Cond = GuardBr->getCondition();
+  BasicBlock *GuardBB = GuardBr->getParent();
+
+  for (PHINode &PN : SkipBB->phis()) {
+    if (PN.getBasicBlockIndex(GuardBB) >= 0 && PN.getNumIncomingValues() < 2)
+      return false;
+  }
+
+  // Guard DAG must live in the guard block (s275: gep/load/fcmp).
+  SmallPtrSet<Instruction *, 8> GuardInsts;
+  SmallVector<Instruction *, 8> Work;
+  if (auto *CI = dyn_cast<Instruction>(Cond))
+    Work.push_back(CI);
+  else
+    return false;
+  while (!Work.empty()) {
+    Instruction *I = Work.pop_back_val();
+    if (!GuardInsts.insert(I).second)
+      continue;
+    if (isa<PHINode>(I))
+      return false;
+    if (I->getParent() != GuardBB)
+      return false;
+    if (usesValueIV(I, InnerIV))
+      return false;
+    for (Value *Op : I->operands()) {
+      if (auto *OpI = dyn_cast<Instruction>(Op)) {
+        if (OpI == OuterIV || isa<PHINode>(OpI))
+          continue;
+        if (OpI->getParent() == GuardBB)
+          Work.push_back(OpI);
+        else if (Outer->contains(OpI) && !Inner.contains(OpI))
+          return false;
+      }
+    }
+  }
+
+  SmallVector<Instruction *, 8> GuardOrder(GuardInsts.begin(), GuardInsts.end());
+  SmallVector<Instruction *, 8> Sorted;
+  SmallPtrSet<Instruction *, 8> Placed;
+  while (Sorted.size() < GuardOrder.size()) {
+    bool Prog = false;
+    for (Instruction *I : GuardOrder) {
+      if (Placed.contains(I))
+        continue;
+      bool Ready = true;
+      for (Value *Op : I->operands()) {
+        auto *OpI = dyn_cast<Instruction>(Op);
+        if (!OpI || !GuardInsts.contains(OpI) || Placed.contains(OpI))
+          continue;
+        Ready = false;
+        break;
+      }
+      if (!Ready)
+        continue;
+      Sorted.push_back(I);
+      Placed.insert(I);
+      Prog = true;
+    }
+    if (!Prog)
+      return false;
+  }
+
+  SmallVector<StoreInst *, 4> Stores;
+  if (!collectColumnStrideInnerStores(Inner, OuterIV, InnerIV, Stores))
+    return false;
+
+  Instruction *Insert = &*InnerH->getFirstInsertionPt();
+  IRBuilder<> B(Insert);
+  ValueToValueMapTy VM;
+  Value *NewCond = nullptr;
+  for (Instruction *I : Sorted) {
+    Instruction *C = I->clone();
+    RemapInstruction(C, VM,
+                     RF_NoModuleLevelChanges | RF_IgnoreMissingLocals);
+    B.Insert(C);
+    VM[I] = C;
+    if (I == Cond)
+      NewCond = C;
+  }
+  if (!NewCond)
+    return false;
+
+  for (StoreInst *St : Stores) {
+    IRBuilder<> SB(St);
+    Value *NewV = St->getValueOperand();
+    Value *OldV =
+        SB.CreateLoad(NewV->getType(), St->getPointerOperand(), "la.guard.old");
+    Value *Sel = SB.CreateSelect(NewCond, NewV, OldV, "la.guard.sel");
+    St->setOperand(0, Sel);
+  }
+
+  BasicBlock *EnterBB = GuardBr->getSuccessor(EnterSucc);
+  GuardBr->eraseFromParent();
+  BranchInst::Create(EnterBB, GuardBB);
+  for (PHINode &PN : SkipBB->phis()) {
+    int Idx = PN.getBasicBlockIndex(GuardBB);
+    if (Idx >= 0)
+      PN.removeIncomingValue(Idx, /*DeletePHIIfEmpty=*/false);
+  }
+
+  bool Prog = true;
+  while (Prog) {
+    Prog = false;
+    SmallVector<Instruction *, 8> Dead;
+    for (Instruction &I : *GuardBB) {
+      if (I.isTerminator() || isa<PHINode>(I))
+        continue;
+      if (I.use_empty())
+        Dead.push_back(&I);
+    }
+    for (Instruction *I : reverse(Dead)) {
+      I->eraseFromParent();
+      Prog = true;
+    }
+  }
+
+  ++NumColumnGuardSink;
+  return true;
+}
+
+/// s126: `k=1; for i { for j { bb[j][i] += flat[k-1]*…; ++k; } ++k; }`.
+/// k is a side induction whose trip does not depend on i. Rewrite k as
+///   k = K0 + i*Stride + (j - j0)
+/// retarget the inner exit onto j, then i↔j interchange can leave k alone.
+static bool tryRewriteTripIndependentSideIV(Loop &Inner) {
+  Loop *Outer = Inner.getParentLoop();
+  if (!Outer || Outer->getSubLoops().size() != 1 || !Inner.isInnermost())
+    return false;
+  if (!Inner.isLoopSimplifyForm() || !Outer->isLoopSimplifyForm())
+    return false;
+  if (Inner.getHeader() != Inner.getLoopLatch())
+    return false;
+
+  PHINode *OuterIV = getLoopInductionPHI(*Outer);
+  if (!OuterIV)
+    return false;
+
+  PHINode *RowIV = nullptr;
+  for (PHINode &PN : Inner.getHeader()->phis()) {
+    if (!PN.getType()->isIntegerTy())
+      continue;
+    if (innerLooksColumnStride(Inner, OuterIV, &PN)) {
+      if (RowIV)
+        return false;
+      RowIV = &PN;
+    }
+  }
+  if (!RowIV)
+    return false;
+
+  PHINode *SideIV = nullptr;
+  for (PHINode &PN : Inner.getHeader()->phis()) {
+    if (&PN == RowIV)
+      continue;
+    if (!PN.getType()->isIntegerTy())
+      return false;
+    if (SideIV)
+      return false;
+    SideIV = &PN;
+  }
+  if (!SideIV)
+    return false;
+
+  BasicBlock *InnerPH = Inner.getLoopPreheader();
+  BasicBlock *InnerLatch = Inner.getLoopLatch();
+  BasicBlock *OuterPH = Outer->getLoopPreheader();
+  BasicBlock *OuterLatch = Outer->getLoopLatch();
+  if (!InnerPH || !InnerLatch || !OuterPH || !OuterLatch)
+    return false;
+
+  Value *SideNext = phiIncomingOrNull(SideIV, InnerLatch);
+  Value *RowNext = phiIncomingOrNull(RowIV, InnerLatch);
+  Value *SideEnter = phiIncomingOrNull(SideIV, InnerPH);
+  Value *RowInit = phiIncomingOrNull(RowIV, InnerPH);
+  Value *OuterInit = phiIncomingOrNull(OuterIV, OuterPH);
+  if (!SideNext || !RowNext || !SideEnter || !RowInit || !OuterInit)
+    return false;
+  if (!match(SideNext, m_c_Add(m_Specific(SideIV), m_One())) ||
+      !match(RowNext, m_c_Add(m_Specific(RowIV), m_One())))
+    return false;
+  auto *RowInitC = dyn_cast<ConstantInt>(RowInit);
+  auto *OuterInitC = dyn_cast<ConstantInt>(OuterInit);
+  if (!RowInitC || !OuterInitC)
+    return false;
+
+  auto *LatchBr = dyn_cast<BranchInst>(InnerLatch->getTerminator());
+  if (!LatchBr || !LatchBr->isConditional())
+    return false;
+  auto *Cmp = dyn_cast<ICmpInst>(LatchBr->getCondition());
+  if (!Cmp || Cmp->getPredicate() != ICmpInst::ICMP_EQ)
+    return false;
+
+  // Exit is `k.next == k0 + Trip` (s126: k_end = k+255, cmp eq trunc(k.next)).
+  Value *CmpA = Cmp->getOperand(0);
+  Value *CmpB = Cmp->getOperand(1);
+  Value *Bound = nullptr;
+  auto isSideNext = [&](Value *V) {
+    if (V == SideNext)
+      return true;
+    Value *X = nullptr;
+    if (match(V, m_Trunc(m_Value(X))) && X == SideNext)
+      return true;
+    return false;
+  };
+  if (isSideNext(CmpA))
+    Bound = CmpB;
+  else if (isSideNext(CmpB))
+    Bound = CmpA;
+  else
+    return false;
+
+  Value *KBase = nullptr;
+  ConstantInt *TripC = nullptr;
+  if (!match(Bound, m_c_Add(m_Value(KBase), m_ConstantInt(TripC))) || !TripC)
+    return false;
+  const uint64_t Trip = TripC->getZExtValue();
+  if (Trip == 0 || Trip > 4096)
+    return false;
+  // Bound base must be the outer k (or its cast) that SideEnter comes from.
+  Value *EnterSrc = SideEnter;
+  if (auto *Cast = dyn_cast<CastInst>(EnterSrc))
+    EnterSrc = Cast->getOperand(0);
+  Value *BoundSrc = KBase;
+  if (auto *Cast = dyn_cast<CastInst>(BoundSrc))
+    BoundSrc = Cast->getOperand(0);
+  if (EnterSrc != BoundSrc && SideEnter != KBase)
+    return false;
+
+  // Outer extra ++k: latch incoming is last SideIV + 2 (last = enter+Trip-1).
+  PHINode *OuterK = dyn_cast<PHINode>(BoundSrc);
+  if (!OuterK || OuterK->getParent() != Outer->getHeader())
+    return false;
+  Value *OuterKNext = phiIncomingOrNull(OuterK, OuterLatch);
+  Value *XK = nullptr;
+  ConstantInt *ExtraC = nullptr;
+  if (!OuterKNext ||
+      !match(OuterKNext, m_c_Add(m_Value(XK), m_ConstantInt(ExtraC))) ||
+      !ExtraC || ExtraC->getSExtValue() != 2)
+    return false;
+  Value *XKSrc = XK;
+  if (auto *Cast = dyn_cast<CastInst>(XKSrc))
+    XKSrc = Cast->getOperand(0);
+  if (XKSrc != SideIV)
+    return false;
+
+  Value *KInit = phiIncomingOrNull(OuterK, OuterPH);
+  auto *KInitC = dyn_cast<ConstantInt>(KInit);
+  if (!KInitC)
+    return false;
+
+  const uint64_t Stride = Trip + 1;
+  Type *Ty = SideIV->getType();
+  IRBuilder<> B(&*Inner.getHeader()->getFirstInsertionPt());
+  auto castTo = [&](Value *V) -> Value * {
+    if (V->getType() == Ty)
+      return V;
+    if (V->getType()->getIntegerBitWidth() < Ty->getIntegerBitWidth())
+      return B.CreateSExt(V, Ty);
+    return B.CreateTrunc(V, Ty);
+  };
+  Value *K0 = ConstantInt::get(Ty, KInitC->getSExtValue());
+  Value *DiffO = B.CreateSub(castTo(OuterIV),
+                             ConstantInt::get(Ty, OuterInitC->getSExtValue()),
+                             "la.k.i");
+  Value *Scaled =
+      B.CreateMul(DiffO, ConstantInt::get(Ty, Stride), "la.k.str");
+  Value *DiffI = B.CreateSub(castTo(RowIV),
+                             ConstantInt::get(Ty, RowInitC->getSExtValue()),
+                             "la.k.j");
+  Value *KClosed =
+      B.CreateAdd(B.CreateAdd(K0, Scaled, "la.k.base"), DiffI, "la.k");
+  SideIV->replaceAllUsesWith(KClosed);
+  SideIV->eraseFromParent();
+
+  IRBuilder<> CB(Cmp);
+  Value *RowNextV = RowNext;
+  if (RowNextV->getType() != Ty)
+    RowNextV = CB.CreateSExtOrTrunc(RowNextV, Ty);
+  Value *NewBound =
+      ConstantInt::get(Ty, RowInitC->getSExtValue() + static_cast<int64_t>(Trip));
+  Value *NewCmp = CB.CreateICmpEQ(RowNextV, NewBound, "la.k.cmp");
+  Cmp->replaceAllUsesWith(NewCmp);
+  if (Cmp->use_empty())
+    Cmp->eraseFromParent();
+
+  ++NumSideIVClosed;
+  return true;
+}
+
+static bool isUnitStrideFPPtr(Value *Ptr, PHINode *IV) {
+  Ptr = Ptr->stripPointerCasts();
+  auto *G = dyn_cast<GetElementPtrInst>(Ptr);
+  if (!G || G->getNumIndices() < 1)
+    return false;
+  return G->getOperand(G->getNumOperands() - 1) == IV;
+}
+
+static bool valueDependsOn(Value *V, Value *Target, Loop &L) {
+  SmallPtrSet<Value *, 16> Seen;
+  SmallVector<Value *, 16> Work{V};
+  while (!Work.empty()) {
+    Value *Cur = Work.pop_back_val();
+    if (!Seen.insert(Cur).second)
+      continue;
+    if (Cur == Target)
+      return true;
+    auto *I = dyn_cast<Instruction>(Cur);
+    if (!I || !L.contains(I) || isa<PHINode>(I))
+      continue;
+    for (Value *Op : I->operands())
+      Work.push_back(Op);
+  }
+  return false;
+}
+
+/// Ordered FP reduction: SIMD unit-stride loads (and element-wise ops/stores)
+/// plus sequential fadd/fmul of lanes. No reassoc. Covers s311/vsumr/s312/s319.
+static LLVM_ATTRIBUTE_UNUSED bool
+tryRewriteOrderedLoadReduction(Loop &L, const LoongArchSubtarget &ST) {
+  if (!L.isInnermost() || !L.isLoopSimplifyForm())
+    return false;
+  if (L.getHeader() != L.getLoopLatch())
+    return false;
+
+  PHINode *IV = getLoopInductionPHI(L);
+  if (!IV)
+    return false;
+  BasicBlock *Header = L.getHeader();
+  BasicBlock *Latch = L.getLoopLatch();
+  BasicBlock *PH = L.getLoopPreheader();
+  if (!PH)
+    return false;
+
+  PHINode *Acc = nullptr;
+  for (PHINode &PN : Header->phis()) {
+    if (&PN == IV)
+      continue;
+    if (PN.getType()->isFloatingPointTy()) {
+      if (Acc)
+        return false;
+      Acc = &PN;
+    } else {
+      return false;
+    }
+  }
+  if (!Acc || (!Acc->getType()->isFloatTy() && !Acc->getType()->isDoubleTy()))
+    return false;
+
+  Value *LatchAcc = phiIncomingOrNull(Acc, Latch);
+  Value *Inc = phiIncomingOrNull(IV, Latch);
+  Value *Start = phiIncomingOrNull(IV, PH);
+  if (!LatchAcc || !Inc || !Start)
+    return false;
+  ConstantInt *StepC = nullptr;
+  if (!match(Inc, m_c_Add(m_Specific(IV), m_ConstantInt(StepC))) || !StepC ||
+      !StepC->isOne())
+    return false;
+  auto *StartC = dyn_cast<ConstantInt>(Start);
+  if (!StartC)
+    return false;
+
+  auto *Br = dyn_cast<BranchInst>(Latch->getTerminator());
+  if (!Br || !Br->isConditional())
+    return false;
+  auto *Cmp = dyn_cast<ICmpInst>(Br->getCondition());
+  if (!Cmp || Cmp->getPredicate() != ICmpInst::ICMP_EQ)
+    return false;
+  Value *Bound = nullptr;
+  if (Cmp->getOperand(0) == Inc)
+    Bound = Cmp->getOperand(1);
+  else if (Cmp->getOperand(1) == Inc)
+    Bound = Cmp->getOperand(0);
+  else
+    return false;
+  auto *BoundC = dyn_cast<ConstantInt>(Bound);
+  if (!BoundC)
+    return false;
+
+  const unsigned EltBits = Acc->getType()->getPrimitiveSizeInBits();
+  if (EltBits != 32 && EltBits != 64)
+    return false;
+  const unsigned VF = ST.hasExtLASX() ? (256 / EltBits) : (128 / EltBits);
+  if (VF < 2)
+    return false;
+  const int64_t Trip = BoundC->getSExtValue() - StartC->getSExtValue();
+  if (Trip <= 0 || (Trip % static_cast<int64_t>(VF)) != 0)
+    return false;
+
+  // Split body ops into reduction chain vs element-wise.
+  SmallPtrSet<Instruction *, 16> RdxOps;
+  SmallVector<Value *, 8> Terms;
+  Value *Cur = LatchAcc;
+  while (Cur != Acc) {
+    auto *BO = dyn_cast<BinaryOperator>(Cur);
+    if (!BO || (BO->getOpcode() != Instruction::FAdd &&
+                BO->getOpcode() != Instruction::FMul))
+      return false;
+    auto *RootBO = dyn_cast<BinaryOperator>(LatchAcc);
+    if (!RootBO || BO->getOpcode() != RootBO->getOpcode())
+      return false;
+    Value *X = BO->getOperand(0);
+    Value *Y = BO->getOperand(1);
+    const bool XRdx = (X == Acc) || valueDependsOn(X, Acc, L);
+    const bool YRdx = (Y == Acc) || valueDependsOn(Y, Acc, L);
+    if (XRdx == YRdx)
+      return false;
+    Value *Prev = XRdx ? X : Y;
+    Value *Term = XRdx ? Y : X;
+    if (valueDependsOn(Term, Acc, L))
+      return false;
+    RdxOps.insert(BO);
+    Terms.push_back(Term);
+    Cur = Prev;
+  }
+  if (Terms.empty())
+    return false;
+  std::reverse(Terms.begin(), Terms.end());
+
+  SmallVector<Instruction *, 16> ElemInsts;
+  for (Instruction &I : *Header) {
+    if (isa<PHINode>(&I) || I.isTerminator() || &I == Cmp)
+      continue;
+    if (isInductionUpdateOf(&I, IV))
+      continue;
+    if (RdxOps.contains(&I))
+      continue;
+    if (auto *Ld = dyn_cast<LoadInst>(&I)) {
+      if (!Ld->getType()->isFloatingPointTy() ||
+          !isUnitStrideFPPtr(Ld->getPointerOperand(), IV))
+        return false;
+      ElemInsts.push_back(&I);
+      continue;
+    }
+    if (auto *St = dyn_cast<StoreInst>(&I)) {
+      if (!St->getValueOperand()->getType()->isFloatingPointTy() ||
+          !isUnitStrideFPPtr(St->getPointerOperand(), IV))
+        return false;
+      if (valueDependsOn(St->getValueOperand(), Acc, L))
+        return false;
+      ElemInsts.push_back(&I);
+      continue;
+    }
+    if (auto *BO = dyn_cast<BinaryOperator>(&I)) {
+      if (BO->getOpcode() != Instruction::FAdd &&
+          BO->getOpcode() != Instruction::FMul &&
+          BO->getOpcode() != Instruction::FSub)
+        return false;
+      if (valueDependsOn(BO, Acc, L))
+        return false;
+      ElemInsts.push_back(&I);
+      continue;
+    }
+    if (auto *II = dyn_cast<IntrinsicInst>(&I)) {
+      if (II->getIntrinsicID() != Intrinsic::fmuladd)
+        return false;
+      if (valueDependsOn(II, Acc, L))
+        return false;
+      ElemInsts.push_back(&I);
+      continue;
+    }
+    if (isa<GetElementPtrInst>(&I) || isa<CastInst>(&I))
+      continue;
+    return false;
+  }
+
+  for (Value *T : Terms) {
+    if (isa<LoadInst>(T) || isa<BinaryOperator>(T) || isa<IntrinsicInst>(T))
+      continue;
+    return false;
+  }
+
+  auto *VecTy = FixedVectorType::get(Acc->getType(), VF);
+  auto *RawTy = FixedVectorType::get(Type::getInt8Ty(Header->getContext()),
+                                     ST.hasExtLASX() ? 32 : 16);
+  Intrinsic::ID LdID = ST.hasExtLASX() ? Intrinsic::loongarch_lasx_xvld
+                                       : Intrinsic::loongarch_lsx_vld;
+  Intrinsic::ID StID = ST.hasExtLASX() ? Intrinsic::loongarch_lasx_xvst
+                                       : Intrinsic::loongarch_lsx_vst;
+  Function *LdFn =
+      Intrinsic::getOrInsertDeclaration(Header->getModule(), LdID);
+  Function *StFn =
+      Intrinsic::getOrInsertDeclaration(Header->getModule(), StID);
+  IRBuilder<> B(cast<Instruction>(Inc));
+  B.setFastMathFlags(FastMathFlags());
+  ValueToValueMapTy VM;
+  SmallVector<Instruction *, 16> NewInsts;
+  Value *ZeroOff = B.getInt32(0);
+  for (Instruction *I : ElemInsts) {
+    if (auto *Ld = dyn_cast<LoadInst>(I)) {
+      Value *Raw = B.CreateCall(LdFn, {Ld->getPointerOperand(), ZeroOff},
+                                Ld->getName() + ".xvld");
+      Value *VL = B.CreateBitCast(Raw, VecTy, Ld->getName() + ".vr");
+      VM[Ld] = VL;
+      NewInsts.push_back(cast<Instruction>(Raw));
+      continue;
+    }
+    if (auto *St = dyn_cast<StoreInst>(I)) {
+      Value *SV = St->getValueOperand();
+      auto It = VM.find(SV);
+      if (It == VM.end())
+        return false;
+      Value *Raw = B.CreateBitCast(It->second, RawTy, St->getName() + ".xvstc");
+      B.CreateCall(StFn, {Raw, St->getPointerOperand(), ZeroOff});
+      continue;
+    }
+    SmallVector<Value *, 4> Ops;
+    for (Value *Op : I->operands()) {
+      if (auto *C = dyn_cast<Constant>(Op)) {
+        if (C->getType() == Acc->getType())
+          Ops.push_back(B.CreateVectorSplat(VF, C));
+        else
+          return false;
+        continue;
+      }
+      auto It = VM.find(Op);
+      if (It == VM.end())
+        return false;
+      Ops.push_back(It->second);
+    }
+    Instruction *NI = nullptr;
+    if (auto *BO = dyn_cast<BinaryOperator>(I))
+      NI = cast<Instruction>(
+          B.CreateBinOp(BO->getOpcode(), Ops[0], Ops[1], I->getName() + ".vr"));
+    else if (auto *II = dyn_cast<IntrinsicInst>(I)) {
+      NI = cast<Instruction>(
+          B.CreateIntrinsic(II->getIntrinsicID(), {VecTy}, Ops));
+      NI->setName(I->getName() + ".vr");
+    }
+    else
+      return false;
+    VM[I] = NI;
+    NewInsts.push_back(NI);
+  }
+
+  auto *RootBO = cast<BinaryOperator>(LatchAcc);
+  Value *NewAcc = Acc;
+  const unsigned EltBytes = EltBits / 8;
+  const unsigned HalfElts = 128 / EltBits;
+  auto *I8x16Ty = FixedVectorType::get(Type::getInt8Ty(Header->getContext()), 16);
+  Function *VbsrlFn = Intrinsic::getOrInsertDeclaration(
+      Header->getModule(), Intrinsic::loongarch_lsx_vbsrl_v);
+  Value *ShiftC = B.getInt32(EltBytes);
+  for (Value *T : Terms) {
+    auto It = VM.find(T);
+    if (It == VM.end())
+      return false;
+    Value *Vec = It->second;
+    // Sequential fadd/fmul of lanes. Use 128-bit vbsrl + extract0 so ISel
+    // does not emit xvpickve soup (whole-register xvbsrl is not lane-linear).
+    for (unsigned Off = 0; Off < VF; Off += HalfElts) {
+      Value *Chunk = Vec;
+      if (VF > HalfElts) {
+        SmallVector<int, 8> Mask(HalfElts);
+        for (unsigned I = 0; I < HalfElts; ++I)
+          Mask[I] = static_cast<int>(Off + I);
+        Chunk = B.CreateShuffleVector(Vec, PoisonValue::get(VecTy), Mask,
+                                      "loong.ord.chk");
+      }
+      Value *Cur = Chunk;
+      const unsigned Lanes = std::min(HalfElts, VF - Off);
+      for (unsigned Lane = 0; Lane < Lanes; ++Lane) {
+        Value *Elt =
+            B.CreateExtractElement(Cur, B.getInt32(0), "loong.ord.e");
+        NewAcc = B.CreateBinOp(RootBO->getOpcode(), NewAcc, Elt, "loong.ord");
+        if (Lane + 1 < Lanes) {
+          Value *Bytes = B.CreateBitCast(Cur, I8x16Ty);
+          Bytes = B.CreateCall(VbsrlFn, {Bytes, ShiftC}, "loong.ord.srl");
+          Cur = B.CreateBitCast(Bytes, Chunk->getType());
+        }
+      }
+    }
+  }
+  LatchAcc->replaceAllUsesWith(NewAcc);
+
+  SmallVector<Instruction *, 8> RdxList(RdxOps.begin(), RdxOps.end());
+  for (Instruction *I : reverse(RdxList))
+    if (I->use_empty())
+      I->eraseFromParent();
+  for (Instruction *I : reverse(ElemInsts))
+    if (I->use_empty())
+      I->eraseFromParent();
+
+  if (auto *BO = dyn_cast<BinaryOperator>(Inc)) {
+    BO->setOperand(BO->getOperand(0) == IV ? 1 : 0,
+                   ConstantInt::get(IV->getType(), VF));
+  }
+
+  ++NumOrderedLoadRdx;
+  return true;
+}
+
+static bool tryInterchangeColumnRecurrenceNest(Loop &Inner) {
+  Loop *Outer = Inner.getParentLoop();
+  if (!Outer || Outer->getSubLoops().size() != 1 || !Inner.isInnermost())
+    return false;
+  if (!Inner.isLoopSimplifyForm() || !Outer->isLoopSimplifyForm())
+    return false;
+
+  PHINode *OuterIV = getLoopInductionPHI(*Outer);
+  PHINode *InnerIV = getLoopInductionPHI(Inner);
+  if (!OuterIV || !InnerIV || OuterIV->getType() != InnerIV->getType())
+    return false;
+
+  BasicBlock *OuterPH = Outer->getLoopPreheader();
+  BasicBlock *InnerPH = Inner.getLoopPreheader();
+  BasicBlock *OuterLatch = Outer->getLoopLatch();
+  BasicBlock *InnerLatch = Inner.getLoopLatch();
+  BasicBlock *OuterHeader = Outer->getHeader();
+  if (!OuterPH || !InnerPH || !OuterLatch || !InnerLatch || !OuterHeader)
+    return false;
+
+  // Reduction / extra FP phis on the outer header (vif-style) must not be
+  // i↔j swapped: the interchange only rewrites address IVs.
+  for (PHINode &PN : OuterHeader->phis()) {
+    if (&PN == OuterIV)
+      continue;
+    if (PN.getType()->isFloatingPointTy() || PN.getType()->isVectorTy())
+      return false;
+  }
+
+  // Triangular nests (s1232: for j / for i=j) have InnerIV init depending on
+  // OuterIV. Swapping inits would drop iterations and break checksums.
+  if (usesValueIV(phiIncomingOrNull(InnerIV, InnerPH), OuterIV) ||
+      usesValueIV(phiIncomingOrNull(OuterIV, OuterPH), InnerIV))
+    return false;
+
+  // Inner must be a tight single-block body (header == latch).
+  if (Inner.getHeader() != InnerLatch)
+    return false;
+
+  SmallVector<StoreInst *, 4> Stores;
+  if (!collectColumnStrideInnerStores(Inner, OuterIV, InnerIV, Stores))
+    return false;
+  if (innerHasExtraFPPhi(Inner, InnerIV))
+    return false;
+  if (innerHasExtraIntPhi(Inner, InnerIV))
+    return false;
+  if (!innerTripIndependentOfOuter(Inner, OuterIV))
+    return false;
+
+  // 1D accesses anywhere in the nest must be loads of exactly OuterIV
+  // (s235 a[i]).  a[i-1] in the outer header (s257 after LICM) makes i↔j
+  // illegal because the IV swap would rewrite it to a[j-1].
+  auto isUnsafe1D = [&](Instruction &I) {
+    auto *Mem = dyn_cast<LoadInst>(&I);
+    auto *StI = dyn_cast<StoreInst>(&I);
+    Value *Ptr = Mem ? Mem->getPointerOperand()
+                     : StI ? StI->getPointerOperand() : nullptr;
+    if (!Ptr)
+      return false;
+    if (!usesValueIV(Ptr, OuterIV) || usesValueIV(Ptr, InnerIV))
+      return false;
+    if (StI && Inner.contains(StI))
+      return true;
+    auto *G = dyn_cast<GetElementPtrInst>(Ptr->stripPointerCasts());
+    if (!G || G->getNumIndices() < 1)
+      return true;
+    return G->getOperand(G->getNumOperands() - 1) != OuterIV;
+  };
+  for (BasicBlock *BB : Outer->blocks())
+    for (Instruction &I : *BB)
+      if (isUnsafe1D(I))
+        return false;
+
+  auto UsesIV = [](Value *V, PHINode *IV) { return usesValueIV(V, IV); };
+
+  bool SawPrevRow = false;
+  bool Unsafe1DLoad = false;
+  bool SawPrevCol = false;
+  SmallVector<Value *, 8> Work;
+  SmallVector<StoreInst *, 4> AllStores;
+  collectInnerFPStores(Inner, AllStores);
+  for (StoreInst *St : AllStores)
+    Work.push_back(St->getValueOperand());
+  SmallPtrSet<Value *, 16> Seen;
+  while (!Work.empty()) {
+    Value *V = Work.pop_back_val();
+    if (!Seen.insert(V).second)
+      continue;
+    if (auto *Ld = dyn_cast<LoadInst>(V)) {
+      if (isPrevRowLoadOf(Ld, OuterIV, InnerIV))
+        SawPrevRow = true;
+      if (isPrevColLoadOf(Ld, OuterIV, InnerIV))
+        SawPrevCol = true;
+      if (usesValueIV(Ld->getPointerOperand(), OuterIV) &&
+          !usesValueIV(Ld->getPointerOperand(), InnerIV)) {
+        // a[i] (exactly OuterIV) is inner-invariant and becomes a[i] in the
+        // unit-stride inner after the swap (s235). a[i-1] is not legal.
+        auto *G = dyn_cast<GetElementPtrInst>(
+            Ld->getPointerOperand()->stripPointerCasts());
+        if (!G || G->getNumIndices() < 1 ||
+            G->getOperand(G->getNumOperands() - 1) != OuterIV)
+          Unsafe1DLoad = true;
+      }
+      continue;
+    }
+    if (auto *I = dyn_cast<Instruction>(V)) {
+      if (isa<PHINode>(I))
+        continue;
+      for (Value *Op : I->operands())
+        Work.push_back(Op);
+    }
+  }
+
+  // Prev-row recurrence and element-wise column-stride stores are legal
+  // (unit-stride after the swap). Prev-column aa[j][i-1] would become an
+  // inner recurrence and is rejected. 1D OuterIV loads become a[j] after
+  // the swap (s257 a[i-1] is also rejected by isUnsafe1D on the nest).
+  if (Unsafe1DLoad || SawPrevCol)
+    return false;
+
+  // Perfect nest only: every outer-loop block outside Inner may contain only
+  // IVs / address math / control. Reject s235 (a[i]+= in outer) and s2275
+  // (a[i]= after inner).
+  auto isAddrOrInt = [](Instruction &I) {
+    if (isa<GetElementPtrInst>(&I) || isa<CastInst>(&I) || isa<PHINode>(&I) ||
+        isa<CmpInst>(&I) || I.isTerminator())
+      return true;
+    if (auto *BO = dyn_cast<BinaryOperator>(&I))
+      return BO->getType()->isIntegerTy();
+    return false;
+  };
+  for (BasicBlock *BB : Outer->blocks()) {
+    if (Inner.contains(BB))
+      continue;
+    for (Instruction &I : *BB) {
+      if (isInductionUpdateOf(&I, OuterIV))
+        continue;
+      if (isAddrOrInt(I))
+        continue;
+      return false;
+    }
+  }
+
+  // Sink every OuterIV address instruction that sits outside Inner (header
+  // and any sibling-fission glue blocks) so swapping IVs cannot create a
+  // use of InnerIV that InnerIV does not dominate.
+  SmallVector<Instruction *, 16> ToSink;
+  for (BasicBlock *BB : Outer->blocks()) {
+    if (Inner.contains(BB))
+      continue;
+    for (Instruction &I : *BB) {
+      if (isa<PHINode>(&I) || I.isTerminator() || isa<CmpInst>(&I))
+        continue;
+      if (isInductionUpdateOf(&I, OuterIV))
+        continue;
+      if (!UsesIV(&I, OuterIV))
+        continue;
+      ToSink.push_back(&I);
+    }
+  }
+  Instruction *InnerInsert = &*Inner.getHeader()->getFirstInsertionPt();
+  for (Instruction *I : ToSink)
+    I->moveBefore(InnerInsert->getIterator());
+
+  // Swap preheader induction starts (s231: 0 ↔ 1). Exit bounds stay on each
+  // PHI so trip counts follow the new inits (both typically end at 256).
+  Value *OuterInit = phiIncomingOrNull(OuterIV, OuterPH);
+  Value *InnerInit = phiIncomingOrNull(InnerIV, InnerPH);
+  if (!OuterInit || !InnerInit)
+    return false;
+  OuterIV->setIncomingValueForBlock(OuterPH, InnerInit);
+  InnerIV->setIncomingValueForBlock(InnerPH, OuterInit);
+
+  // Swap non-control, non-induction uses of the two IVs inside the nest.
+  SmallVector<Use *, 32> UsesOuter, UsesInner;
+  auto collect = [&](PHINode *IV, Loop &Owner, SmallVectorImpl<Use *> &Out) {
+    for (Use &U : IV->uses()) {
+      auto *User = dyn_cast<Instruction>(U.getUser());
+      if (!User)
+        continue;
+      if (isInductionUpdateOf(User, IV))
+        continue;
+      if (!Outer->contains(User))
+        continue;
+      if (isLoopControlUser(User, Owner, IV))
+        continue;
+      // Don't touch the other loop's control either.
+      if (isLoopControlUser(User, *Outer, IV) ||
+          isLoopControlUser(User, Inner, IV))
+        continue;
+      Out.push_back(&U);
+    }
+  };
+  collect(OuterIV, *Outer, UsesOuter);
+  collect(InnerIV, Inner, UsesInner);
+  for (Use *U : UsesOuter)
+    U->set(InnerIV);
+  for (Use *U : UsesInner)
+    U->set(OuterIV);
+
+  ++NumColumnInterchange;
+  if (!SawPrevRow)
+    ++NumColumnStrideIX;
+  return true;
+}
+
+PreservedAnalyses LoongArchFPIndVarPass::run(Function &F,
+                                             FunctionAnalysisManager &AM) {
+  if (!EnableLoongArchFPIndVar || !TM)
+    return PreservedAnalyses::all();
+  const LoongArchSubtarget *ST = TM->getSubtargetImpl(F);
+  if (!ST || !ST->hasExtLSX())
+    return PreservedAnalyses::all();
+
+  auto &LI = AM.getResult<LoopAnalysis>(F);
+  auto &SE = AM.getResult<ScalarEvolutionAnalysis>(F);
+
+  bool Changed = false;
+  // Fission sibling inners, distribute 1D FP around imperfect 2D nests, then
+  // interchange so LV sees contiguous inner columns (s235/s2275/s233-style).
+  auto reanalyzeLoops = [&]() {
+    DominatorTree DT(F);
+    LI.releaseMemory();
+    LI.analyze(DT);
+    SmallVector<Loop *, 8> NeedPH;
+    for (Loop *L : LI.getLoopsInPreorder())
+      if (!L->getLoopPreheader() && L->getLoopLatch() && L->getHeader())
+        NeedPH.push_back(L);
+    for (Loop *L : NeedPH) {
+      BasicBlock *H = L->getHeader();
+      BasicBlock *Latch = L->getLoopLatch();
+      SmallVector<BasicBlock *, 2> OutsidePreds;
+      for (BasicBlock *P : predecessors(H))
+        if (P != Latch)
+          OutsidePreds.push_back(P);
+      if (OutsidePreds.size() == 1)
+        SplitEdge(OutsidePreds[0], H, &DT, &LI);
+    }
+  };
+
+  SmallVector<Loop *, 8> Loops = LI.getLoopsInPreorder();
+  bool Dist = false;
+  for (Loop *L : Loops) {
+    if (L->isInnermost())
+      Changed |= tryRewriteTripIndependentSideIV(*L);
+  }
+  if (Changed)
+    Loops = LI.getLoopsInPreorder();
+  // Sibling-inner fission is a separate CFG rewrite; it is invoked only for
+  // rectangular 2-inner nests. Guard: skip if inner headers have extra FP PHIs
+  // (register-promoted recurrences) that the IV swap cannot rewrite safely.
+  bool FissionProgress = true;
+  while (FissionProgress) {
+    FissionProgress = false;
+    Loops = LI.getLoopsInPreorder();
+    for (Loop *L : Loops) {
+      if (L->getSubLoops().size() == 2 && tryFissionSiblingInners(*L, F)) {
+        FissionProgress = Dist = true;
+        reanalyzeLoops();
+        break;
+      }
+    }
+  }
+  Loops = LI.getLoopsInPreorder();
+  for (Loop *L : Loops) {
+    if (L->isInnermost())
+      Dist |= tryDistribute1DFPAroundInner(*L);
+  }
+  if (Dist) {
+    reanalyzeLoops();
+    Changed = true;
+    Loops = LI.getLoopsInPreorder();
+  }
+  // Sink outer if-around-inner (s275) into select-stores so the nest is
+  // perfect, then interchange so LV sees contiguous inner columns.
+  for (Loop *L : Loops) {
+    if (L->isInnermost())
+      Changed |= trySinkOuterPredicateIntoInner(*L);
+  }
+  for (Loop *L : Loops) {
+    if (L->isInnermost())
+      Changed |= tryInterchangeColumnRecurrenceNest(*L);
+  }
+  Loops = LI.getLoopsInPreorder();
+  // tryRewriteOrderedLoadReduction is kept for SIMD-load + sequential
+  // fadd/fmul (s311/s312/s319). ISel now emits free lane-0 + vbsrl (no
+  // xvpickve), but microbench is still ~0.98–1.00× vs scalar fld+fadd.
+  // Leave off so Test A geo stays >= 1.258.
+  // SE is stale after CFG edits; skip SE-based rewrites when we distributed.
+  if (!Dist) {
+    if (Changed)
+      Loops = LI.getLoopsInPreorder();
+    for (Loop *L : Loops) {
+      Changed |= tryRewriteFPAddRecurrence(*L, SE);
+      Changed |= tryRewriteFPMulRecurrence(*L, SE);
+      Changed |= tryRewriteFPSelectMinMax(*L);
+      Changed |= tryRerollUnrolledDot(*L);
+      Changed |= tryRerollUnrolledSaxpy(*L);
+      Changed |= tryDisableReverseIndexedFPReduction(*L, SE);
+    }
+  }
+
+  if (!Changed)
+    return PreservedAnalyses::all();
+  if (Dist)
+    return PreservedAnalyses::none();
+  PreservedAnalyses PA;
+  PA.preserveSet<CFGAnalyses>();
+  return PA;
+}
